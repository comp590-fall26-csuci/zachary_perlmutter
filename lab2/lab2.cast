[1304.647, "o", "#!/bin/bash\r\n\r\ncd \"$(dirname $0)\" # consistent pathing\r\n\r\n# print every line sorted\r\nsort passwords.txt\r\n\r\n# clear directory on rerun\r\nrm -f passwords && mkdir passwords\r\n\r\n# write every password in original order to passwords\r\ni=0\r\ncat passwords.txt | while read pass\r\ndo\r\n\techo $pass > \"passwords/$(((i++))).txt\"\r\ndone\r\n\r\n"]
