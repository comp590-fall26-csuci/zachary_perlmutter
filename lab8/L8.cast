[2276.743196, "o", "\u001b[2;1H▽\u001b[6n\u001b[2;1H  \u001b[3;1H\u001bPzz\u001b\\\u001b[0%m\u001b[6n\u001b[3;1H           \u001b[1;1H\u001b[>c\u001b]10;?\u0007\u001b]11;?\u0007\u001b[1;1H\u001b[38;5;130mFROM\u001b[m scratch\u001b[38;5;130m as \u001b[mbuild\r\n\u001b[38;5;130mCOPY\u001b[m ../lab3/Makefile ../lab3/utest.h ../lab3/590MakefileLab\u001b[2;61H\u001b[K\u001b[3;1H\u001b[38;5;130mCMD\u001b[m make\u001b[3;9H\u001b[K\u001b[4;1H\u001b[94m~                                                                               \u001b[5;1H~                                                                               \u001b[6;1H~                                                                               \u001b[7;1H~                                                                               \u001b[8;1H~                                                                               \u001b[9;1H~                                                                               \u001b[10;1H~                                                                               \u001b[11;1H~                                                                               \u001b[12;1H~                                                                               \u001b[13;1H~                                                                               \u001b[14;1H~                                                                               \u001b[15;1H~                                                                               \u001b[16;1H~                                                                               \u001b[17;1H~                                                                               \u001b[18;1H~                                                                               \u001b[19;1H~                                                                               \u001b[20;1H~                                                                               \u001