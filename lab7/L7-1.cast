[1519.877998, "o", "\u001b[1;5H\u001b[36mrunner_home\u001b[m\u001b[35m:\u001b[m /var/lib/{{runner_user}}\r\n    \u001b[36mrunner_name\u001b[m\u001b[35m:\u001b[m gitea_runner\u001b[2;30H\u001b[K\u001b[3;1H    \u001b[36mrunner_file\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_home}}/.runner\"\u001b[m\u001b[3;43H\u001b[K\u001b[4;3H\u001b[36mtasks\u001b[m\u001b[35m:\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m install gitea runner\u001b[6;7H\u001b[36mvars\u001b[m\u001b[35m:\u001b[m\u001b[7;9H\u001b[36msource\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{gitea_source}}/{{runner_bin}}/{{runner_version}}/{{runner_bin}}-{{rr\u001b[8;1Hunner_version}}-{{arch}}\"\u001b[m\u001b[9;7H\u001b[36mget_url\u001b[m\u001b[35m:\u001b[m\u001b[10;9H\u001b[36mdest\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_bin_path}}\"\u001b[m\u001b[11;9H\u001b[36murl\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{source}}\"\u001b[m\u001b[12;9H\u001b[36mchecksum\u001b[m\u001b[35m:\u001b[m \u001b[31m\"sha256:{{source}}.sha256\"\u001b[m\u001b[13;9H\u001b[36mmode\u001b[m\u001b[35m:\u001b[m \u001b[31m'0755'\u001b[m\u001b[14;7H\u001b[36mnotify\u001b[m\u001b[35m:\u001b[m restart runner\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m create runner user\u001b[16;7H\u001b[36muser\u001b[m\u001b[35m:\u001b[m\u001b[17;9H\u001b[36mname\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_user}}\"\u001b[m\u001b[18;9H\u001b[36mhome\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_home}}\"\u001b[m\u001b[19;9H\u001b[36msystem\u001b[m\u001b[35m:\u001b[m \u001b[31mtrue\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m create /etc\u001b[21;7H\u001b[36mfile\u001b[m\u001b[35m:\u001b[m\u001b[22;9H\u001b[36mpath\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_etc}}\"\u001b[m\u001b[23;9H\u001b[36mowner\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_user}}\"\u001b[m\u001b[24;9H\u001b[36mstate\u001b[m\u001b[35m:\u001b[m directory\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m initialize runner config\u001b[26;7H\u001b[36mcommand\u001b[m\u001b[35m:\u001b[m\u001b[27;9H\u001b[36mcmd\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_bin}} config init -c {{runner_config}}\"\u001b[m\u001b[28;9H\u001b[36mcreates\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_config}}\"\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m set config properties\u001b[30;7H\u001b[36mfile\u001b[m\u001b[35m:\u001b[m\u001b[31;9H\u001b[36mpath\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_config}}\"\u001b[m\u001b[32;9H\u001b[36mowner\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_user}}\"\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m generate runner token\u001b[34;7H\u001b[36mregister\u001b[m\u001b[35m:\u001b[m runner_token\u001b[35;6H\u001b[34m # todo replace with variable\u001b[m\u001b[36;7H\u001b[36mcommand\u001b[m\u001b[35m:\u001b[m\u001b[37;9H\u001b[36mcmd\u001b[m\u001b[35m:\u001b[m gitea --config /etc/gitea/app.ini actions generate-runner-token\u001b[38;69H47,32\u001b[9C24%\u001b[32;32H\u001b[?25h\u001b[?4m"]
