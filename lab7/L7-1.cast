[2450.301285, "o", "\u001b[1;5H\u001b[36mrunner_bin_path\u001b[m\u001b[35m:\u001b[m /usr/local/bin/{{runner_bin}}\"\r\n    \u001b[36mrunner_user\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_bin}}\"\u001b[m\u001b[2;34H\u001b[K\u001b[3;1H    \u001b[36mrunner_etc\u001b[m\u001b[35m:\u001b[m /etc/{{runner_bin}}/\u001b[3;37H\u001b[K\u001b[4;5H\u001b[36mrunner_config\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_etc}}config.yaml\"\u001b[m\r\n    \u001b[36mrunner_home\u001b[m\u001b[35m:\u001b[m /var/lib/{{runner_user}}\r\n    \u001b[36mrunner_name\u001b[m\u001b[35m:\u001b[m gitea_runner\r\n    \u001b[36mrunner_file\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_home}}/.runner\"\u001b[m\r\n  \u001b[36mtasks\u001b[m\u001b[35m:\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m install gitea runner\u001b[10;7H\u001b[36mvars\u001b[m\u001b[35m:\u001b[m\u001b[11;9H\u001b[36msource\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{gitea_source}}/{{runner_bin}}/{{runner_version}}/{{runner_bin}}-{{rr\u001b[12;1Hunner_version}}-{{arch}}\"\u001b[m\u001b[13;7H\u001b[36mget_url\u001b[m\u001b[35m:\u001b[m\u001b[14;9H\u001b[36mdest\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_bin_path}}\"\u001b[m\u001b[15;9H\u001b[36murl\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{source}}\"\u001b[m\u001b[16;9H\u001b[36mchecksum\u001b[m\u001b[35m:\u001b[m \u001b[31m\"sha256:{{source}}.sha256\"\u001b[m\u001b[17;9H\u001b[36mmode\u001b[m\u001b[35m:\u001b[m \u001b[31m'0755'\u001b[m\u001b[18;7H\u001b[36mnotify\u001b[m\u001b[35m:\u001b[m restart runner\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m create runner user\u001b[20;7H\u001b[36muser\u001b[m\u001b[35m:\u001b[m\u001b[21;9H\u001b[36mname\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_user}}\"\u001b[m\u001b[22;9H\u001b[36mhome\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_home}}\"\u001b[m\u001b[23;9H\u001b[36msystem\u001b[m\u001b[35m:\u001b[m \u001b[31mtrue\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m create /etc\u001b[25;7H\u001b[36mfile\u001b[m\u001b[35m:\u001b[m\u001b[26;9H\u001b[36mpath\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_etc}}\"\u001b[m\u001b[27;9H\u001b[36mowner\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_user}}\"\u001b[m\u001b[28;9H\u001b[36mstate\u001b[m\u001b[35m:\u001b[m directory\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m initialize runner config\u001b[30;7H\u001b[36mcommand\u001b[m\u001b[35m:\u001b[m\u001b[31;9H\u001b[36mcmd\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_bin}} config init -c {{runner_config}}\"\u001b[m\u001b[32;9H\u001b[36mcreates\u001b[m\u001b[35m:\u001b[m \u001b[31m\"\u001b[m\u001b[31m\u001b[106m{\u001b[m\u001b[31m{runner_config}\u001b[m\u001b[31m\u001b[106m}\u001b[m\u001b[31m\"\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m set config properties\u001b[34;7H\u001b[36mfile\u001b[m\u001b[35m:\u001b[m\u001b[35;9H\u001b[36mpath\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_config}}\"\u001b[m\u001b[36;9H\u001b[36mowner\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_user}}\"\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m generate runner token\u001b[38;69H43,19\u001b[9C18%\u001b[32;19H\u001b[?25h\u001b[?4m\u001bP+q436f\u001b\\\u001bP+q6b75\u001b\\\u001bP+q6b64\u001b\\\u001bP+q6b72\u001b\\\u001bP+q6b6c\u001b\\\u001bP+q2332\u001b\\\u001bP+q2334\u001b\\\u001bP+q2569\u001b\\\u001bP+q2a37\u001b\\\u001bP+q6b31\u001b\\\u001bP$q q\u001b\\\u001b[?12$p\u001b[?25l\u001b[38;59Hf\u001b[32;19H\u001b[38;60Hf\u001b[32;19H\u001b[38;61Hf\u001b[32;19H\u001b[38;62H/\u001b[32;19H\u001b[38;63Hf\u001b[32;19H\u001b[38;64Hf\u001b[32;19H\u001b[38;65Hf\u001b[32;19H\u001b[38;66Hf\u001b[32;19H\u001b[38;67H/\u001b[32;19H\u001b[38;68Hf\u001b[32;19H\u001b[38;59H          \u001b[32;19H\u001b[?25h"]
