[3594.676963, "o", "\u001b[1;9H\u001b[36mupdate_cache\u001b[m\u001b[35m:\u001b[m yes\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m add service group\u001b[2;30H\u001b[K\u001b[3;1H      \u001b[36mgroup\u001b[m\u001b[35m:\u001b[m\u001b[3;13H\u001b[K\u001b[4;9H\u001b[36mname\u001b[m\u001b[35m:\u001b[m git\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m add service user\u001b[6;7H\u001b[36muser\u001b[m\u001b[35m:\u001b[m\u001b[7;9H\u001b[36mname\u001b[m\u001b[35m:\u001b[m git\u001b[8;9H\u001b[36mgroup\u001b[m\u001b[35m:\u001b[m git\u001b[9;9H\u001b[36mshell\u001b[m\u001b[35m:\u001b[m /bin/bash\u001b[10;9H\u001b[36msystem\u001b[m\u001b[35m:\u001b[m \u001b[31mtrue\u001b[m\u001b[11;9H\u001b[36mcomment\u001b[m\u001b[35m:\u001b[m Git Version Control\u001b[12;9H\u001b[36mhome\u001b[m\u001b[35m:\u001b[m /var/lib/gitea\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m create file structure\u001b[14;7H\u001b[36mvars\u001b[m\u001b[35m:\u001b[m\u001b[15;9H\u001b[36mlib\u001b[m\u001b[35m:\u001b[m /var/lib/gitea\u001b[16;7H\u001b[36mfile\u001b[m\u001b[35m:\u001b[m\u001b[17;9H\u001b[36mpath\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{ item.path }}\"\u001b[m\u001b[18;9H\u001b[36mowner\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{ item.owner | default('git') }}\"\u001b[m\u001b[19;9H\u001b[36mgroup\u001b[m\u001b[35m:\u001b[m git\u001b[20;9H\u001b[36mmode\u001b[m\u001b[35m:\u001b[m \u001b[31m'750'\u001b[m\u001b[21;9H\u001b[36mstate\u001b[m\u001b[35m:\u001b[m directory\u001b[22;7H\u001b[36mloop\u001b[m\u001b[35m:\u001b[m\u001b[23;9H\u001b[38;5;130m-\u001b[m \u001b[35m{\u001b[m \u001b[36mpath\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{lib}}\"\u001b[m \u001b[35m}\u001b[m\u001b[24;63H58,28\u001b[9C38%\u001b[12;28H\u001b[?25h\u001b[?4m\u001bP+q436f\u001b\\\u001bP+q6b75\u001b\\\u001bP+q6b64\u001b\\\u001bP+q6b72\u001b\\\u001bP+q6b6c\u001b\\\u001bP+q2332\u001b\\\u001bP+q2334\u001b\\\u001bP+q2569\u001b\\\u001bP+q2a37\u001b\\\