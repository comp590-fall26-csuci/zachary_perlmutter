[2345.652715, "o", "\u001b[1;1H\u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m Runner\r\n  \u001b[36mhosts\u001b[m\u001b[35m:\u001b[m target\u001b[2;16H\u001b[K\u001b[3;1H  \u001b[36mbecome\u001b[m\u001b[35m:\u001b[m \u001b[31mtrue\u001b[m\u001b[3;15H\u001b[K\u001b[4;3H\u001b[36mvars\u001b[m\u001b[35m:\u001b[m\r\n    \u001b[36march\u001b[m\u001b[35m:\u001b[m linux-amd64\u001b[7;5H\u001b[36mgitea_source\u001b[m\u001b[35m:\u001b[m https://dl.gitea.com\r\n    \u001b[36mgitea_instance\u001b[m\u001b[35m:\u001b[m http://localhost:3000\r\n    \u001b[36mgitea_user\u001b[m\u001b[35m:\u001b[m git\u001b[11;5H\u001b[36mrunner_version\u001b[m\u001b[35m:\u001b[m 5.4.1\r\n    \u001b[36mrunner_bin\u001b[m\u001b[35m:\u001b[m gitea-runner\r\n    \u001b[36mrunner_bin_path\u001b[m\u001b[35m:\u001b[m /usr/local/bin/{{runner_bin}}\"\r\n    \u001b[36mrunner_user\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_bin}}\"\u001b[m\r\n    \u001b[36mrunner_etc\u001b[m\u001b[35m:\u001b[m /etc/{{runner_bin}}/\r\n    \u001b[36mrunner_config\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_etc}}config.yaml\"\u001b[m\r\n    \u001b[36mrunner_home\u001b[m\u001b[35m:\u001b[m /var/lib/{{runner_user}}\r\n    \u001b[36mrunner_name\u001b[m\u001b[35m:\u001b[m gitea_runner\r\n    \u001b[36mrunner_file\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_home}}/.runner\"\u001b[m\r\n  \u001b[36mtasks\u001b[m\u001b[35m:\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m install gitea runner\u001b[22;7H\u001b[36mvars\u001b[m\u001b[35m:\u001b[m\u001b[23;9H\u001b[36msource\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{gitea_source}}/{{runner_bin}}/{{runner_version}}/{{runner_bin}}-{{rr\u001b[24;1Hunner_version}}-{{arch}}\"\u001b[m\u001b[25;7H\u001b[36mget_url\u001b[m\u001b[35m:\u001b[m\u001b[26;9H\u001b[36mdest\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_bin_path}}\"\u001b[m\u001b[27;9H\u001b[36murl\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{source}}\"\u001b[m\u001b[28;9H\u001b[36mchecksum\u001b[m\u001b[35m:\u001b[m \u001b[31m\"sha256:{{source}}.sha256\"\u001b[m\u001b[29;9H\u001b[36mmode\u001b[m\u001b[35m:\u001b[m \u001b[31m'0755'\u001b[m\u001b[30;7H\u001b[36mnotify\u001b[m\u001b[35m:\u001b[m restart runner\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m create runner user\u001b[32;7H\u001b[36muser\u001b[m\u001b[35m:\u001b[m\u001b[33;9H\u001b[36mname\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_user}}\"\u001b[m\u001b[34;9H\u001b[36mhome\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_home}}\"\u001b[m\u001b[35;9H\u001b[36msystem\u001b[m\u001b[35m:\u001b[m \u001b[31mtrue\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m create /etc\u001b[37;7H\u001b[36mfile\u001b[m\u001b[35m:\u001b[m\u001b[38;69H18,19\u001b[9CTop\u001b[18;19H\u001b[?25h\u001b[?4m"]
