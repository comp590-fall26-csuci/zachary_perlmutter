[2290.155848, "o", "\r\n\u001b[?2004l\r"]
[2290.182264, "o", "Generate, read and edit config files\r\n\r\nUsage:\r\n  gitea-runner config [flags]\r\n  gitea-runner config [command]\r\n\r\nAvailable Commands:\r\n  add         Append values to a list config key\r\n  generate    Print the example config, which documents every option\r\n  get         Print the value of a config key\r\n  init        Write a minimal config file\r\n  remove      Remove values from a list config key\r\n  runner-file Print the registration file path used by the runner\r\n  set         Set the value of a config key\r\n\r\nFlags:\r\n  -h, --help   help for config\r\n\r\nGlobal Flags:\r\n  -c, --config config   Config file path. config subcommands fall back to config.yaml in the working directory or next to the executable\r\n\r\nUse \"gitea-runner config [command] --help\" for more information about a command.\r\n"]
[2290.18848, "o", "\u001b[?2004h"]
[2290.190251, "o", "\u001b]0;zrp200@Debian: ~/zachary_perlmutter/lab7\u0007\u001b[01;32mzrp200@Debian\u001b[00m:\u001b[01;34m~/zachary_perlmutter/lab7\u001b[00m$ "]
[2293.398694, "o", "sudo -u gitea-runner gitea-runner --config=~/config.yaml config"]
