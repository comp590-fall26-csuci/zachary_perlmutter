[1911.756852, "o", "\u001b[1;11H\u001b[38;5;130m-\u001b[m --token\r\n          \u001b[38;5;130m-\u001b[m \u001b[31m\"{{runner_token.stdout}}\"\u001b[m\u001b[2;38H\u001b[K\u001b[3;1H          \u001b[38;5;130m-\u001b[m --name\u001b[3;19H\u001b[K\u001b[4;11H\u001b[38;5;130m-\u001b[m \u001b[31m\"{{runner_name}}\"\u001b[m\u001b[5;9H\u001b[36mcreates\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_file}}\"\u001b[m\u001b[6;9H\u001b[36mchdir\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_home}}\"\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m Create gitea runner service\u001b[8;7H\u001b[36mnotify\u001b[m\u001b[35m:\u001b[m restart runner\u001b[9;7H\u001b[36mcopy\u001b[m\u001b[35m:\u001b[m\u001b[10;9H\u001b[36mdest\u001b[m\u001b[35m:\u001b[m /etc/systemd/system/{{runner_bin}}.service\u001b[11;9H\u001b[36mcontent\u001b[m\u001b[35m:\u001b[m \u001b[35m|\u001b[m\u001b[12;11H[Unit]\u001b[13;11HDescription=Gitea Actions runner\u001b[14;11HDocumentation=https://gitea.com/gitea/runner\u001b[15;11HAfter=network-online.target\u001b[16;11HWants=network-online.target\u001b[17;11H[Service]\u001b[18;11HType=simple\u001b[19;11HExecStart=gitea-runner daemon --config {{runner_config}}\u001b[20;11HWorkingDirectory={{runner_home}}\u001b[21;11HUser={{gitea_user}}\u001b[22;11HGroup={{gitea_user}}\u001b[23;11HRestart=on-failure\u001b[24;11HRestartSec=5s\u001b[25;11HTimeoutStopSec=3h\u001b[26;11H[Install]\u001b[27;11HWantedBy=multi-user.target\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m set runner timeout\u001b[29;7H\u001b[36mcommand\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_bin}} config set -c {{runner_config}} runner.shutdown_timeoutt\u001b[30;1H 2h50m\"\u001b[m\u001b[31;7H\u001b[36mbecome_user\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_user}}\"\u001b[m\r\n  \u001b[36mhandlers\u001b[m\u001b[35m:\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m restart runner\u001b[34;7H\u001b[36msystemd\u001b[m\u001b[35m:\u001b[m\u001b[35;9H\u001b[36mname\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_bin}}\"\u001b[m\u001b[36;9H\u001b[36mstate\u001b[m\u001b[35m:\u001b[m restarted\u001b[37;9H\u001b[36menabled\u001b[m\u001b[35m:\u001b[m \u001b[31mtrue\u001b[m\u001b[38;69H83,20\u001b[9C98%\u001b[19;20H\u001b[?25h\u001b[?4m"]
