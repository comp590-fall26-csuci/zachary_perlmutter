[1250.124082, "o", "a -\u001b[1@-\u001b[A\r\u001b]0;zrp200@Debian: ~/zachary_perlmutter/lab7\u0007\u001b[01;32mzrp200@Debian\u001b[00m:\u001b[01;34m~/zachary_perlmutter/lab7\u001b[00m$ \u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C"]
[1250.812047, "o", "\r\n\r\r\n\u001b[?2004l\r"]
[1250.971358, "o", "NAME:\r\n   gitea - A painless self-hosted Git service\r\n\r\nUSAGE:\r\n"]
[1250.971404, "o", "   gitea [global options] [command [command options]]"]
[1250.971959, "o", "\r\n\r\nVERSION:\r\n   28.3.0 built with go1.27.3\r\n\r\nDESCRIPTION:\r\n   Gitea program contains \"web\" and other subcommands. If no subcommand is given, it starts the web server by default. Use \"web\" subcommand for more web server arguments, use other subcommands for other purposes.\r\n\r\nCOMMANDS:\r\n"]
[1250.972929, "o", "   web              Start Gitea web server"]
[1250.975485, "o", "\r\n   dump             Dump Gitea files and database\r\n   admin            Perform common administrative operations\r\n   migrate          Migrate the database\r\n   doctor           Diagnose and optionally fix problems, convert or re-create database tables\r\n   manager          Manage the running gitea process\r\n   embedded         Extract embedded resources\r\n   migrate-storage  Migrate the storage\r\n   dump-repo        Dump the repository from git/github/gitea/gitlab\r\n   restore-repo     Restore the repository from disk\r\n   actions          Manage Gitea Actions\r\n   config           Manage Gitea configuration\r\n   cert             Generate self-signed certificate\r\n   generate         Generate Gitea's secrets/keys/tokens\r\n   docs             Output CLI documentation\r\n   help, h          Shows a list of commands or help for one command\r\n\r\nGLOBAL OPTIONS:\r\n   --work-path string, -w string    Set Gitea's working path (defaults to the Gitea's binary directory)\r\n   --config string, -c string       Set custom config file (defaults to '{WorkPath}/custom/conf/app.ini')\r\n   --custom-path string, -C string  Set custom path (defaults to '{WorkPath}/custom')\r\n   --help, -h                       show help\r\n   --version, -v                    print the version\r\n\r\nDEFAULT CONFIGURATION:\r\n   AppPath:    /usr/local/bin/gitea\r\n   WorkPath:   /var/lib/gitea\r\n   CustomPath: /var/lib/gitea/custom\r\n   ConfigFile: /etc/gitea/app.ini\r\n\r\n"]
[1250.981109, "o", "\u001b[?2004h\u001b]0;zrp200@Debian: ~/zachary_perlmutter/lab7\u0007\u001b[01;32mzrp200@Debian\u001b[00m:\u001b[01;34m~/zachary_perlmutter/lab7\u001b[00m$ "]
[1263.510044, "o", "sudo -u git gitea --work-path=/var/lib/gitea --config /etc/gitea/app.ini help"]
[1264.706297, "o", "\b\u001b[K"]
