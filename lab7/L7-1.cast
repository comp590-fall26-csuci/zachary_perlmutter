[1266.261763, "o", "\r\n\u001b[?2004l\r"]
[1266.455987, "o", "NAME:\r\n   gitea actions - Manage Gitea Actions\r\n\r\nUSAGE:\r\n   gitea actions [command [command options]]\r\n\r\nCOMMANDS:\r\n   generate-runner-token, grt  Generate a new token for a runner to use to register with the server\r\n\r\nOPTIONS:\r\n   --help, -h  show help\r\n\r\nGLOBAL OPTIONS:\r\n   --work-path string, -w string    Set Gitea's working path (defaults to the Gitea's binary directory)\r\n   --config string, -c string       Set custom config file (defaults to '{WorkPath}/custom/conf/app.ini')\r\n   --custom-path string, -C string  Set custom path (defaults to '{WorkPath}/custom')\r\n\r\nDEFAULT CONFIGURATION:\r\n   AppPath:    /usr/local/bin/gitea\r\n   WorkPath:   /var/lib/gitea\r\n   CustomPath: /var/lib/gitea/custom\r\n   ConfigFile: /etc/gitea/app.ini\r\n\r\n"]
[1266.459525, "o", "\u001b[?2004h\u001b]0;zrp200@Debian: ~/zachary_perlmutter/lab7\u0007\u001b[01;32mzrp200@Debian\u001b[00m:\u001b[01;34m~/zachary_perlmutter/lab7\u001b[00m$ "]
[1281.733172, "o", "sudo -u git gitea --work-path=/var/lib/gitea --config /etc/gitea/app.ini actions"]
