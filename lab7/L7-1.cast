[2601.765389, "o", "\u001b[1;1H\u001b[34m# Minimal config file. Every option it does not set keeps its default.\r\n# \"gitea-runner config generate\" prints all options, \"config set <key> <value>\" sets oo\u001b[3;1Hne here.\u001b[m\u001b[3;9H\u001b[K\u001b[4;1H\u001b[36mrunner\u001b[m\u001b[35m:\u001b[m\r\n  \u001b[36mshutdown_timeout\u001b[m\u001b[35m:\u001b[m 2h50m0s\r\n\u001b[94m~                                                                                     \u001b[7;1H~                                                                                     \u001b[8;1H~                                                                                     \u001b[9;1H~                                                                                     \u001b[10;1H~                                                                                     \u001b[11;1H~                                                                                     \u001b[12;1H~                                                                                     \u001b[13;1H~                                                                                     \u001b[14;1H~                                                                                     \u001b[15;1H~                                                                                     \u001b[16;1H~                                                                                     \u001b[17;1H~                                                                                     \u001b[18;1H~                                                                                     \u001b[19;1H~                                                                                     \u001b[20;1H~                                                                                     \u001b[21;1H~                                                                                     \u001b[22;1H~                                               