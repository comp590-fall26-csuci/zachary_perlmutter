[177.613042, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       <repository>\u001b[m\r\n\u001b[7m Manual page git-push(1) line 5 (press h for help or q to quit)\u001b[27m\u001b[K"]
[177.634124, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K           The \"remote\" repository that is the destination of a push operation. This\u001b[m\r\n\u001b[7m Manual page git-push(1) line 6 (press h for help or q to quit)\u001b[27m\u001b[K"]
[177.66473, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K           parameter can be either a URL (see the section GIT URLS below) or the name\u001b[m"]
[177.664855, "o", "\r\n\u001b[7m Manual page git-push(1) line 7 (press h for help or q to quit)\u001b[27m\u001b[K"]
[177.694852, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[177.695075, "o", "           of a remote (see the section REMOTES below).\u001b[m\r\n\u001b[7m Manual page git-push(1) line 7 (press h for help or q to quit)\u001b[27m\u001b[K"]
[177.724132, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m"]
[177.72428, "o", "\r\n\u001b[7m Manual page git-push(1) line 8 (press h for help or q to quit)\u001b[27m\u001b[K"]
[177.754948, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       <refspec>...\u001b[m"]
[177.755173, "o", "\r\n\u001b[7m Manual page git-push(1) line 8 (press h for help or q to quit)\u001b[27m\u001b[K"]
[177.785852, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K           Specify what destination ref to update with what source object. The format\u001b[m"]
[177.786053, "o", "\r\n\u001b[7m Manual page git-push(1) line 9 (press h for help or q to quit)\u001b[27m\u001b[K"]
[177.814158, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K           of a <refspec> parameter is an optional plus \u001b[1m+\u001b[22m, followed by the source\u001b[m"]
[177.814374, "o", "\r\n\u001b[7m Manual page git-push(1) line 10 (press h for help or q to quit)\u001b[27m\u001b[K"]
[177.84479, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K           object <src>, followed by a colon \u001b[1m:\u001b[22m, followed by the destination ref\u001b[m"]
[177.84493, "o", "\r\n\u001b[7m Manual page git-push(1) line 11 (press h for help or q to quit)\u001b[27m\u001b[K"]
[177.875864, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[177.876121, "o", "           <dst>.\u001b[m\r\n\u001b[7m Manual page git-push(1) line 12 (press h for help or q to quit)\u001b[27m\u001b[K"]
[177.90414, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m"]
[177.90431, "o", "\r\n\u001b[7m Manual page git-push(1) line 13 (press h for help or q to quit)\u001b[27m\u001b[K"]
[177.935564, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K           The <src> is often the name of the branch you would want to push, but it\u001b[m"]
[177.936112, "o", "\r\n\u001b[7m Manual page git-push(1) line 14 (press h for help or q to quit)\u001b[27m\u001b[K"]
[177.963893, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[177.964011, "o", "           can be any arbitrary \"SHA-1 expression\", such as \u001b[1mmaster~4 \u001b[22mor \u001b[1mHEAD \u001b[22m(see\u001b[m"]
[177.964033, "o", "\r\n\u001b[7m Manual page git-push(1) line 15 (press h for help or q to quit)\u001b[27m\u001b[K"]
[177.995782, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[177.995892, "o", "           \u001b[1mgitrevisions\u001b[22m(7)).\u001b[m\r\n"]
[177.99607, "o", "\u001b[7m Manual page git-push(1) line 16 (press h for help or q to quit)\u001b[27m\u001b[K"]
[178.024215, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[178.024443, "o", "\u001b[m\r\n\u001b[7m Manual page git-push(1) line 17 (press h for help or q to quit)\u001b[27m\u001b[K"]
[178.056249, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K           The <dst> tells which ref on the remote side is updated with this push.\u001b[m"]
[178.05651, "o", "\r\n\u001b[7m Manual page git-push(1) line 18 (press h for help or q to quit)\u001b[27m\u001b[K"]
[178.089414, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K           Arbitrary expressions cannot be used here, an actual ref must be named. If\u001b[m\r\n\u001b[7m Manual page git-push(1) line 19 (press h for help or q to quit)\u001b[27m\u001b[K"]
[178.123396, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K           \u001b[1mgit push [<repository>] \u001b[22mwithout any \u001b[1m<refspec> \u001b[22margument is set to update\u001b[m"]
[178.123607, "o", "\r\n\u001b[7m Manual page git-push(1) line 20 (press h for help or q to quit)\u001b[27m\u001b[K"]
[178.144192, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K           some ref at the destination with \u001b[1m<src> \u001b[22mwith \u001b[1mremote.<repository>.push\u001b[0m\u001b[m\r\n\u001b[7m Manual page git-push(1) line 21 (press h for help or q to quit)\u001b[27m\u001b[K"]
[178.174381, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K           configuration variable, \u001b[1m:<dst> \u001b[22mpart can be omitted—such a push will update\u001b[m"]
[178.174515, "o", "\r\n\u001b[7m Manual page git-push(1) line 22 (press h for help or q to quit)\u001b[27m\u001b[K"]
[178.204825, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K           a ref that \u001b[1m<src> \u001b[22mnormally updates without any \u001b[1m<refspec> \u001b[22mon the command\u001b[m"]
[178.20536, "o", "\r\n\u001b[7m Manual page git-push(1) line 23 (press h for help or q to quit)\u001b[27m\u001b[K"]
[178.23555, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K           line. Otherwise, missing \u001b[1m:<dst> \u001b[22mmeans to update the same ref as the \u001b[1m<src>\u001b[22m.\u001b[m"]
[178.235827, "o", "\r\n\u001b[7m Manual page git-push(1) line 24 (press h for help or q to quit)\u001b[27m\u001b[K"]
[178.264461, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[178.264929, "o", "\u001b[m\r\n\u001b[7m Manual page git-push(1) line 25 (press h for help or q to quit)\u001b[27m\u001b[K"]
[178.4962, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[178.496455, "o", "           If <dst> doesn’t start with \u001b[1mrefs/ \u001b[22m(e.g.  \u001b[1mrefs/heads/master\u001b[22m) we will try to\u001b[m\r\n\u001b[7m Manual page git-push(1) line 26 (press h for help or q to quit)\u001b[27m\u001b[K"]
[178.701062, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[178.701144, "o", "           infer where in \u001b[1mrefs/* \u001b[22mon the destination <repository> it belongs based on\u001b[m"]
