[1303.82733, "o", "\u001b[1;1H\u001b[35m\u001b[106m[\u001b[m\u001b[35msecurity\u001b[m\u001b[35m\u001b[106m]\u001b[m\r\n\u001b[32mINSTALL_LOCK\u001b[m     =\u001b[31m true\u001b[m\u001b[2;24H\u001b[K\u001b[3;1H\u001b[32mSECRET_KEY_URI\u001b[m   =\u001b[31m file:/etc/gitea/SECRET_KEY\u001b[m\u001b[3;46H\u001b[K\u001b[4;1H\u001b[32mINTERNAL_TOKEN_URI\u001b[m =\u001b[31m file:/etc/gitea/INTERNAL_TOKEN\u001b[m\r\n\r\n\u001b[35m[database]\u001b[m\r\n\u001b[32mDB_TYPE\u001b[m =\u001b[31m postgres\u001b[m\r\n\u001b[32mNAME\u001b[m    =\u001b[31m gitea\u001b[m\r\n\u001b[32mUSER\u001b[m    =\u001b[31m git\u001b[m\r\n\u001b[32mPASSWD\u001b[m  =\u001b[31m secure_password\u001b[m\r\n\r\n\u001b[35m[oauth2]\u001b[m\r\n\u001b[32mJWT_SECRET_URI\u001b[m =\u001b[31m file:/etc/gitea/JWT_SECRET \u001b[m\r\n\u001b[94m~                                                                                     \u001b[15;1H~                                                                                     \u001b[16;1H~                                                                                     \u001b[17;1H~                                                                                     \u001b[18;1H~                                                                                     \u001b[19;1H~                                                                                     \u001b[20;1H~                                                                                     \u001b[21;1H~                                                                                     \u001b[22;1H~                                                                                     \u001b[23;1H~                                                                                     \u001b[24;1H~                                                                                     \u001b[25;1H~                                                                                     \u001b[26;1H~               