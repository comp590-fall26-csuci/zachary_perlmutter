[3263.405115, "o", "gitea action"]
[3263.558531, "o", "s"]
[3263.747942, "o", "\r\n\u001b[?2004l\r"]
[3263.847467, "o", "NAME:\r\n"]
[3263.850149, "o", "   gitea actions - Manage Gitea Actions\r\n\r\nUSAGE:\r\n"]
[3263.851937, "o", "   gitea actions [command [command options]]\r\n\r\nCOMMANDS:\r\n   generate-runner-token, grt  Generate a new token for a runner to use to register with the server\r\n\r\nOPTIONS:\r\n"]
[3263.853064, "o", "   --help, -h  show help\r\n\r\nGLOBAL OPTIONS:\r\n"]
[3263.853646, "o", "   --work-path string, -w string    Set Gitea's working path (defaults to the Gitea's binary directory)\r\n   --config string, -c string       Set custom config file (defaults to '{WorkPath}/custom/conf/app.ini')\r\n   --custom-path string, -C string  Set custom path (defaults to '{WorkPath}/custom')\r\n\r\nDEFAULT CONFIGURATION:\r\n   AppPath:    /usr/local/bin/gitea\r\n   WorkPath:   /usr/local/bin\r\n   CustomPath: /usr/local/bin/custom\r\n   ConfigFile: /usr/local/bin/custom/conf/app.ini\r\n\r\n"]
