[12962.80507, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [add service group] *************************************************************\r\n"]
[12963.107671, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[12963.111259, "o", "\r\nTASK [add service user] **************************************************************\r\n"]
[12963.504784, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [create file structure] *********************************************************\r\n"]
[12963.874363, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea'})\u001b[0m"]
[12963.877383, "o", "\r\n"]
[12964.090709, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/custom'})\u001b[0m\r\n"]
[12964.315261, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/data'})\u001b[0m\r\n"]
[12964.554064, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/log'})\u001b[0m\r\n"]
[12964.765786, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/etc/gitea', 'owner': 'root'})\u001b[0m\r\n\r\nTASK [download gitea executable] *****************************************************\r\n"]
