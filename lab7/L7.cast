[587.547533, "o", "\u001b[1;9H\u001b[36mcomment\u001b[m\u001b[35m:\u001b[m Git Version Control\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m create /var/lib entry \u001b[2;35H\u001b[K\u001b[3;1H      \u001b[36mfile\u001b[m\u001b[35m:\u001b[m\u001b[3;12H\u001b[K\u001b[4;9H\u001b[36mpath\u001b[m\u001b[35m:\u001b[m /var/lib/gitea/\u001b[35m{\u001b[mcustom,data,log\u001b[35m}\u001b[m\u001b[5;9H\u001b[36mowner\u001b[m\u001b[35m:\u001b[m git\u001b[6;9H\u001b[36mgroup\u001b[m\u001b[35m:\u001b[m git\u001b[7;9H\u001b[36mmode\u001b[m\u001b[35m:\u001b[m \u001b[31m770\u001b[m\u001b[8;9H\u001b[36mstate\u001b[m\u001b[35m:\u001b[m directory\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m create /etc entry\u001b[10;7H\u001b[36mfile\u001b[m\u001b[35m:\u001b[m\u001b[11;9H\u001b[36mpath\u001b[m\u001b[35m:\u001b[m /etc/gitea\u001b[12;9H\u001b[36mowner\u001b[m\u001b[35m:\u001b[m root\u001b[13;9H\u001b[36mgroup\u001b[m\u001b[35m:\u001b[m git\u001b[14;9H\u001b[36mmode\u001b[m\u001b[35m:\u001b[m \u001b[31m770\u001b[m\u001b[15;9H\u001b[36mstate\u001b[m\u001b[35m:\u001b[m directory\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m download gitea executable\u001b[17;7H\u001b[36mget_url\u001b[m\u001b[35m:\u001b[m\u001b[18;8H\u001b[34m # as a note, this implementation would need additional handlers to handle updates\u001b[m\u001b[19;9H\u001b[36murl\u001b[m\u001b[35m:\u001b[m \u001b[31m\"https://dl.gitea.com/gitea/{{gitea_version}}/gitea-{{gitea_version}}-linux-amd64\"\u001b[m\u001b[20;9H\u001b[36mdest\u001b[m\u001b[35m:\u001b[m /usr/local/bin/gitea\u001b[21;9H\u001b[36mmode\u001b[m\u001b[35m:\u001b[m u+x\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m generate completion\u001b[23;7H\u001b[36mcommand\u001b[m\u001b[35m:\u001b[m gitea completion bash\r\n   \u001b[34m ## service setup\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m create service file\u001b[26;7H\u001b[36mnotify\u001b[m\u001b[35m:\u001b[m restart gitea\u001b[27;7H\u001b[36mvars\u001b[m\u001b[35m:\u001b[m\u001b[28;9H\u001b[36mservice_url\u001b[m\u001b[35m:\u001b[m \u001b[31m'https://raw.githubusercontent.com/go-gitea/gitea/refs/heads/main/contrib/service/systee\u001b[29;1Hmd/gitea.service'\u001b[m\u001b[30;7H\u001b[36mcopy\u001b[m\u001b[35m:\u001b[m\u001b[31;9H\u001b[36mdest\u001b[m\u001b[35m:\u001b[m /etc/systemd/system/gitea.service\u001b[32;9H\u001b[36mowner\u001b[m\u001b[35m:\u001b[m root\u001b[33;9H\u001b[36mgroup\u001b[m\u001b[35m:\u001b[m root\u001b[34;9H\u001b[36mmode\u001b[m\u001b[35m:\u001b[m \u001b[31m644\u001b[m\u001b[35;8H\u001b[34m # retrieve service file and replace with dependencies. the lookup retrieves the url\u001b[m\u001b[36;9H\u001b[36mcontent\u001b[m\u001b[35m:\u001b[m \u001b[35m|-\u001b[m\u001b[37;11H{%\u001b[38;91H73,34\u001b[9C83%\u001b[19;34H\u001b[?25h\u001b[?4m\u001bP+q436f\u001b\\\u001bP+q6b75\u001b\\\u001bP+q6b64\u001b\\\u001bP+q6b72\u001b\\\u001bP+q6b6c\u001b\\\u001bP+q2332\u001b\\\u001bP+q2334\u001b\\\u001bP+q2569\u001b\\\u001bP+q2a37\u001b\\\u001bP+q6b31\u001b\\\u001bP$q q\u001b\\\u001b[?12$p\u001b[?25l\u001b[38;81H:\u001b[19;34H\u001b[38;82Hf\u001b[19;34H\u001b[38;83Hf\u001b[19;34H\u001b[38;84Hf\u001b[19;34H\u001b[38;85Hf\u001b[19;34H\u001b[38;86H/\u001b[19;34H\u001b[38;87Hf\u001b[19;34H\u001b[38;88Hf\u001b[19;34H\u001b[38;89Hf\u001b[19;34H\u001b[38;90Hf\u001b[19;34H\u001b[38;81H          \u001b[19;34H\u001b[?25h"]
