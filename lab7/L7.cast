[1094.379539, "o", "\u001b[1;7H\u001b[36mfile\u001b[m\u001b[35m:\u001b[m\r\n        \u001b[36mpath\u001b[m\u001b[35m:\u001b[m /etc/gitea\u001b[2;25H\u001b[K\u001b[3;1H        \u001b[36mowner\u001b[m\u001b[35m:\u001b[m root\u001b[3;20H\u001b[K\u001b[4;9H\u001b[36mgroup\u001b[m\u001b[35m:\u001b[m git\u001b[5;9H\u001b[36mmode\u001b[m\u001b[35m:\u001b[m \u001b[31m770\u001b[m\u001b[6;9H\u001b[36mstate\u001b[m\u001b[35m:\u001b[m directory\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m download gitea executable\u001b[8;7H\u001b[36mget_url\u001b[m\u001b[35m:\u001b[m\u001b[9;8H\u001b[34m # as a note, this implementation would need additional handlers to handle updates\u001b[m\u001b[10;9H\u001b[36murl\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{gitea_source}}/gitea/{{gitea_version}}/gitea-{{gitea_version}}-linux-amd64\"\u001b[m\u001b[11;9H\u001b[36mdest\u001b[m\u001b[35m:\u001b[m /usr/local/bin/gitea\u001b[12;9H\u001b[36mmode\u001b[m\u001b[35m:\u001b[m +x\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m generate completion\u001b[14;7H\u001b[36mcommand\u001b[m\u001b[35m:\u001b[m gitea completion bash\r\n   \u001b[34m ## service setup\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m create service file\u001b[17;7H\u001b[36mnotify\u001b[m\u001b[35m:\u001b[m restart gitea\u001b[18;7H\u001b[36mvars\u001b[m\u001b[35m:\u001b[m\u001b[19;9H\u001b[36mservice_url\u001b[m\u001b[35m:\u001b[m \u001b[31m'https://raw.githubusercontent.com/go-gitea/gitea/refs/heads/main/contrib/service/systemd/gitea.service'\u001b[m\u001b[20;7H\u001b[36mcopy\u001b[m\u001b[35m:\u001b[m\u001b[21;9H\u001b[36mdest\u001b[m\u001b[35m:\u001b[m /etc/systemd/system/gitea.service\u001b[22;9H\u001b[36mowner\u001b[m\u001b[35m:\u001b[m root\u001b[23;9H\u001b[36mgroup\u001b[m\u001b[35m:\u001b[m root\u001b[24;108H76,16\u001b[9C44%\u001b[12;16H\u001b[?25h\u001b[?4m"]
