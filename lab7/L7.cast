[740.437788, "o", "\u001b[2;1H▽\u001b[6n\u001b[2;1H  \u001b[3;1H\u001bPzz\u001b\\\u001b[0%m\u001b[6n\u001b[3;1H           \u001b[1;1H\u001b[>c\u001b]10;?\u0007\u001b]11;?\u0007"]
[740.443, "o", "\u001b[1;9H\u001b[36mgroup\u001b[m\u001b[35m:\u001b[m git\r\n        \u001b[36mmode\u001b[m\u001b[35m:\u001b[m \u001b[31m770\u001b[m\u001b[2;18H\u001b[K\u001b[3;1H        \u001b[36mstate\u001b[m\u001b[35m:\u001b[m directory\u001b[3;25H\u001b[K\u001b[4;5H\u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m download gitea executable\u001b[5;7H\u001b[36mget_url\u001b[m\u001b[35m:\u001b[m\u001b[6;8H\u001b[34m # as a note, this implementation would need additional handlers to handle updates\u001b[m\u001b[7;9H\u001b[36murl\u001b[m\u001b[35m:\u001b[m \u001b[31m\"https://dl.gitea.com/gitea/{{gitea_version}}/gitea-{{gitea_version}}-linux-amd64\"\u001b[m\u001b[8;9H\u001b[36mdest\u001b[m\u001b[35m:\u001b[m /usr/local/bin/gitea\u001b[9;9H\u001b[36mmode\u001b[m\u001b[35m:\u001b[m u+x\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m generate completion\u001b[11;7H\u001b[36mcommand\u001b[m\u001b[35m:\u001b[m gitea completion bash\r\n   \u001b[34m ## service setup\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m create service file\u001b[14;7H\u001b[36mnotify\u001b[m\u001b[35m:\u001b[m restart gitea\u001b[15;7H\u001b[36mvars\u001b[m\u001b[35m:\u001b[m\u001b[16;9H\u001b[36mservice_url\u001b[m\u001b[35m:\u001b[m \u001b[31m'https://raw.githubusercontent.com/go-gitea/gitea/refs/heads/main/contrib/service/systee\u001b[17;1Hmd/gitea.service'\u001b[m\u001b[18;7H\u001b[36mcopy\u001b[m\u001b[35m:\u001b[m\u001b[19;9H\u001b[36mdest\u001b[m\u001b[35m:\u001b[m /etc/systemd/system/gitea.service\u001b[20;9H\u001b[36mowner\u001b[m\u001b[35m:\u001b[m root\u001b[21;9H\u001b[36mgroup\u001b[m\u001b[35m:\u001b[m root\u001b[22;9H\u001b[36mmode\u001b[m\u001b[35m:\u001b[m \u001b[31m644\u001b[m\u001b[23;8H\u001b[34m # retrieve service file and replace with dependencies. the lookup retrieves the url\u001b[24;8H # as a note this doesn't currently use redis\u001b[m\u001b[25;9H\u001b[36mcontent\u001b[m\u001b[35m:\u001b[m \u001b[35m|-\u001b[m\u001b[26;11H{%\u001b[27;13Hlookup('ansible.builtin.url', service_url, split_lines=False) |\u001b[28;13Hregex_replace('^#((?:Wants|After)=(?:postgresql)\\.service)$', '\\1')\u001b[29;11H%}\r\n  \u001b[36mhandlers\u001b[m\u001b[35m:\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m restart gitea\u001b[32;7H\u001b[36msystemd\u001b[m\u001b[35m:\u001b[m\u001b[33;9H\u001b[36mname\u001b[m\u001b[35m:\u001b[m gitea\u001b[34;9H\u001b[36mstate\u001b[m\u001b[35m:\u001b[m restarted\u001b[35;9H\u001b[36menabled\u001b[m\u001b[35m:\u001b[m \u001b[31mtrue\u001b[m\u001b[36;9H\u001b[36mdaemon_reload\u001b[m\u001b[35m:\u001b[m \u001b[31mtrue\u001b[m\u001b[38;91H92,31\u001b[9CBot\u001b[27;31H\u001b[?25h\u001b[?4m"]
