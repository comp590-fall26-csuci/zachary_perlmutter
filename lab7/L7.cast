[9386.456471, "o", "\u001b[1;7H\u001b[36mbecome_user\u001b[m\u001b[35m:\u001b[m git\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m install gitea runner\u001b[2;33H\u001b[K\u001b[3;1H      \u001b[36mvars\u001b[m\u001b[35m:\u001b[m\u001b[3;12H\u001b[K\u001b[4;9H\u001b[36mversion\u001b[m\u001b[35m:\u001b[m 5.4.1\u001b[5;9H\u001b[36msource\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{gitea_source}}{{version}}/gitea-runner-{{version}}-{{arch}}\"\u001b[m\u001b[6;7H\u001b[36mget_url\u001b[m\u001b[35m:\u001b[m\u001b[7;9H\u001b[36mdest\u001b[m\u001b[35m:\u001b[m /usr/local/bin/gitea-runner\u001b[8;9H\u001b[36murl\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{source}}\"\u001b[m\u001b[9;9H\u001b[36mchecksum\u001b[m\u001b[35m:\u001b[m \u001b[31m\"sha256:{{source}}.sha256\"\u001b[m\u001b[10;9H\u001b[36mmode\u001b[m\u001b[35m:\u001b[m \u001b[31m0755\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m create runner user\u001b[12;7H\u001b[36muser\u001b[m\u001b[35m:\u001b[m\u001b[13;9H\u001b[36mname\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_user}}\"\u001b[m\u001b[14;9H\u001b[36mhome\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_home}}\"\u001b[m\u001b[15;9H\u001b[36msystem\u001b[m\u001b[35m:\u001b[m \u001b[31mtrue\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m create /etc\u001b[17;7H\u001b[36mfile\u001b[m\u001b[35m:\u001b[m\u001b[18;9H\u001b[36mpath\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_etc}}\"\u001b[m\u001b[19;9H\u001b[36mowner\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_user}}\"\u001b[m\u001b[20;9H\u001b[36mstate\u001b[m\u001b[35m:\u001b[m directory\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m initialize runner config\u001b[22;7H\u001b[36mcommand\u001b[m\u001b[35m:\u001b[m\u001b[23;8H\u001b[36mcmd\u001b[m\u001b[35m:\u001b[m gitea-runner config init -c {{runner_config}}\u001b[24;8H\u001b[36mcreates\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_config}}\"\u001b[m\u001b[26;5H\u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m register\u001b[27;7H\u001b[36mbecome\u001b[m\u001b[35m:\u001b[m gitea-runner\u001b[28;7H\u001b[36mcommand\u001b[m\u001b[35m:\u001b[m\u001b[29;9H\u001b[36mcmd\u001b[m\u001b[35m:\u001b[m \u001b[31m\"gitea-runner register --instance {{gitea_instance}} --token {{token}}\"\u001b[m\u001b[30;9H\u001b[36mcreates\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_name}}.runner\"\u001b[m\u001b[31;9H\u001b[36mchdir\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_etc}}\"\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m Create gitea runner service\u001b[33;7H\u001b[36mcopy\u001b[m\u001b[35m:\u001b[m\u001b[34;9H\u001b[36mdest\u001b[m\u001b[35m:\u001b[m /etc/systemd/system/gitea-runner.service\u001b[35;69H48,79\u001b[9C39%\u001b[29;79H\u001b[?25h\u001b[?4m"]
