[12598.068771, "o", "\u001b[1;3H\u001b[36mvars\u001b[m\u001b[35m:\u001b[m\u001b[1;9H\u001b[K\u001b[2;5H\u001b[36mgitea_version\u001b[m\u001b[35m:\u001b[m 28.3.0\r\n    \u001b[36mgitea_db_user\u001b[m\u001b[35m:\u001b[m git\r\n    \u001b[36mgitea_db_name\u001b[m\u001b[35m:\u001b[m gitea\u001b[4;25H\u001b[K\u001b[5;5H\u001b[36mgitea_db_pass\u001b[m\u001b[35m:\u001b[m secure_password \u001b[34m # I'm assuming this doesn't actually need to be see\u001b[6;1Hcure for this lab\u001b[m\u001b[6;18H\u001b[K\u001b[7;5H\u001b[36mgitea_source\u001b[m\u001b[35m:\u001b[m https://dl.gitea.com/\r\n    \u001b[36mgitea_secret_names\u001b[m\u001b[35m:\u001b[m \u001b[35m[\u001b[mSECRET_KEY, INTERNAL_TOKEN, JWT_SECRET\u001b[35m]\u001b[m\r\n  \u001b[36mtasks\u001b[m\u001b[35m:\u001b[m\u001b[9;9H\u001b[K\u001b[10;4H\u001b[34m ## database setup\u001b[m\u001b[10;22H\u001b[K\u001b[11;13HInstall Postgres\u001b[11;29H\u001b[K\u001b[12;7H\u001b[36mapt\u001b[m\u001b[35m:\u001b[m\u001b[12;11H\u001b[K\u001b[13;9H\u001b[36mname\u001b[m\u001b[2Cpostgresql\u001b[14;9H\u001b[36mstate\u001b[m\u001b[35m:\u001b[m present\r\n        \u001b[36mupdate_cache\u001b[m\u001b[35m:\u001b[m yes\u001b[15;26H\u001b[K\u001b[16;5H\u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m Start Postgres\u001b[16;27H\u001b[K\u001b[17;1H\u001b[1m\u001b[7mL7.yml                                                              10,19           2%\u001b[m\u001b[19;14H\u001b[31m\"{{runner_bin}} config init -c {{runner_config}}\"\u001b[m\u001b[19;63H\u001b[K\u001b[20;28H\u001b[31mconfig}}\"\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m set config properties\u001b[21;34H\u001b[K\u001b[22;7H\u001b[36mfile\u001b[m\u001b[35m:\u001b[m\r\n        \u001b[36mpath\u001b[m\u001b[35m:\u001b[m \u001b[31m\"\"\u001b[m\u001b[23;17H\u001b[K\u001b[24;7H\u001b[K\u001b[25;5H\u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m generate runner token\u001b[26;7H\u001b[36mregister\u001b[m\u001b[35m:\u001b[m runner_token\u001b[27;6H\u001b[34m # todo replace with variable\u001b[m\u001b[28;7H\u001b[36mcommand\u001b[m\u001b[35m:\u001b[m\u001b[28;15H\u001b[K\u001b[29;9H\u001b[36mcmd\u001b[m\u001b[35m:\u001b[m gitea --config /etc/gitea/app.ini actions generate-runner-token\u001b[30;9H\u001b[36mcreates\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_file}}\"\u001b[m\u001b[31;7H\u001b[36mbecome_user\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{gitea_user}}\"\u001b[m\u001b[32;11H\u001b[K\u001b[33;5H\u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m create runner\u001b[33;26H\u001b[K\u001b[34;1H\u001b[7mrunner.yml [+]                                                      46,16          47%\u001b[8;19H\u001b[?25h"]
