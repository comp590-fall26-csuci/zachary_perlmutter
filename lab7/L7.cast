[3485.578733, "o", "\u001b[1;9H\u001b[36mcomment\u001b[m\u001b[35m:\u001b[m Git Version Control\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m create file structure\u001b[2;34H\u001b[K\u001b[3;1H      \u001b[36mvars\u001b[m\u001b[35m:\u001b[m\u001b[3;12H\u001b[K\u001b[4;9H\u001b[36mlib\u001b[m\u001b[35m:\u001b[m /var/lib/gitea\u001b[5;7H\u001b[36mfile\u001b[m\u001b[35m:\u001b[m\u001b[6;9H\u001b[36mpath\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{ item.path }}\"\u001b[m\u001b[7;9H\u001b[36mowner\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{ item.owner | default('git') }}\"\u001b[m\u001b[8;9H\u001b[36mgroup\u001b[m\u001b[35m:\u001b[m git\u001b[9;9H\u001b[36mrecurse\u001b[m\u001b[35m:\u001b[m \u001b[31mtrue\u001b[m\u001b[10;9H\u001b[36mmode\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{ item.mode | default('750') }}\"\u001b[m\u001b[11;9H\u001b[36mstate\u001b[m\u001b[35m:\u001b[m directory\u001b[12;7H\u001b[36mloop\u001b[m\u001b[35m:\u001b[m\u001b[13;9H\u001b[38;5;130m-\u001b[m \u001b[35m{\u001b[m \u001b[36mpath\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{lib}}\"\u001b[m \u001b[35m}\u001b[m\u001b[14;9H\u001b[38;5;130m-\u001b[m \u001b[35m{\u001b[m \u001b[36mpath\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{lib}}/custom\"\u001b[m \u001b[35m}\u001b[m\u001b[15;9H\u001b[38;5;130m-\u001b[m \u001b[35m{\u001b[m \u001b[36mpath\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{lib}}/data\"\u001b[m \u001b[35m}\u001b[m\u001b[16;9H\u001b[38;5;130m-\u001b[m \u001b[35m{\u001b[m \u001b[36mpath\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{lib}}/log\"\u001b[m \u001b[35m}\u001b[m\u001b[17;9H\u001b[38;5;130m-\u001b[m \u001b[35m{\u001b[m \u001b[36mpath\u001b[m\u001b[35m:\u001b[m /etc/gitea, \u001b[36mowner\u001b[m\u001b[35m:\u001b[m root, \u001b[36mmode\u001b[m\u001b[35m:\u001b[m \u001b[31m'770'\u001b[m \u001b[35m}\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m download gitea executable\u001b[19;7H\u001b[36mget_url\u001b[m\u001b[35m:\u001b[m\u001b[20;8H\u001b[34m # as a note, this implementation would need additional handlers to handle updaa\u001b[21;1Htes\u001b[m\u001b[22;9H\u001b[36murl\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{gitea_source}}/gitea/{{gitea_version}}/gitea-{{gitea_version}}-linux-aa\u001b[23;1Hmd64\"\u001b[m\u001b[24;9H\u001b[36mdest\u001b[m\u001b[35m:\u001b[m /usr/local/bin/gitea\u001b[25;9H\u001b[36mmode\u001b[m\u001b[35m:\u001b[m +x\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m generate completion\u001b[27;7H\u001b[36mcommand\u001b[m\u001b[35m:\u001b[m gitea completion bash\r\n   \u001b[34m ## service setup\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m create service file\u001b[30;7H\u001b[36mnotify\u001b[m\u001b[35m:\u001b[m restart gitea\u001b[31;7H\u001b[36mvars\u001b[m\u001b[35m:\u001b[m\u001b[32;9H\u001b[36mservice_url\u001b[m\u001b[35m:\u001b[m \u001b[31m'https://raw.githubusercontent.com/go-gitea/gitea/refs/heads/mainn\u001b[33;1H/contrib/service/systemd/gitea.service'\u001b[m\u001b[34;7H\u001b[36mcopy\u001b[m\u001b[35m:\u001b[m\u001b[35;69H72,54\u001b[9C75%\u001b[17;54H\u001b[?25h\u001b[?4m\u001bP+q436f\u001b\\\u001bP+q6b75\u001b\\\u001bP+q6b64\u001b\\\u001bP+q6b72\u001b\\\u001bP+q6b6c\u001b\\\u001bP+q2332\u001b\\\u001bP+q2334\u001b\\\u001bP+q2569\u001b\\\u001bP+q2a37\u001b\\\u001bP+q6b31\u001b\\\u001bP$q q\u001b\\\u001b[?12$p\u001b[?25l\u001b[35;59H:\u001b[17;54H\u001b[35;60Hf\u001b[17;54H\u001b[35;61Hf\u001b[17;54H\u001b[35;62Hf\u001b[17;54H\u001b[35;63Hf\u001b[17;54H\u001b[35;64H/\u001b[17;54H\u001b[35;65Hf\u001b[17;54H\u001b[35;66Hf\u001b[17;54H\u001b[35;67Hf\u001b[17;54H\u001b[35;68Hf\u001b[17;54H\u001b[35;59H          \u001b[17;54H\u001b[?25h"]
