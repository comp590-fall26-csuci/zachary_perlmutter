[8606.449385, "o", "\u001b[10;19H\u001b[1;1H\u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m Lab \u001b[31m7\u001b[m\u001b[1;14H\u001b[K\u001b[2;3H\u001b[36mhosts\u001b[m\u001b[35m:\u001b[m target\u001b[2;16H\u001b[K\u001b[3;3H\u001b[36mbecom\u001b[m\u001b[1C\u001b[35m:\u001b[m \u001b[31mtrue\u001b[m\u001b[3;15H\u001b[K\u001b[4;3H\u001b[36mvars\u001b[m\u001b[35m:\u001b[m\u001b[4;8H\u001b[K\u001b[5;1H    \u001b[36mgitea_version\u001b[m\u001b[35m:\u001b[m 28.3.0\u001b[6;11H\u001b[36mdb_user\u001b[m\u001b[35m:\u001b[m git\u001b[6;23H\u001b[K\u001b[7;11H\u001b[36mdb_name\u001b[m\u001b[35m:\u001b[m gitea\u001b[7;25H\u001b[K\u001b[8;3H  \u001b[36mgitea_db_pass\u001b[m\u001b[35m:\u001b[m secure_password \u001b[34m # I'm assuming this doesn't actually need to be see\u001b[9;1Hcure for this lab\u001b[m\u001b[9;18H\u001b[K\u001b[10;5H\u001b[36mgitea_source\u001b[m\u001b[35m:\u001b[m https://dl.gitea.com/\r\n    \u001b[36mgitea_secret_names\u001b[m\u001b[35m:\u001b[m \u001b[35m[\u001b[mSECRET_KEY, INTERNAL_TOKEN, JWT_SECRET\u001b[35m]\u001b[m\r\n  \u001b[36mtasks\u001b[m\u001b[35m:\u001b[m\u001b[12;9H\u001b[K\u001b[13;4H\u001b[34m ## database setup\u001b[m\u001b[13;22H\u001b[K\u001b[14;5H\u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m Install Postgres\r\n      \u001b[36mapt\u001b[m\u001b[35m:\u001b[m\u001b[15;11H\u001b[K\u001b[16;7H  \u001b[36mname\u001b[m\u001b[35m:\u001b[m postgresql\r\n        \u001b[36mstate\u001b[m\u001b[35m:\u001b[m present\u001b[17;23H\u001b[K\u001b[18;1H        \u001b[36mupdate_cache\u001b[m\u001b[35m:\u001b[m yes\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m Start Postgres\r\n      \u001b[36mservice\u001b[m\u001b[35m:\u001b[m\r\n        \u001b[36mname\u001b[m\u001b[35m:\u001b[m postgresql\r\n        \u001b[36mstate\u001b[m\u001b[35m:\u001b[m started\u001b[23;9H\u001b[36menabled\u001b[m\u001b[35m:\u001b[m \u001b[31mtrue\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m create postgres user/database\r\n      \u001b[36mbecome\u001b[m\u001b[35m:\u001b[m \u001b[31mtrue\u001b[m\u001b[25;19H\u001b[K\u001b[26;7H\u001b[36mbecome_user\u001b[m\u001b[35m:\u001b[m postgres\r\n      \u001b[36mregist\u001b[m\u001b[2C\u001b[35m:\u001b[m gitea_db_setup\r\n      \u001b[36mchanged_when\u001b[m\u001b[35m:\u001b[m \u001b[31m\"'CREATE' in gitea_db_setup.stdout\"\u001b[m\u001b[34m # this would indicate that thee\u001b[29;1H corresponding data was created\u001b[m\u001b[29;32H\u001b[K\u001b[30;5H  \u001b[36mcommand\u001b[m\u001b[35m:\u001b[m\u001b[30;15H\u001b[K\u001b[31;5H    \u001b[36margv\u001b[m\u001b[35m:\u001b[m\u001b[31;14H\u001b[K\u001b[32;5H      \u001b[38;5;130m-\u001b[m psql\u001b[32;18H\u001b[K\u001b[33;3H        \u001b[38;5;130m-\u001b[m \u001b[31m\"-vON_ERROR_STOP=1\"\u001b[m\r\n          \u001b[38;5;130m-\u001b[m \u001b[31m\"-vuser={{gitea_db_user}}\"\u001b[m\u001b[34;39H\u001b[K\u001b[35;69H9,19\u001b[10CTop\u001b[35;69H\u001b[K\u001b[35;69H9,19\u001b[10CTop\u001b[10;19H\u001b[?25h"]
