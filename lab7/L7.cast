[6733.485576, "o", "\u001b[1;7H\u001b[36mfile\u001b[m\u001b[35m:\u001b[m\r\n        \u001b[36mpath\u001b[m\u001b[35m:\u001b[m /etc/gitea/{{item}}\u001b[2;34H\u001b[K\u001b[3;1H        \u001b[36mmode\u001b[m\u001b[35m:\u001b[m \u001b[31m'640'\u001b[m\u001b[3;20H\u001b[K\u001b[4;7H\u001b[36mloop\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{gitea_secret_names}}\"\u001b[m\u001b[6;4H\u001b[34m ## config\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m create app.ini\u001b[8;7H\u001b[36mnotify\u001b[m\u001b[35m:\u001b[m restart gitea\u001b[9;7H\u001b[36mcopy\u001b[m\u001b[35m:\u001b[m\u001b[10;9H\u001b[36mdest\u001b[m\u001b[35m:\u001b[m /etc/gitea/app.ini\u001b[11;9H\u001b[36mmode\u001b[m\u001b[35m:\u001b[m \u001b[31m'640'\u001b[m\u001b[12;9H\u001b[36mcontent\u001b[m\u001b[35m:\u001b[m \u001b[35m|-\u001b[m\u001b[13;11H[security]\u001b[14;11HINSTALL_LOCK     = true\u001b[15;11HSECRET_KEY_URI   = file:/etc/gitea/SECRET_KEY\u001b[16;11HINTERNAL_TOKEN_URI = file:/etc/gitea/INTERNAL_TOKEN\u001b[18;11H[database]\u001b[19;11HDB_TYPE = postgres\u001b[20;11HNAME    = {{gitea_db_name}}\u001b[21;11HUSER    = {{gitea_db_user}}\u001b[22;11HPASSWD  = {{gitea_db_pass}}\u001b[24;11H[oauth2]\u001b[25;11HJWT_SECRET_URI = file:/etc/gitea/JWT_SECRET\u001b[28;3H\u001b[36mhandlers\u001b[m\u001b[35m:\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m restart gitea\u001b[30;7H\u001b[36msystemd\u001b[m\u001b[35m:\u001b[m\u001b[31;9H\u001b[36mname\u001b[m\u001b[35m:\u001b[m gitea\u001b[32;9H\u001b[36mstate\u001b[m\u001b[35m:\u001b[m restarted\u001b[33;9H\u001b[36menabled\u001b[m\u001b[35m:\u001b[m \u001b[31mtrue\u001b[m\u001b[34;9H\u001b[36mdaemon_reload\u001b[m\u001b[35m:\u001b[m \u001b[31mtrue\u001b[m\u001b[35;69H142,19\u001b[8CBot\u001b[34;19H\u001b[?25h\u001b[?4m"]
