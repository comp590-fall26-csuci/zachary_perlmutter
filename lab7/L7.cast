[11919.087446, "o", "\u001b[1;9H\u001b[36msystem\u001b[m\u001b[35m:\u001b[m \u001b[31mtrue\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m create /etc\u001b[2;24H\u001b[K\u001b[3;1H      \u001b[36mfile\u001b[m\u001b[35m:\u001b[m\u001b[3;12H\u001b[K\u001b[4;9H\u001b[36mpath\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_etc}}\"\u001b[m\u001b[5;9H\u001b[36mowner\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_user}}\"\u001b[m\u001b[6;9H\u001b[36mstate\u001b[m\u001b[35m:\u001b[m directory\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m initialize runner config\u001b[8;7H\u001b[36mcommand\u001b[m\u001b[35m:\u001b[m\u001b[9;9H\u001b[36mcmd\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_bin}} config init -c {{runner_config}}\"\u001b[m\u001b[10;9H\u001b[36mcreates\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_config}}\"\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m generate runner token\u001b[12;7H\u001b[36mregister\u001b[m\u001b[35m:\u001b[m runner_token\u001b[13;6H\u001b[34m # todo replace with variable\u001b[m\u001b[14;7H\u001b[36mcommand\u001b[m\u001b[35m:\u001b[m\u001b[15;9H\u001b[36mcmd\u001b[m\u001b[35m:\u001b[m gitea --config /etc/gitea/app.ini actions generate-runner-token\u001b[16;9H\u001b[36mcreates\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_file}}\"\u001b[m\u001b[17;7H\u001b[36mbecome_user\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{gitea_user}}\"\u001b[m\u001b[19;5H\u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m create runner\u001b[20;7H\u001b[36mbecome_user\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_user}}\"\u001b[m\u001b[21;7H\u001b[36mcommand\u001b[m\u001b[35m:\u001b[m\u001b[22;9H\u001b[36mcmd\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_bin}} register --instance {{gitea_instance}} --token {{runner_tt\u001b[23;1Hoken.stdout}}\"\u001b[m\u001b[24;9H\u001b[36mcreates\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_file}}\"\u001b[