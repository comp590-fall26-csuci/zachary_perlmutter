[8693.540799, "o", "\u001b[1;1H\u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m Runner\r\n  \u001b[36mhosts\u001b[m\u001b[35m:\u001b[m target\u001b[2;16H\u001b[K\u001b[3;1H  \u001b[36mbecome\u001b[m\u001b[35m:\u001b[m \u001b[31mtrue\u001b[m\u001b[3;15H\u001b[K\u001b[4;3H\u001b[36mvars\u001b[m\u001b[35m:\u001b[m\r\n    \u001b[36march\u001b[m\u001b[35m:\u001b[m linux-amd-64\u001b[7;5H\u001b[36mgitea_source\u001b[m\u001b[35m:\u001b[m https://dl.gitea.com/\r\n    \u001b[36mgitea_instance\u001b[m\u001b[35m:\u001b[m localhost:3000\u001b[10;5H\u001b[36mrunner_version\u001b[m\u001b[35m:\u001b[m 5.4.1\r\n    \u001b[36mrunner_user\u001b[m\u001b[35m:\u001b[m gitea-runner\r\n    \u001b[36mrunner_etc\u001b[m\u001b[35m:\u001b[m /etc/gitea-runner/\r\n    \u001b[36mrunner_config\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{runner_etc}}config.yml\"\u001b[m\r\n    \u001b[36mrunner_home\u001b[m\u001b[35m:\u001b[m /var/lib/{{runner_user}}\r\n    \u001b[36mrunner_name\u001b[m\u001b[35m:\u001b[m \u001b[31m\"gitea_runner\"\u001b[m\r\n  \u001b[36mtasks\u001b[m\u001b[35m:\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m generate runner token\u001b[18;7H\u001b[36mcommand\u001b[m\u001b[35m:\u001b[m\u001b[19;9H\u001b[36mcmd\u001b[m\u001b[35m:\u001b[m gitea --config /etc/gitea/app.ini generate_runner_token\u001b[21;5H\u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m install gitea runner\u001b[22;7H\u001b[36mvars\u001b[m\u001b[35m:\u001b[m\u001b[23;9H\u001b[36mversion\u001b[m\u001b[35m:\u001b[m 5.4.1\u001b[24;9H\u001b[36msource\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{gitea_source}}{{version}}/gitea-runner-{{version}}-{{arch}}\"\u001b[m\u001b[25;7H\u001b[36mget_url\u001b[m\u001b[35m:\u001b[m\u001b[26;9H\u001b[36mdest\u001b[m\u001b[35m:\u001b[m /usr/local/bin/gitea-runner\u001b[27;9H\u001b[36murl\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{source}}\"\u001b[m\u001b[28;9H\u001b[36mchecksum\u001b[m\u001b[35m:\u001b[m \u001b[31m\"sha256: