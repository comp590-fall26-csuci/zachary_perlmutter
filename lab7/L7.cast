[12953.876931, "o", "\r\nPLAY [Lab 7] *************************************************************************\r\n"]
[12953.883033, "o", "\r\nTASK [Gathering Facts] ***************************************************************\r\n"]
[12954.897253, "o", "\u001b[1;35m[WARNING]: Host 'localhost' is using the discovered Python interpreter at '/usr/bin/python3.13', but future installation of another Python interpreter could cause a different interpreter to be discovered. See https://docs.ansible.com/ansible-core/2.19/reference_appendices/interpreter_discovery.html for more information.\u001b[0m\r\n\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[12954.902191, "o", "\r\nTASK [Install Postgres] **************************************************************\r\n"]
[12959.240269, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Start Postgres] ****************************************************************\r\n"]
[12959.804246, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[12959.807941, "o", "\r\nTASK [create postgres user/database] *************************************************\r\n"]
