[3714.897701, "o", "\u001b[1;8H\u001b[34m # as a note, this implementation would need additional handlers to handle updaa\u001b[2;1Htes\u001b[m\u001b[2;4H\u001b[K\u001b[3;1H        \u001b[36murl\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{gitea_source}}/gitea/{{gitea_version}}/gitea-{{gitea_version}}-linux-aa\u001b[4;1Hmd64\"\u001b[m\u001b[5;9H\u001b[36mdest\u001b[m\u001b[35m:\u001b[m /usr/local/bin/gitea\u001b[6;9H\u001b[36mmode\u001b[m\u001b[35m:\u001b[m +x\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m generate completion\u001b[8;7H\u001b[36mcommand\u001b[m\u001b[35m:\u001b[m gitea completion bash\r\n   \u001b[34m ## service setup\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m create service file\u001b[11;7H\u001b[36mnotify\u001b[m\u001b[35m:\u001b[m restart gitea\u001b[12;7H\u001b[36mvars\u001b[m\u001b[35m:\u001b[m\u001b[13;9H\u001b[36mservice_url\u001b[m\u001b[35m:\u001b[m \u001b[31m'https://raw.githubusercontent.com/go-gitea/gitea/refs/heads/mainn\u001b[14;1H/contrib/service/systemd/gitea.service'\u001b[m\u001b[15;7H\u001b[36mcopy\u001b[m\u001b[35m:\u001b[m\u001b[16;9H\u001b[36mdest\u001b[m\u001b[35m:\u001b[m /etc/systemd/system/gitea.service\u001b[17;9H\u001b[36mowner\u001b[m\u001b[35m:\u001b[m root\u001b[18;9H\u001b[36mgroup\u001b[m\u001b[35m:\u001b[m root\u001b[19;9H\u001b[36mmode\u001b[m\u001b[35m:\u001b[m \u001b[31m644\u001b[m\u001b[20;8H\u001b[34m # retrieve service file and replace with dependencies. the lookup retrieves thh\u001b[21;1He url\u001b[22;8H # as a note this doesn't currently use redis\u001b[m\u001b[23;9H\u001b[36mcontent\u001b[m\u001b[35m:\u001b[m \u001b[35m|-\u001b[m\u001b[24;11H{{\u001b[25;13Hlookup('ansible.builtin.url', service_url, split_lines=False) |\u001b[26;13Hregex_replace('^#((?:Wants|After)=(?:postgresql)\\.service)$', '\\1')\u001b[27;11H}}\r\n  \u001b[36mhandlers\u001b[m\u001b[35m:\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m restart gitea\u001b[30;7H\u001b[36msystemd\u001b[m\u001b[35m:\u001b[m\u001b[31;9H\u001b[36mname\u001b[m\u001b[35m:\u001b[m gitea\u001b[32;9H\u001b[36mstate\u001b[m\u001b[35m:\u001b[m restarted\u001b[33;9H\u001b[36menabled\u001b[m\u001b[35m:\u001b[m \u001b[31mtrue\u001b[m\u001b[34;9H\u001b[36mdaemon_reload\u001b[m\u001b[35m:\u001b[m \u001b[31mtrue\u001b[m\u001b[35;69H99,25\u001b[9CBot\u001b[29;25H\u001b[?25h\u001b[?4m"]
