[7245.4423, "o", "\u001b[1;7H\u001b[36mloop\u001b[m\u001b[35m:\u001b[m\r\n        \u001b[38;5;130m-\u001b[m \u001b[35m{\u001b[m \u001b[36mpath\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{lib}}\"\u001b[m \u001b[35m}\u001b[m\u001b[2;30H\u001b[K\u001b[3;1H        \u001b[38;5;130m-\u001b[m \u001b[35m{\u001b[m \u001b[36mpath\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{lib}}/custom\"\u001b[m \u001b[35m}\u001b[m\u001b[3;37H\u001b[K\u001b[4;9H\u001b[38;5;130m-\u001b[m \u001b[35m{\u001b[m \u001b[36mpath\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{lib}}/data\"\u001b[m \u001b[35m}\u001b[m\u001b[5;9H\u001b[38;5;130m-\u001b[m \u001b[35m{\u001b[m \u001b[36mpath\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{lib}}/log\"\u001b[m \u001b[35m}\u001b[m\u001b[6;9H\u001b[38;5;130m-\u001b[m \u001b[35m{\u001b[m \u001b[36mpath\u001b[m\u001b[35m:\u001b[m /etc/gitea, \u001b[36mowner\u001b[m\u001b[35m:\u001b[m root \u001b[35m}\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m download gitea executable\u001b[8;7H\u001b[36mget_url\u001b[m\u001b[35m:\u001b[m\u001b[9;8H\u001b[34m # as a note, this implementation would need additional handlers to handle updaa\u001b[10;1Htes\u001b[m\u001b[11;9H\u001b[36murl\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{gitea_source}}/gitea/{{gitea_version}}/gitea-{{gitea_version}}-linux-aa\u001b[12;1Hmd64\"\u001b[m\u001b[13;9H\u001b[36mdest\u001b[m\u001b[35m:\u001b[m /usr/local/bin/gitea\u001b[14;9H\u001b[36mmode\u001b[m\u001b[35m:\u001b[m +x\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m generate completion\u001b[16;7H\u001b[36mcommand\u001b[m\u001b[35m:\u001b[m gitea completion bash\u001b[18;4H\u001b[34m ## service setup\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m create service file\u001b[20;7H\u001b[36mnotify\u001b[m\u001b[35m:\u001b[m restart gitea\u001b[21;7H\u001b[36mvars\u001b[m\u001b[35m:\u001b[m\u001b[22;9H\u001b[36mservice_url\u001b[m\u001b[35m:\u001b[m \u001b[31m'https://raw.githubusercontent.com/go-gitea/gitea/refs/heads/mainn\u001b[23;1H/contrib/service/systemd/gitea.service'\u001b[m\u001b[24;7H\u001b[36mcopy\u001b[m\u001b[35m:\u001b[m\u001b[25;9H\u001b[36mdest\u001b[m\u001b[35m:\u001b[m /etc/systemd/system/gitea.service\u001b[26;9H\u001b[36mowner\u001b[m\u001b[35m:\u001b[m root\u001b[27;9H\u001b[36mgroup\u001b[m\u001b[35m:\u001b[m root\u001b[28;9H\u001b[36mmode\u001b[m\u001b[35m:\u001b[m \u001b[31m'644'\u001b[m\u001b[29;8H\u001b[34m # retrieve service file and replace with dependencies. the lookup retrieves thh\u001b[30;1He url\u001b[31;8H # as a note this doesn't currently use redis\u001b[m\u001b[32;9H\u001b[36mcontent\u001b[m\u001b[35m:\u001b[m \u001b[35m|-\u001b[m\u001b[33;11H{{\u001b[34;13Hlookup('ansible.builtin.url', service_url, split_lines=False) |\u001b[35;69H81,4\u001b[10C59%\u001b[17;4H\u001b[?25h\u001b[?4m\u001bP+q436f\u001b\\\u001bP+q6b75\u001b\\\u001bP+q6b64\u001b\\\u001bP+q6b72\u001b\\\u001bP+q6b6c\u001b\\\u001bP+q2332\u001b\\\u001bP+q2334\u001b\\\u001bP+q2569\u001b\\\u001bP+q2a37\u001b\\\u001bP+q6b31\u001b\\\u001bP$q q\u001b\\\u001b[?12$p\u001b[?25l\u001b[35;59H:\u001b[17;4H\u001b[35;60Hf\u001b[17;4H\u001b[35;61Hf\u001b[17;4H\u001b[35;62Hf\u001b[17;4H\u001b[35;63Hf\u001b[17;4H\u001b[35;64H/\u001b[17;4H\u001b[35;65Hf\u001b[17;4H\u001b[35;66Hf\u001b[17;4H\u001b[35;67Hf\u001b[17;4H\u001b[35;68Hf\u001b[17;4H\u001b[35;59H          \u001b[17;4H\u001b[?25h"]
