[6243.884333, "o", "\u001b[1;1H\u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m Lab \u001b[31m7\u001b[m\r\n  \u001b[36mhosts\u001b[m\u001b[35m:\u001b[m target\u001b[2;16H\u001b[K\u001b[3;1H  \u001b[36mbecome\u001b[m\u001b[35m:\u001b[m \u001b[31mtrue\u001b[m\u001b[3;15H\u001b[K\u001b[4;3H\u001b[36mvars\u001b[m\u001b[35m:\u001b[m\r\n    \u001b[36mgitea_version\u001b[m\u001b[35m:\u001b[m 28.3.0\r\n    \u001b[36mgitea_db_user\u001b[m\u001b[35m:\u001b[m git\r\n    \u001b[36mgitea_db_name\u001b[m\u001b[35m:\u001b[m gitea\r\n    \u001b[36mgitea_db_pass\u001b[m\u001b[35m:\u001b[m secure_password \u001b[34m # I'm assuming this doesn't actually need to be see\u001b[9;1Hcure for this lab\u001b[m\r\n    \u001b[36mgitea_source\u001b[m\u001b[35m:\u001b[m https://dl.gitea.com/\r\n    \u001b[36mgitea_secret_names\u001b[m\u001b[35m:\u001b[m \u001b[35m[\u001b[mSECRET_KEY, INTERNAL_TOKEN, JWT_SECRET\u001b[35m]\u001b[m\r\n  \u001b[36mtasks\u001b[m\u001b[35m:\u001b[m\r\n   \u001b[34m ## database setup\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m Install Postgres\u001b[15;7H\u001b[36mapt\u001b[m\u001b[35m:\u001b[m\u001b[16;9H\u001b[36mname\u001b[m\u001b[35m:\u001b[m postgresql\u001b[17;9H\u001b[36mstate\u001b[m\u001b[35m:\u001b[m present\u001b[18;9H\u001b[36mupdate_cache\u001b[m\u001b[35m:\u001b[m yes\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m Start Postgres\u001b[20;7H\u001b[36mservice\u001b[m\u001b[35m:\u001b[m\u001b[21;9H\u001b[36mname\u001b[m\u001b[35m:\u001b[m postgresql\u001b[22;9H\u001b[36mstate\u001b[m\u001b[35m:\u001b[m started\u001b[23;9H\u001b[36menabled\u001b[m\u001b[35m:\u001b[m \u001b[31mtrue\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m create postgres user/database\u001b[25;7H\u001b[36mbecome\u001b[m\u001b[35m:\u001b[m \u001b[31mtrue\u001b[m\u001b[26;7H\u001b[36mbecome_user\u001b[m\u001b[35m:\u001b[m postgres\u001b[27;7H\u001b[36mregister\u001b[m\u001b[35m:\u001b[m gitea_db_setup\u001b[28;7H\u001b[36mchanged_when\u001b[m\u001b[35m:\u001b[m \u001b[31m\"'CREATE' in gitea_db_setup.stdout\"\u001b[m\u001b[34m # this would indicate that thee\u001b[29;1H corresponding data was created\u001b[m\u001b[30;7H\u001b[36mcommand\u001b[m\u001b[35m:\u001b[m\u001b[31;9H\u001b[36margv\u001b[m\u001b[35m:\u001b[m\u001b[32;11H\u001b[38;5;130m-\u001b[m psql\u001b[33;11H\u001b[38;5;130m-\u001b[m \u001b[31m\"-vON_ERROR_STOP=1\"\u001b[m\u001b[34;11H\u001b[38;5;130m-\u001b[m \u001b[31m\"-vuser={{gitea_db_user}}\"\u001b[m\u001b[35;69H1,13\u001b[10CTop\u001b[1;13H\u001b[?25h\u001b[?4m\u001bP+q436f\u001b\\\u001bP+q6b75\u001b\\\u001bP+q6b64\u001b\\\u001bP+q6b72\u001b\\\u001bP+q6b6c\u001b\\\u001bP+q2332\u001b\\\u001bP+q2334\u001b\\\u001bP+q2569\u001b\\\u001bP+q2a37\u001b\\\u001bP+q6b31\u001b\\\u001bP$q q\u001b\\\u001b[?12$p\u001b[?25l\u001b[35;59H:\u001b[1;13H\u001b[35;60Hf\u001b[1;13H\u001b[35;61Hf\u001b[1;13H\u001b[35;62Hf\u001b[1;13H\u001b[35;63Hf\u001b[1;13H\u001b[35;64H/\u001b[1;13H\u001b[35;65Hf\u001b[1;13H\u001b[35;66Hf\u001b[1;13H\u001b[35;67Hf\u001b[1;13H\u001b[35;68Hf\u001b[1;13H\u001b[35;59H          \u001b[1;13H\u001b[?25h"]
