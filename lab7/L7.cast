[12602.871295, "o", "\u001b[?25l\u001b[1;16r\u001b[1;1H\u001b[3M\u001b[1;35r\u001b[14;7H\u001b[36mservice\u001b[m\u001b[35m:\u001b[m\u001b[15;9H\u001b[36mname\u001b[m\u001b[35m:\u001b[m postgresql\u001b[16;9H\u001b[36mstate\u001b[m\u001b[35m:\u001b[m started\u001b[17;85H\u001b[7m4\u001b[23;36H\u001b[?25h"]
