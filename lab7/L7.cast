[112.538227, "o", "\u001b[1;1H\u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m Lab \u001b[31m7\u001b[m\r\n  \u001b[36mhosts\u001b[m\u001b[35m:\u001b[m target\u001b[2;16H\u001b[K\u001b[3;1H  \u001b[36mbecome\u001b[m\u001b[35m:\u001b[m \u001b[31mtrue\u001b[m\u001b[3;15H\u001b[K\u001b[4;3H\u001b[36mvars\u001b[m\u001b[35m:\u001b[m\r\n    \u001b[36mgitea_version\u001b[m\u001b[35m:\u001b[m 28.3.0\r\n    \u001b[36mgitea_db_user\u001b[m\u001b[35m:\u001b[m git\r\n    \u001b[36mgitea_db_name\u001b[m\u001b[35m:\u001b[m gitea\r\n    \u001b[36mgitea_db_pass\u001b[m\u001b[35m:\u001b[m secure_password \u001b[34m # I'm assuming this doesn't actually need to be secure for this lab\u001b[m\r\n  \u001b[36mtasks\u001b[m\u001b[35m:\u001b[m\r\n   \u001b[34m ## database setup\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m Install Postgres\u001b[12;7H\u001b[36mapt\u001b[m\u001b[35m:\u001b[m\u001b[13;9H\u001b[36mname\u001b[m\u001b[35m:\u001b[m postgresql\u001b[14;9H\u001b[36mstate\u001b[m\u001b[35m:\u001b[m present\u001b[15;9H\u001b[36mupdate_cache\u001b[m\u001b[35m:\u001b[m yes\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m Start Postgres\u001b[17;7H\u001b[36mservice\u001b[m\u001b[35m:\u001b[m\u001b[18;9H\u001b[36mname\u001b[m\u001b[35m:\u001b[m postgresql\u001b[19;9H\u001b[36mstate\u001b[m\u001b[35m:\u001b[m started\u001b[20;9H\u001b[36menabled\u001b[m\u001b[35m:\u001b[m \u001b[31mtrue\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m create postgres user/database\u001b[22;7H\u001b[36mbecome\u001b[m\u001b[35m:\u001b[m \u001b[31mtrue\u001b[m\u001b[23;7H\u001b[36mbecome_user\u001b[m\u001b[35m:\u001b[m postgres\u001b[24;7H\u001b[36mregister\u001b[m\u001b[35m:\u001b[m gitea_db_setup\u001b[25;7H\u001b[36mchanged_when\u001b[m\u001b[35m:\u001b[m \u001b[31m\"'CREATE' in gitea_db_setup.stdout\"\u001b[m\u001b[34m # this would indicate that the corresponding data was created\u001b[m\u001b[26;7H\u001b[36mcommand\u001b[m\u001b[35m:\u001b[m\u001b[27;9H\u001b[36margv\u001b[m\u001b[35m:\u001b[m\u001b[28;11H\u001b[38;5;130m-\u001b[m psql\u001b[29;11H\u001b[38;5;130m-\u001b[m \u001b[31m\"-vON_ERROR_STOP=1\"\u001b[m\u001b[30;11H\u001b[38;5;130m-\u001b[m \u001b[31m\"-vuser={{gitea_db_user}}\"\u001b[m\u001b[31;11H\u001b[38;5;130m-\u001b[m \u001b[31m\"-vname={{gitea_db_name}}\"\u001b[m\u001b[32;11H\u001b[38;5;130m-\u001b[m \u001b[31m\"-vpass={{gitea_db_pass}}\"\u001b[m\u001b[33;8H\u001b[34m # create roles as needed\u001b[m\u001b[34;9H\u001b[36mstdin\u001b[m\u001b[35m:\u001b[m \u001b[35m|\u001b[m\u001b[35;11HSELECT format('CREATE ROLE %I WITH LOGIN PASSWORD %L', :'user', :'pass')\u001b[36;11HWHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = :'user') \\gexec\u001b[37;11HSELECT format('CREATE DATABASE %I WITH OWNER %I TEMPLATE template0 ENCODING UTF8 LC_COLLATE ''en_US.UTF-8'' LC_CTYPE ''en_US.UTF-8''', :'name', :'user')\u001b[38;159H2,15\u001b[10CTop\u001b[2;15H\u001b[?25h\u001b[?4m"]
