[7488.329974, "o", "\u001b[?1h\u001b=\r\u001b[1mdiff --git a/lab7/L7.yml b/lab7/L7.yml\u001b[m\u001b[m\r\n\u001b[1mindex fedaf37..2c9733f 100644\u001b[m\u001b[m\r\n\u001b[1m--- a/lab7/L7.yml\u001b[m\u001b[m\r\n\u001b[1m+++ b/lab7/L7.yml\u001b[m\u001b[m\r\n\u001b[36m@@ -7,6 +7,7 @@\u001b[m\u001b[m\r\n     gitea_db_name: gitea\u001b[m\u001b[m\r\n     gitea_db_pass: secure_password  # I'm assuming this doesn't actually need to be s\u001b[m \becure for this lab\u001b[m\u001b[m\r\n     gitea_source: https://dl.gitea.com/\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    gitea_secret_names: [SECRET_KEY, INTERNAL_TOKEN, JWT_SECRET]\u001b[m\u001b[m\r\n   tasks:\u001b[m\u001b[m\r\n     ## database setup\u001b[m\u001b[m\r\n     - name: Install Postgres\u001b[m\u001b[m\r\n\u001b[36m@@ -56,28 +57,26 @@\u001b[m\u001b[m\r\n         comment: Git Version Control\u001b[m\u001b[m\r\n     - name: create file structure\u001b[m\u001b[m\r\n       vars:\u001b[m\u001b[m\r\n\u001b[31m-        lib: /var/lib/gitea \u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        lib: /var/lib/gitea\u001b[m\u001b[m\r\n       file:\u001b[m\u001b[m\r\n         path: \"{{ item.path }}\"\u001b[m\u001b[m\r\n         owner: \"{{ item.owner | default('git') }}\"\u001b[m\u001b[m\r\n\u001b[31m-        group: git\u001b[m\u001b[m\r\n\u001b[31m-        recurse: true\u001b[m\u001b[m\r\n\u001b[31m-        mode: \"{{ item.mode | default('750') }}\"\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        group: git\u001b[m\u001b[41m \u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        mode: '750'\u001b[m\u001b[m\r\n         state: directory\u001b[m\u001b[m\r\n       loop:\u001b[m\u001b[m\r\n         - { path: \"{{lib}}\" }\u001b[m\u001b[m\r\n         - { path: \"{{lib}}/custom\" }\u001b[m\u001b[m\r\n         - { path: \"{{lib}}/data\" }\u001b[m\u001b[m\r\n         - { path: \"{{lib}}/log\" }\u001b[m\u001b[m\r\n\u001b[31m-        - { path: /etc/gitea, owner: root, mode: '770' }\u001b[m\u001b[m\r\n:\u001b[K"]
[7489.371195, "o", "\r\u001b[K\u001b[32m+\u001b[m\u001b[32m        - { path: /etc/gitea, owner: root }\u001b[m\u001b[m\r\n:\u001b[K"]
