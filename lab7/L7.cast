[6508.570356, "o", "\u001b[2;1H   \u001b[34m ## secrets\u001b[m\u001b[2;15H\u001b[K\u001b[3;1H    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m generate secrets\u001b[3;29H\u001b[K\u001b[4;7H\u001b[36mshell\u001b[m\u001b[35m:\u001b[m gitea generate secret {{ item }} > {{ item }}\u001b[5;7H\u001b[36margs\u001b[m\u001b[35m:\u001b[m\u001b[6;9H\u001b[36mchdir\u001b[m\u001b[35m:\u001b[m /etc/gitea\u001b[7;9H\u001b[36mcreates\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{ item }}\"\u001b[m\u001b[8;7H\u001b[36mloop\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{ gitea_secret_names }}\"\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m secure secrets\u001b[10;7H\u001b[36mfile\u001b[m\u001b[35m:\u001b[m\u001b[11;9H\u001b[36mpath\u001b[m\u001b[35m:\u001b[m /etc/gitea/{{item}}\u001b[12;9H\u001b[36mmode\u001b[m\u001b[35m:\u001b[m \u001b[31m640\u001b[m\u001b[13;7H\u001b[36mloop\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{gitea_secret_names}}\"\u001b[m\u001b[15;4H\u001b[34m ## config\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m create app.ini\u001b[17;7H\u001b[36mnotify\u001b[m\u001b[35m:\u001b[m restart gitea\u001b[18;7H\u001b[36mcopy\u001b[m\u001b[35m:\u001b[m\u001b[19;9H\u001b[36mdest\u001b[m\u001b[35m:\u001b[m /etc/gitea/app.ini\u001b[20;9H\u001b[36mmode\u001b[m\u001b[35m:\u001b[m \u001b[31m640\u001b[m\u001b[21;9H\u001b[36mcontent\u001b[m\u001b[35m:\u001b[m \u001b[35m|-\u001b[m\u001b[22;11H[security]\u001b[23;11HINSTALL_LOCK     = true\u001b[24;11HSECRET_KEY_URI   = file:/etc/gitea/SECRET_KEY\u001b[25;11HINTERNAL_TOKEN_URI = file:/etc/gitea/INTERNAL_TOKEN\u001b[27;11H[database]\u001b[28;11HDB_TYPE = postgres\u001b[29;11HNAME    = {{gitea_db_name}}\u001b[30;11HUSER    = {{gitea_db_user}}\u001b[31;11HPASSWD  = {{gitea_db_pass}}\u001b[33;11H[oauth2]\u001b[34;11HJWT_SECRET_URI = file:/etc/gitea/JWT_SECRET\u001b[35;69H116,6\u001b[9C91%\u001b[17;6H\u001b[?25h\u001b[?4m"]
