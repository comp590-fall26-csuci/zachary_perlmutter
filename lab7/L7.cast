[12778.297832, "o", "\u001b[1;11HWHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = :'name') \\gexec\u001b[2;1H\u001b[K\u001b[3;1H   \u001b[34m ## gitea setup\u001b[m\u001b[3;19H\u001b[K\u001b[4;5H\u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m Ensure Git is installed\u001b[5;7H\u001b[36mapt\u001b[m\u001b[35m:\u001b[m\u001b[6;9H\u001b[36mname\u001b[m\u001b[35m:\u001b[m git\u001b[7;9H\u001b[36mstate\u001b[m\u001b[35m:\u001b[m present\u001b[8;9H\u001b[36mupdate_cache\u001b[m\u001b[35m:\u001b[m yes\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m add service group\u001b[10;7H\u001b[36mgroup\u001b[m\u001b[35m:\u001b[m\u001b[11;9H\u001b[36mname\u001b[m\u001b[35m:\u001b[m git\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m add service user\u001b[13;7H\u001b[36muser\u001b[m\u001b[35m:\u001b[m\u001b[14;9H\u001b[36mname\u001b[m\u001b[35m:\u001b[m git\u001b[15;9H\u001b[36mgroup\u001b[m\u001b[35m:\u001b[m git\u001b[16;9H\u001b[36mshell\u001b[m\u001b[35m:\u001b[m /bin/bash\u001b[17;9H\u001b[36msystem\u001b[m\u001b[35m:\u001b[m \u001b[31mtrue\u001b[m\u001b[18;9H\u001b[36mcomment\u001b[m\u001b[35m:\u001b[m Git Version Control\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m create file structure\u001b[20;7H\u001b[36mvars\u001b[m\u001b[35m:\u001b[m\u001b[21;9H\u001b[36mlib\u001b[m\u001b[35m:\u001b[m /var/lib/gitea\u001b[22;7H\u001b[36mfile\u001b[m\u001b[35m:\u001b[m\u001b[23;9H\u001b[36mpath\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{ item.path }}\"\u001b[m\u001b[24;9H\u001b[36mowner\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{ item.owner | default('git') }}\"\u001b[m\u001b[25;9H\u001b[36mgroup\u001b[m\u001b[35m:\u001b[m git\u001b[26;9H\u001b[36mmode\u001b[m\u001b[35m:\u001b[m \u001b[31m'750'\u001b[m\u001b[27;9H\u001b[36mstate\u001b[m\u001b[35m:\u001b[m directory\u001b[28;7H\u001b[36mloop\u001b[m\u001b[35m:\u001b[m\u001b[29;9H\u001b[38;5;130m-\u001b[m \u001b[35m{\u001b[m \u001b[36m