[2261.212035, "o", "\u001b[?25l\u001b[24;1H\u001b[1m-- INSERT --\u001b[m\u001b[24;13H\u001b[K\u001b[24;64H98,3\u001b[10C96%\u001b[1;1H        \u001b[36mservice_url\u001b[m\u001b[35m:\u001b[m \u001b[31m'https://raw.githubusercontent.com/go-gitea/gitea/refs/headss\u001b[2;1H/main/contrib/service/systemd/gitea.service'\u001b[m\r\n      \u001b[36mcopy\u001b[m\u001b[35m:\u001b[m\u001b[3;12H\u001b[K\u001b[4;1H        \u001b[36mdest\u001b[m\u001b[35m:\u001b[m /etc/systemd/system/gitea.service\r\n        \u001b[36mowner\u001b[m\u001b[35m:\u001b[m root\u001b[5;20H\u001b[K\u001b[6;1H        \u001b[36mgroup\u001b[m\u001b[35m:\u001b[m root\u001b[6;20H\u001b[K\u001b[7;1H        \u001b[36mmode\u001b[m\u001b[35m:\u001b[m \u001b[31m644\u001b[m\u001b[7;18H\u001b[K\u001b[8;1H       \u001b[34m # retrieve service file and replace with dependencies. the lookup retrievv\u001b[9;1Hes the url\u001b[m\u001b[9;11H\u001b[K\u001b[10;1H       \u001b[34m # as a note this doesn't currently use redis\u001b[m\r\n        \u001b[36mcontent\u001b[m\u001b[35m:\u001b[m \u001b[35m|-\u001b[m\r\n          {{ \u001b[12;14H\u001b[K\u001b[13;1H            lookup('ansible.builtin.url', service_url, split_lines=False) |\r\n            regex_replace('^#((?:Wants|After)=(?:postgresql)\\.service)$', '\\1')\r\n          }}\u001b[15;13H\u001b[K\u001b[16;3H\u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m generate runner token\r\n    \u001b[36mcommand\u001b[m\u001b[35m:\u001b[m\u001b[17;13H\u001b[K\u001b[18;7H\u001b[36mcmd\u001b[m\u001b[35m:\u001b[m gitea --config /etc/gitea/app.ini generate_runner_token\r\n  \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m install gitea runner\r\n    \u001b[36mvars\u001b[m\u001b[35m:\u001b[m\u001b[20;10H\u001b[K\u001b[21;5H  \u001b[36mversion\u001b[m\u001b[35m:\u001b[m 4.4.1\u001b[21;21H\u001b[K\u001b[22;8H\u001b[36mource\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{gitea_source}}/gitea-runner/{{version}}/gitea-runner-{{version}}}\u001b[23;1H-linux-amd63\"\u001b[m\u001b[23;15H\u001b[K\u001b[24;64H\u001b[K\u001b[24;64H98,3\u001b[10C55%\u001b[16;3H\u001b[?25h"]
[2261.212997, "o", "\u001b[?25l\u001b[1;23r\u001b[1;1H\u001b[3L\u001b[1;24r\u001b[1;5H\u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m create service file\u001b[2;7H\u001b[36mnotify\u001b[m\u001b[35m:\u001b[m restart gitea\u001b[3;7H\u001b[36mvars\u001b[m\u001b[35m:\u001b[m\u001b[24;64H\u001b[K\u001b[24;64H97,3\u001b[10C54%\u001b[18;3H\u001b[?25h"]
