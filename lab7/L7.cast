[12602.907919, "o", "\u001b[?25l\u001b[1;16r\u001b[m\u001b[1;1H\u001b[3M\u001b[1;35r\u001b[14;7H\u001b[36mregister\u001b[m\u001b[35m:\u001b[m gitea_db_setup\u001b[15;7H\u001b[36mchanged_when\u001b[m\u001b[35m:\u001b[m \u001b[31m\"'CREATE' in gitea_db_setup.stdout\"\u001b[m\u001b[34m # this would indicate that thee\u001b[16;1H corresponding data was created\u001b[m\u001b[17;70H\u001b[7m8\u001b[14C9\u001b[23;36H\u001b[?25h"]
[12602.926721, "o", "\u001b[?25l\u001b[1;16r\u001b[m\u001b[1;1H\u001b[3M\u001b[1;35r\u001b[14;7H\u001b[36mcommand\u001b[m\u001b[35m:\u001b[m\u001b[15;9H\u001b[36margv\u001b[m\u001b[35m:\u001b[m\u001b[16;11H\u001b[38;5;130m-\u001b[m psql\u001b[17;69H\u001b[7m21\u001b[13C12\u001b[23;36H\u001b[?25h"]
[12602.970561, "o", "\u001b[?25l\u001b[1;16r\u001b[m\u001b[1;1H\u001b[3M\u001b[1;35r\u001b[14;11H\u001b[38;5;130m-\u001b[m \u001b[31m\"-vON_ERROR_STOP=1\"\u001b[m\u001b[15;11H\u001b[38;5;130m-\u001b[m \u001b[31m\"-vuser={{gitea_db_user}}\"\u001b[m\u001b[16;11H\u001b[38;5;130m-\u001b[m \u001b[31m\"-vname={{gitea_db_name}}\"\u001b[m\u001b[17;70H\u001b[7m4,18\u001b[11C4\u001b[23;36H\u001b[?25h"]
[12603.728448, "o", "\u001b[?25l\u001b[1;16r\u001b[m\u001b[1;1H\u001b[3M\u001b[1;35r\u001b[14;11H\u001b[38;5;130m-\u001b[m \u001b[31m\"-vpass={{gitea_db_pass}}\"\u001b[m\u001b[15;8H\u001b[34m # create roles as needed\u001b[m\u001b[16;9H\u001b[36mstdin\u001b[m\u001b[35m:\u001b[m \u001b[35m|\u001b[m\u001b[17;70H\u001b[7m7,19\u001b[11C6\u001b[23;36H\u001b[?25h"]
[12603.748759, "o", "\u001b[?25l\u001b[1;16r\u001b[m\u001b[1;1H\u001b[3M\u001b[1;35r\u001b[14;11HSELECT format('CREATE ROLE %I WITH LOGIN PASSWORD %L', :'user', :'pass')\u001b[15;11HWHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = :'user') \\gexec\u001b[16;11HSELECT format('CREATE DATABASE %I WITH OWNER %I TEMPLATE template0 ENCODING\r\u001b[94m@@@                                                                                   \u001b[m\u001b[17;70H\u001b[7m9,13\u001b[11C9\u001b[23;36H\u001b[?25h"]
[12603.770993, "o", "\u001b[?25l\u001b[1;16r\u001b[m\u001b[1;1H\u001b[4M\u001b[1;35r\u001b[12;1H          SELECT format('CREATE DATABASE %I WITH OWNER %I TEMPLATE template0 ENCODING  \u001b[13;1HUTF8 LC_COLLATE ''en_US.UTF-8'' LC_CTYPE ''en_US.UTF-8''', :'name', :'user')\u001b[14;11HWHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = :'name') \\gexec\u001b[16;4H\u001b[34m ## gitea setup\u001b[m\u001b[17;69H\u001b[7m33,19\u001b[10C21\u001b[23;36H\u001b[?25h"]
[12603.798966, "o", "\u001b[?25l\u001b[1;16r\u001b[m\u001b[1;1H\u001b[3M\u001b[1;35r\u001b[14;5H\u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m Ensure Git is installed\u001b[15;7H\u001b[36mapt\u001b[m\u001b[35m:\u001b[m\u001b[16;9H\u001b[36mname\u001b[m\u001b[35m:\u001b[m git\u001b[17;70H\u001b[7m6,16\u001b[11C4\u001b[23;36H\u001b[?25h"]
[12604.264373, "o", "\u001b[?25l\u001b[1;16r\u001b[m\u001b[1;1H\u001b[3M\u001b[1;35r\u001b[14;9H\u001b[36mstate\u001b[m\u001b[35m:\u001b[m present\u001b[15;9H\u001b[36mupdate_cache\u001b[m\u001b[35m:\u001b[m yes\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m add service group\u001b[17;70H\u001b[7m9,19\u001b[11C6\u001b[23;36H\u001b[?25h"]
[12604.729731, "o", "\u001b[?25l\u001b[1;16r\u001b[m\u001b[1;1H\u001b[3M\u001b[1;35r\u001b[14;7H\u001b[36mgroup\u001b[m\u001b[35m:\u001b[m\u001b[15;9H\u001b[36mname\u001b[m\u001b[35m:\u001b[m git\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m add service user\u001b[17;69H\u001b[7m41,0-1\u001b[10C9\u001b[23;36H\u001b[?25h"]
[12604.743464, "o", "\u001b[?25l\u001b[1;16r\u001b[m\u001b[1;1H\u001b[4M\u001b[1;35r\u001b[13;7H\u001b[36muser\u001b[m\u001b[35m:\u001b[m\u001b[14;9H\u001b[36mname\u001b[m\u001b[35m:\u001b[m git\u001b[15;9H\u001b[36mgroup\u001b[m\u001b[35m:\u001b[m git\u001b[16;9H\u001b[36mshell\u001b[m\u001b[35m:\u001b[m /bin/bash\u001b[17;70H\u001b[7m5,17 \u001b[9C31\u001b[23;36H\u001b[?25h"]
[12604.765015, "o", "\u001b[?25l\u001b[1;16r\u001b[m\u001b[1;1H\u001b[3M\u001b[1;35r\u001b[14;9H\u001b[36msystem\u001b[m\u001b[35m:\u001b[m \u001b[31mtrue\u001b[m\u001b[15;9H\u001b[36mcomment\u001b[m\u001b[35m:\u001b[m Git Version Control\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m create file structure\u001b[17;70H\u001b[7m8,19\u001b[11C4\u001b[23;36H\u001b[?25h"]
[12604.814206, "o", "\u001b[?25l\u001b[1;16r\u001b[m\u001b[1;1H\u001b[3M\u001b[1;35r\u001b[14;7H\u001b[36mvars\u001b[m\u001b[35m:\u001b[m\u001b[15;9H\u001b[36mlib\u001b[m\u001b[35m:\u001b[m /var/lib/gitea\u001b[16;7H\u001b[36mfile\u001b[m\u001b[35m:\u001b[m\u001b[17;69H\u001b[7m51\u001b[14C6\u001b[23;36H\u001b[?25h"]
