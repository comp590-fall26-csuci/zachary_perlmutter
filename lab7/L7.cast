[293.597264, "o", "\u001b[1;7H\u001b[36mchanged_when\u001b[m\u001b[35m:\u001b[m \u001b[31m\"'CREATE' in gitea_db_setup.stdout\"\u001b[m\u001b[34m # this would indicate that the corresponding data waa\u001b[2;1Hs created\u001b[m\u001b[2;10H\u001b[K\u001b[3;1H      \u001b[36mcommand\u001b[m\u001b[35m:\u001b[m\u001b[3;15H\u001b[K\u001b[4;9H\u001b[36margv\u001b[m\u001b[35m:\u001b[m\u001b[5;11H\u001b[38;5;130m-\u001b[m psql\u001b[6;11H\u001b[38;5;130m-\u001b[m \u001b[31m\"-vON_ERROR_STOP=1\"\u001b[m\u001b[7;11H\u001b[38;5;130m-\u001b[m \u001b[31m\"-vuser={{gitea_db_user}}\"\u001b[m\u001b[8;11H\u001b[38;5;130m-\u001b[m \u001b[31m\"-vname={{gitea_db_name}}\"\u001b[m\u001b[9;11H\u001b[38;5;130m-\u001b[m \u001b[31m\"-vpass={{gitea_db_pass}}\"\u001b[m\u001b[10;8H\u001b[34m # create roles as needed\u001b[m\u001b[11;9H\u001b[36mstdin\u001b[m\u001b[35m:\u001b[m \u001b[35m|\u001b[m\u001b[12;11HSELECT format('CREATE ROLE %I WITH LOGIN PASSWORD %L', :'user', :'pass')\u001b[13;11HWHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = :'user') \\gexec\u001b[14;11HSELECT format('CREATE DATABASE %I WITH OWNER %I TEMPLATE template0 ENCODING UTF8 LC_COLLATE ''en_UU\u001b[15;1HS.UTF-8'' LC_CTYPE ''en_US.UTF-8''', :'name', :'user')\u001b[16;11HWHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = :'name') \\gexec\u001b[18;4H\u001b[34m ## gitea setup\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m Ensure Git is installed\u001b[20;7H\u001b[36mapt\u001b[m\u001b[35m:\u001b[m\u001b[21;9H\u001b[36mname\u001b[m\u001b[35m:\u001b[m git\u001b[22;9H\u001b[36mstate\u001b[m\u001b[35m:\u001b[m present\u001b[23;9H\u001b[36mupdate_cache\u001b[m\u001b[35m:\u001b[m yes\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m add service group\u001b[25;7H\u001b[36mgroup\u001b[m\u001b[35m:\u001b[m\u001b[26;9H\u001b[36mname\u001b[m\u001b[35m:\u001b[m git\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m add service user\u001b[28;7H\u001b[36muser\u001b[m\u001b[35m:\u001b[m\u001b[29;9H\u001b[36mname\u001b[m\u001b[35m:\u001b[m git\u001b[30;9H\u001b[36mgroup\u001b[m\u001b[35m:\u001b[m git\u001b[31;9H\u001b[36mshell\u001b[m\u001b[35m:\u001b[m /bin/bash\u001b[32;9H\u001b[36msystem\u001b[m\u001b[35m:\u001b[m \u001b[31mtrue\u001b[m\u001b[33;9H\u001b[36mcomment\u001b[m\u001b[35m:\u001b[m Git Version Control\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m create /var/lib entry\u001b[35;7H\u001b[36mfile\u001b[m\u001b[35m:\u001b[m\u001b[36;9H\u001b[36mpath\u001b[m\u001b[35m:\u001b[m /var/lib/gitea/\u001b[35m{\u001b[mcustom,data,log\u001b[35m}\u001b[m\u001b[37;9H\u001b[36mowner\u001b[m\u001b[35m:\u001b[m git\u001b[38;91H54,20\u001b[9C36%\u001b[32;20H\u001b[?25h\u001b[?4m\u001bP+q436f\u001b\\\u001bP+q6b75\u001b\\\u001bP+q6b64\u001b\\\u001bP+q6b72\u001b\\\u001bP+q6b6c\u001b\\\u001bP+q2332\u001b\\\u001bP+q2334\u001b\\\u001bP+q2569\u001b\\\u001bP+q2a37\u001b\\\u001bP+q6b31\u001b\\\u001bP$q q\u001b\\\u001b[?12$p\u001b[?25l\u001b[38;81H:\u001b[32;20H\u001b[38;82Hf\u001b[32;20H\u001b[38;83Hf\u001b[32;20H\u001b[38;84Hf\u001b[32;20H\u001b[38;85Hf\u001b[32;20H\u001b[38;86H/\u001b[32;20H\u001b[38;87Hf\u001b[32;20H\u001b[38;88Hf\u001b[32;20H\u001b[38;89Hf\u001b[32;20H\u001b[38;90Hf\u001b[32;20H\u001b[38;81H          \u001b[32;20H\u001b[?25h"]
