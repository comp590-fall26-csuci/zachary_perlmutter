[7561.849132, "o", "\u001b[2;1H▽\u001b[6n\u001b[2;1H  \u001b[3;1H\u001bPzz\u001b\\\u001b[0%m\u001b[6n\u001b[3;1H           \u001b[1;1H\u001b[>c\u001b]10;?\u0007\u001b]11;?\u0007"]
[7561.854304, "o", "\u001b[1;1H\u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m Runner\r\n  \u001b[36mhosts\u001b[m\u001b[35m:\u001b[m target\u001b[2;16H\u001b[K\u001b[3;1H  \u001b[36mbecome\u001b[m\u001b[35m:\u001b[m \u001b[31mtrue\u001b[m\u001b[3;15H\u001b[K\u001b[4;3H\u001b[36mtasks\u001b[m\u001b[35m:\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m generate runner token\u001b[6;7H\u001b[36mcommand\u001b[m\u001b[35m:\u001b[m\u001b[7;9H\u001b[36mcmd\u001b[m\u001b[35m:\u001b[m gitea --config /etc/gitea/app.ini generate_runner_token\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m install gitea runner\u001b[9;7H\u001b[36mvars\u001b[m\u001b[35m:\u001b[m\u001b[10;9H\u001b[36mversion\u001b[m\u001b[35m:\u001b[m 5.4.1\u001b[11;9H\u001b[36msource\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{gitea_source}}/gitea-runner/{{version}}/gitea-runner-{{version}}-lii\u001b[12;1Hnux-amd64\"\u001b[m\u001b[13;7H\u001b[36mget_url\u001b[m\u001b[35m:\u001b[m\u001b[14;9H\u001b[36mdest\u001b[m\u001b[35m:\u001b[m /usr/local/bin/gitea-runner\u001b[15;9H\u001b[36murl\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{source}}\"\u001b[m\u001b[16;9H\u001b[36mchecksum\u001b[m\u001b[35m:\u001b[m \u001b[31m\"sha256:{{source}}.sha256\"\u001b[m\u001b[17;9H\u001b[36mmode\u001b[m\u001b[35m:\u001b[m \u001b[31m0755\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m create runner user\u001b[19;7H\u001b[36muser\u001b[m\u001b[35m:\u001b[m\u001b[20;9H\u001b[36mname\u001b[m\u001b[35m:\u001b[m gitea-runner\u001b[21;9H\u001b[36msystem\u001b[m\u001b[35m:\u001b[m \u001b[31mtrue\u001b[m\u001b[22;9H\u001b[36mhome\u001b[m\u001b[35m:\u001b[m /var/lib/gitea-runner\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m create /etc\u001b[24;7H\u001b[36mfile\u001b[m\u001b[35m:\u001b[m\u001b[25;9H\u001b[36mpath\u001b[m\u001b[35m:\u001b[m /etc/gitea-runner\u001b[26;9H\u001b[36mowner\u001b[m\u001b[35m:\u001b[m gitea-runner\u001b[27;9H\u001b[36mstate\u001b[m\u001b[35m:\u001b[m directory\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m initialize runner config\u001b[29;6H\u001b[36mcommand\u001b[m\u001b[35m:\u001b[m\u001b[30;8H\u001b[36mcmd\u001b[m\u001b[35m:\u001b[m gitea-runner config init -c /etc/gitea-runner/config.yml\u001b[31;8H\u001b[36mcreates\u001b[m\u001b[35m:\u001b[m /etc/gitea-runner/config.yml\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m register\u001b[33;7H\u001b[36mbecome\u001b[m\u001b[35m:\u001b[m gitea-runner\u001b[34;7H\u001b[36mchdir\u001b[m\u001b[35m:\u001b[m /etc/gitea-runner\u001b[35;69H1,2\u001b[11CTop\u001b[1;2H\u001b[?25h\u001b[?4m\u001bP+q436f\u001b\\\u001bP+q6b75\u001b\\\u001bP+q6b64\u001b\\\u001bP+q6b72\u001b\\\u001bP+q6b6c\u001b\\\u001bP+q2332\u001b\\\u001bP+q2334\u001b\\\u001bP+q2569\u001b\\\u001bP+q2a37\u001b\\\u001bP+q6b31\u001b\\\u001bP$q q\u001b\\\u001b[?12$p\u001b[?25l\u001b[35;59H:\u001b[1;2H\u001b[35;60Hf\u001b[1;2H\u001b[35;61Hf\u001b[1;2H\u001b[35;62Hf\u001b[1;2H\u001b[35;63Hf\u001b[1;2H\u001b[35;64H/\u001b[1;2H\u001b[35;65Hf\u001b[1;2H\u001b[35;66Hf\u001b[1;2H\u001b[35;67Hf\u001b[1;2H\u001b[35;68Hf\u001b[1;2H\u001b[35;59H          \u001b[1;2H\u001b[?25h"]
