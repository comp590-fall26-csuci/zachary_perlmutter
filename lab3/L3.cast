[2008.132218, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              Both these commands do the same thing.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1097/1271 91% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2008.139198, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1096/1271 91% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                  \u001b[1m$ find . -perm -g+w,u+w\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1095/1271 91% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2008.170449, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                  \u001b[1m$ find . -perm -220\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1094/1271 91% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2008.170771, "o", "\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1093/1271 91% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       •      Search for files which are writable by both their owner and their group.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1092/1271 91% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1091/1271 91% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              two use the symbolic form.  The files don't have to be writable by both the owner and group to be matched; either will do.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1090/1271 91% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2008.188, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              All three of these commands do the same thing, but the first one uses the octal representation of the file mode, and  the  other\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1089/1271 91% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1088/1271 91% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2008.220762, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2008.221526, "o", "\u001b[H\u001bM                  \u001b[1m$ find . -perm /u=w,g=w\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1087/1271 91% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                  \u001b[1m$ find . -perm /u+w,g+w\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1086/1271 91% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                  \u001b[1m$ find . -perm /220\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1085/1271 91% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1084/1271 91% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2008.241686, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       •      Search for files which are writable by either their owner or their group.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1083/1271 91% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1082/1271 91% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2008.248994, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                  \u001b[1m$ find . -perm /222\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1081/1271 91% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1080/1271 90% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       •      Search for files which are writable by somebody (their owner, or their group, or anybody else).\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1079/1271 90% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2008.287784, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1078/1271 90% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2008.287949, "o", "\u001b[H\u001bM              This will match a file which has mode \u001b[4m0777\u001b[24m, for example.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1077/1271 90% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1076/1271 90% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                  \u001b[1m$ find . -perm -664\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1075/1271 90% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2008.323997, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1074/1271 90% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              to the presence of any extra permission bits (for example the executable bit).\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1073/1271 89% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2008.43383, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       •      Search  for files which have read and write permission for their owner and group, and which other users can read, without regard\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1072/1271 89% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1071/1271 89% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2008.484065, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              matched.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1070/1271 89% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2008.484459, "o", "\u001b[H\u001bM              Files which meet these criteria but have other permissions bits set (for example if someone can execute the file)  will  not  be\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1069/1271 89% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1068/1271 89% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2008.520861, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                  \u001b[1m$ find . -perm 664\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1067/1271 89% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1066/1271 89% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2008.544553, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              to.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1065/1271 89% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       •      Search  for  files which have read and write permission for their owner, and group, but which other users can read but not write\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1064/1271 89% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1063/1271 89% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2008.544642, "o", "\u001b[H\u001bM                  \u001b[1m$ find /sbin /usr/sbin -executable \\! -readable -print\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1062/1271 89% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2008.586706, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1061/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2008.587346, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       •      Search for files which are executable but not readable.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1060/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM   \u001b[1mSearching files by permissions\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1059/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1058/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2008.587945, "o", "\u001b[H\u001bM              carded.  That means that to match \u001b[1m-mtime 0\u001b[22m, a file will have to have a modification in the past which is less than 24 hours ago.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1057/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2008.620177, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              This command works this way because the time since each file was last modified is divided by 24 hours and any remainder is  dis‐\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1056/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1055/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2008.641872, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                  \u001b[1m$ find $HOME -mtime 0\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1054/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2008.642454, "o", "\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1053/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       •      Search for files in your home directory which have been modified in the last twenty-four hours.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1052/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM   \u001b[1mSearching files by age\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1051/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2008.647649, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1050/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              mand on the next line.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1049/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2008.647764, "o", "\u001b[H\u001bM              This  example uses the line-continuation character '\\' on the first two lines to instruct the shell to continue reading the com‐\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1048/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1047/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2008.670346, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                      \u001b[1m\\( -size +100M -fprintf /root/big.txt '%-10s %p\\n' \\)\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1046/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                      \u001b[1m\\( -perm -4000 -fprintf /root/suid.txt '%#m %u %p\\n' \\) , \\\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1045/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                  \u001b[1m$ find / \\\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1044/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2008.670501, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1043/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              \u001b[4m/root/big.txt\u001b[24m.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1042/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2008.670647, "o", "\u001b[H\u001bM       •      Traverse the filesystem just once,  listing  set-user-ID  files  and  directories  into  \u001b[4m/root/suid.txt\u001b[24m  and  large  files  into\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1041/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2008.671336, "o", "\u001b[H\u001bM   \u001b[1mTraversing the filesystem just once - for 2 different actions\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1040/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1039/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2008.671757, "o", "\u001b[H\u001bM       In many cases, one might prefer the \u001b[1m`-exec ... +` \u001b[22mor better the \u001b[1m`-execdir ... +` \u001b[22msyntax for performance and security reasons.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1038/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1037/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              semicolon is similarly protected by the use of a backslash, though single quotes could have been used in that case also.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1036/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              Notice  that the braces are enclosed in single quote marks to protect them from interpretation as shell script punctuation.  The\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1035/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1034/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                  \u001b[1m$ find . -type f -exec file '{}' \\;\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1033/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1032/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2008.671934, "o", "\u001b[H\u001bM       •      Run \u001b[4mfile\u001b[24m on every file in or below the current directory.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1031/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM   \u001b[1mExecuting a command for each file\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1030/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1029/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2008.686919, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              starting points is one).\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1028/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2008.687067, "o", "\u001b[H\u001bM              \u001b[1m-maxdepth 0 \u001b[22mensures that only explicitly those entries are examined without recursing into directories (in the case one  of  the\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1027/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              The  use  of  \u001b[1m`-files0-from -`  \u001b[22mmeans  to  read  the  names of the starting points from \u001b[4mstandard\u001b[24m \u001b[4minput\u001b[24m, i.e., from the pipe; and\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1026/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2008.687192, "o", "\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1025/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                  \u001b[1m$ proggy | find -files0-from - -maxdepth 0 -type f -empty\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1024/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2008.687294, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1023/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2008.687965, "o", "\u001b[H\u001bM              and find all regular, empty files among them:\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1022/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2008.688331, "o", "\u001b[H\u001bM       •      Given that another program \u001b[4mproggy\u001b[24m pre-filters and creates a huge NUL-separated list of files, process those as starting  points,\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1021/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM   \u001b[1mProcessing arbitrary starting points\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1020/1271 86% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1019/1271 86% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       executed by \u001b[1mxargs \u001b[22mworks with that file.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1018/1271 86% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       Note that there is still a race between the time \u001b[1mfind \u001b[22mtraverses the hierarchy printing the matching filenames, and the time the process\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1017/1271 86% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1016/1271 86% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              The \u001b[1m-name \u001b[22mtest comes before the \u001b[1m-type \u001b[22mtest in order to avoid having to call \u001b[1mstat\u001b[22m(2) on every file.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1015/1271 86% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1014/1271 86% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2008.688635, "o", "\u001b[H\u001bM                  \u001b[1m$ find /tmp -name core -type f -print0 | xargs -0 /bin/rm -f\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1013/1271 86% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1012/1271 86% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              names containing single or double quotes, spaces or newlines are correctly handled.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1011/1271 86% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       •      Find  files named \u001b[4mcore\u001b[24m in or below the directory \u001b[4m/tmp\u001b[24m and delete them, processing filenames in such a way that file or directory\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1010/1271 86% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2008.688786, "o", "\u001b[H\u001bM   \u001b[1mSafer `find -print0 | xargs -0` approach\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1009/1271 86% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2008.703654, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1008/1271 86% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2008.703759, "o", "\u001b[H\u001bM              Note that this will work incorrectly if there are any filenames containing newlines, single or double quotes, or spaces.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1007/1271 86% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1006/1271 86% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2008.703856, "o", "\u001b[H\u001bM                  \u001b[1m$ find /tmp -name core -type f -print | xargs /bin/rm -f\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1005/1271 85% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1004/1271 85% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       •      Find files named \u001b[4mcore\u001b[24m in or below the directory \u001b[4m/tmp\u001b[24m and delete them.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1003/1271 85% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2008.704264, "o", "\u001b[H\u001bM   \u001b[1mSimple `find|xargs` approach\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1002/1271 85% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[1mEXAMPLES\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1001/1271 85% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2008.704363, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1000/1271 85% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       TZ     Affects the time zone used for some of the time-related format directives of \u001b[1m-printf \u001b[22mand \u001b[1m-fprintf\u001b[22m.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 999/1271 85% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 998/1271 85% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2008.719406, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              catalogue, as opposed to according to \u001b[1mfind\u001b[22m's own message translations.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 997/1271 85% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2008.719471, "o", "\u001b[H\u001bM              When \u001b[1mPOSIXLY_CORRECT \u001b[22mis set, the response to the prompt made by the \u001b[1m-ok \u001b[22maction is interpreted according to the system's  message\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 996/1271 85% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 995/1271 85% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              \u001b[1mPOSIXLY_CORRECT \u001b[22mis set, such constructs are treated as an error.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 994/1271 85% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              When  \u001b[1mPOSIXLY_CORRECT  \u001b[22mis  not  set,  \u001b[1m-perm  \u001b[4m\u001b[22m+zzz\u001b[24m  is  treated  just like \u001b[1m-perm \u001b[4m\u001b[22m/zzz\u001b[24m if \u001b[4m+zzz\u001b[24m is not a valid symbolic mode.  When\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 993/1271 85% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2008.719687, "o", "\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 992/1271 85% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              from the output for \u001b[1m-ok\u001b[22m, all messages printed on stderr are diagnostics and must result in a non-zero exit status.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 991/1271 85% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              Setting this variable also turns off warning messages (that is, implies \u001b[1m-nowarn\u001b[22m) by default, because POSIX requires  that  apart\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 990/1271 84% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 989/1271 84% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2008.735824, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              units of 1024 bytes.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 988/1271 84% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              Determines  the  block size used by \u001b[1m-ls \u001b[22mand \u001b[1m-fls\u001b[22m.  If \u001b[1mPOSIXLY_CORRECT \u001b[22mis set, blocks are units of 512 bytes.  Otherwise they are\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 987/1271 84% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       POSIXLY_CORRECT\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 986/1271 84% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 985/1271 84% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2008.735879, "o", "\u001b[H\u001bM       PATH   Affects the directories which are searched to find the executables invoked by \u001b[1m-exec\u001b[22m, \u001b[1m-execdir\u001b[22m, \u001b[1m-ok \u001b[22mand \u001b[1m-okdir\u001b[22m.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 984/1271 84% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 983/1271 84% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2008.735914, "o", "\u001b[H\u001bM              Determines the location of the internationalisation message catalogues.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 982/1271 84% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       NLSPATH\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 981/1271 84% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2008.735946, "o", "\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 980/1271 84% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2008.735978, "o", "\u001b[H\u001bM              determines the interpretation of the response to the prompt made by the \u001b[1m-ok \u001b[22maction.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 979/1271 84% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2008.736021, "o", "\u001b[H\u001bM              Determines the locale to be used for internationalised messages.  If the \u001b[1mPOSIXLY_CORRECT \u001b[22menvironment variable is set, this  also\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 978/1271 84% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       LC_MESSAGES\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 977/1271 84% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2008.736051, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 976/1271 83% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2008.753121, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              fect which characters are considered to be unprintable when filenames are printed; see the section UNUSUAL FILENAMES.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 975/1271 83% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              regular expressions used to interpret the response to the prompt issued by \u001b[1m-ok\u001b[22m.  The \u001b[1mLC_CTYPE \u001b[22menvironment variable will also af‐\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 974/1271 83% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2008.787553, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              tem's  \u001b[1mfnmatch\u001b[22m(3) library function supports this.  This variable also affects the interpretation of any character classes in the\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 973/1271 83% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              This variable affects the treatment of character classes used in regular expressions and also with the \u001b[1m-name \u001b[22mtest, if  the  sys‐\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 972/1271 83% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       LC_CTYPE\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 971/1271 83% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2008.788102, "o", "\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 970/1271 83% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2008.810353, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              \u001b[1m-ok\u001b[22m, the interpretation of any bracket expressions in the pattern will be affected by \u001b[1mLC_COLLATE\u001b[22m.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 969/1271 83% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2008.810433, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              pretation  of  the  response to \u001b[1m-ok\u001b[22m; while the \u001b[1mLC_MESSAGES \u001b[22mvariable selects the actual pattern used to interpret the response to\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 968/1271 83% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2008.835611, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              \u001b[1mfnmatch\u001b[22m(3) library function, and so support for \u001b[1mLC_COLLATE \u001b[22mdepends on the system library.  This variable also affects the inter‐\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 967/1271 83% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              The POSIX standard specifies that this variable affects the pattern matching to be used for the \u001b[1m-name \u001b[22moption.  GNU find uses the\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 966/1271 83% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       LC_COLLATE\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 965/1271 83% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2008.929196, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 964/1271 83% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       LC_ALL If set to a non-empty string value, override the values of all the other internationalization variables.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 963/1271 83% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2009.339486, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 962/1271 83% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       LANG   Provides a default value for the internationalization variables that are unset or null.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 961/1271 83% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2009.365356, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[1mENVIRONMENT VARIABLES\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 960/1271 83% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 959/1271 82% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2009.411243, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       fied in the POSIX standard.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 958/1271 82% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       The \u001b[1mPOSIXLY_CORRECT \u001b[22menvironment variable does not affect the behaviour of the \u001b[1m-regex \u001b[22mor \u001b[1m-iregex \u001b[22mtests because those tests aren't speci‐\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 957/1271 82% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2009.411883, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 956/1271 82% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2009.41208, "o", "\u001b[H\u001bM       The \u001b[1m-d \u001b[22moption is supported for compatibility with various BSD systems, but you should use the POSIX-compliant option \u001b[1m-depth \u001b[22minstead.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 955/1271 82% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 954/1271 82% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2009.45439, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       bolic link, so this diagnostic is frequently not necessary.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 953/1271 82% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2009.454701, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       taining hard links, the leaf optimisation will often mean that \u001b[1mfind \u001b[22mknows that it doesn't need to call \u001b[4mstat()\u001b[24m or \u001b[4mchdir()\u001b[24m  on  the  sym‐\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 952/1271 82% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2009.486182, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       tion or the \u001b[1m-follow \u001b[22moption is in use, a diagnostic message is issued when \u001b[1mfind \u001b[22mencounters a loop of symbolic links.  As with loops con‐\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 951/1271 82% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2009.486259, "o", "\u001b[H\u001bM       message  will  be issued where it is appropriate.  Symbolic links cannot be used to create filesystem cycles as such, but if the \u001b[1m-L \u001b[22mop‐\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 950/1271 81% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2009.524, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       haviour.  If the leaf optimisation has been turned off with \u001b[1m-noleaf\u001b[22m, the directory entry will always be  examined  and  the  diagnostic\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 949/1271 81% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2009.524103, "o", "\u001b[H\u001bM       ting a diagnostic message.  Although this behaviour may be somewhat confusing, it is unlikely that anybody actually depends on this be‐\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 948/1271 81% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2009.524879, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2009.524986, "o", "\u001b[H\u001bM       rectory  which is actually a link to an ancestor.  Since \u001b[1mfind \u001b[22mdoes not actually enter such a subdirectory, it is allowed to avoid emit‐\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 947/1271 81% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       will often be lower than they otherwise should be.  This can mean that GNU find will sometimes optimize away the visiting of  a  subdi‐\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 946/1271 81% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2009.536719, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       GNU  \u001b[1mfind  \u001b[22mcomplies  with  these requirements.  The link count of directories which contain entries which are hard links to an ancestor\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 945/1271 81% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 944/1271 81% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2009.536834, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              recover its position in the hierarchy or terminate.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 943/1271 81% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2009.564635, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              file encountered.  When it detects an infinite loop, \u001b[1mfind \u001b[22mshall write a diagnostic message to standard error  and  shall  either\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 942/1271 81% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              The  \u001b[1mfind  \u001b[22mutility shall detect infinite loops; that is, entering a previously visited directory that is an ancestor of the last\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 941/1271 81% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2009.564698, "o", "\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 940/1271 81% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       The POSIX standard requires that \u001b[1mfind \u001b[22mdetects loops:\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 939/1271 81% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 938/1271 81% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       unique to GNU find, however.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 937/1271 81% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       All other options, predicates, expressions and so forth are extensions beyond the POSIX standard.  Many of  these  extensions  are  not\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 936/1271 81% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 935/1271 80% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2009.564899, "o", "\u001b[H\u001bM       The POSIX standard specifies parentheses `(', `)', negation `!' and the logical AND/OR operators \u001b[1m-a \u001b[22mand \u001b[1m-o\u001b[22m.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 934/1271 80% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 933/1271 80% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              and \u001b[1m-xdev \u001b[22mare all supported.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 932/1271 80% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              The primaries \u001b[1m-atime\u001b[22m, \u001b[1m-ctime\u001b[22m, \u001b[1m-depth\u001b[22m, \u001b[1m-exec\u001b[22m, \u001b[1m-group\u001b[22m, \u001b[1m-links\u001b[22m, \u001b[1m-mtime\u001b[22m, \u001b[1m-nogroup\u001b[22m, \u001b[1m-nouser\u001b[22m, \u001b[1m-ok\u001b[22m, \u001b[1m-path\u001b[22m, \u001b[1m-print\u001b[22m, \u001b[1m-prune\u001b[22m, \u001b[1m-size\u001b[22m, \u001b[1m-user\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 931/1271 80% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       Other primaries\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 930/1271 80% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 929/1271 80% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              in POSIX are supported for backward-compatibility.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 928/1271 80% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2009.565066, "o", "\u001b[H\u001bM       \u001b[1m-perm  \u001b[22mSupported.   If  the \u001b[1mPOSIXLY_CORRECT \u001b[22menvironment variable is not set, some mode arguments (for example +a+x) which are not valid\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 927/1271 79% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 926/1271 79% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2009.587058, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              which used to take the relevant time from the symbolic link; see the HISTORY section below.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 925/1271 79% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       \u001b[1m-newer \u001b[22mSupported.  If the file specified is a symbolic link, it is always dereferenced.  This is  a  change  from  previous  behaviour,\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 924/1271 79% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2009.587208, "o", "\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 923/1271 79% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              When \u001b[1mPOSIXLY_CORRECT \u001b[22mis not set, the patterns are instead taken from \u001b[1mfind\u001b[22m's own message catalogue.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 922/1271 79% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2009.587372, "o", "\u001b[H\u001bM              tive  (yes)  or  negative  (no)  response.  See the system's documentation for \u001b[1mnl_langinfo\u001b[22m(3), in particular YESEXPR and NOEXPR.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 921/1271 79% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2009.587988, "o", "\u001b[H\u001bM              ronment variable.  When the \u001b[1mPOSIXLY_CORRECT \u001b[22menvironment variable is set, these patterns are taken system's definition of a posi‐\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 920/1271 79% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       \u001b[1m-ok    \u001b[22mSupported.  Interpretation of the response is according to the `yes' and `no' patterns selected by setting the \u001b[1mLC_MESSAGES \u001b[22menvi‐\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 919/1271 79% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2009.588307, "o", "\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 918/1271 79% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              provides these.  Furthermore, GNU find allows multiple types to be specified at once in a comma-separated list.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 917/1271 79% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       \u001b[1m-type  \u001b[22mSupported.  POSIX specifies `b', `c', `d', `l', `p', `f' and `s'.  GNU find also supports `D', representing a Door, where the OS\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 916/1271 79% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 915/1271 79% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              126 requires this.  This is a change from previous versions of findutils.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 914/1271 79% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              As of findutils-4.2.2, shell metacharacters (`*', `?' or `[]' for example) match a leading `.', because IEEE PASC interpretation\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 913/1271 79% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2009.604213, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       \u001b[1m-name  \u001b[22mThis option is supported, but POSIX conformance depends on the POSIX conformance of the system's  \u001b[1mfnmatch\u001b[22m(3)  library  function.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 912/1271 78% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 911/1271 78% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       \u001b[1m-L     \u001b[22mThis option is supported.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 910/1271 78% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 909/1271 78% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2009.604424, "o", "\u001b[H\u001bM       \u001b[1m-H     \u001b[22mThis option is supported.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 908/1271 78% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 907/1271 78% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       ified in the POSIX standard (IEEE Std 1003.1-2008, 2016 Edition):\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 906/1271 77% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2009.619906, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       For closest compliance to the POSIX standard, you should set the \u001b[1mPOSIXLY_CORRECT \u001b[22menvironment variable.  The following options are spec‐\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 905/1271 77% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[1mSTANDARDS CONFORMANCE\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 904/1271 77% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 903/1271 77% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       The \u001b[1m-ok \u001b[22mand \u001b[1m-okdir \u001b[22mactions print the current filename as-is.  This may change in a future release.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 902/1271 77% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2009.653957, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 901/1271 77% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              matched files might have arbitrary names, you should consider using \u001b[1m-print0 \u001b[22minstead of \u001b[1m-print\u001b[22m.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 900/1271 77% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2009.679396, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              Quoting  is  handled in the same way as for \u001b[1m-printf \u001b[22mand \u001b[1m-fprintf\u001b[22m.  If you are using \u001b[1mfind \u001b[22min a script or in a situation where the\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 899/1271 77% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2009.679479, "o", "\u001b[H\u001bM       -print, -fprint\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 898/1271 77% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 897/1271 77% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              \u001b[1mLC_CTYPE \u001b[22menvironment variable is used to determine which characters need to be quoted.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 896/1271 77% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2009.679767, "o", "\u001b[H\u001bM              use `\\0' as a terminator than to use newline, as file names can contain white space and newline characters.  The setting of  the\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 895/1271 77% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2009.696852, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              one  used  for  \u001b[1m-ls \u001b[22mand \u001b[1m-fls\u001b[22m.  If you are able to decide what format to use for the output of \u001b[1mfind \u001b[22mthen it is normally better to\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 894/1271 76% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2009.697296, "o", "\u001b[H\u001bM              %p and %P are quoted.  This quoting is performed in the same way as for GNU \u001b[1mls\u001b[22m.  This is not the same quoting mechanism  as  the\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 893/1271 76% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2009.704817, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              ers but which cannot be used to send arbitrary data to the terminal, and so these are printed as-is.  The directives %f, %h, %l,\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 892/1271 76% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              is.  The directives %a, %b, %c, %d, %i, %k, %m, %M, %n, %s, %t, %u and %U have values which are under the control of files' own‐\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 891/1271 76% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2009.738287, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              directives  %D, %F, %g, %G, %H, %Y, and %y expand to values which are not under control of files' owners, and so are printed as-\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 890/1271 76% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              If the output is not going to a terminal, it is printed as-is.  Otherwise, the result depends on which directive is in use.  The\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 889/1271 76% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2009.891662, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       -printf, -fprintf\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 888/1271 76% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 887/1271 76% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              \u001b[1m-fls \u001b[22mthese are the characters between octal 041 and 0176) are printed as-is.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 886/1271 76% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2009.89994, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              (for example `\\f', `\\\"').  Other unusual characters are printed using an octal escape.  Other printable characters (for \u001b[1m-ls  \u001b[22mand\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 885/1271 76% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              Unusual  characters  are always escaped.  White space, backslash, and double quote characters are printed using C-style escaping\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 884/1271 75% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.07909, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2010.079275, "o", "\u001b[H\u001bM       -ls, -fls\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 883/1271 75% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 882/1271 75% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.104368, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              Always print the exact filename, unchanged, even if the output is going to a terminal.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 881/1271 75% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       -print0, -fprint0\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 880/1271 75% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2010.104902, "o", "\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 879/1271 75% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       function keys on some terminals).  Unusual characters are handled differently by various actions, as described below.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 878/1271 75% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.128349, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       characters in file names can do unexpected and often undesirable things to your terminal (for example, changing the  settings  of  your\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 877/1271 75% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       modification times and so forth.  File names are a potential problem since they can contain any character except `\\0' and `/'.  Unusual\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 876/1271 75% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       Many of the actions of \u001b[1mfind \u001b[22mresult in the printing of data which is under the control of other users.  This includes file names, sizes,\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 875/1271 75% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2010.128607, "o", "\u001b[H\u001bM\u001b[1mUNUSUAL FILENAMES\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 874/1271 74% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 873/1271 74% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.153153, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       itly has higher precedence than \u001b[1m-o\u001b[22m.  This means that \u001b[1mfind . -name afile -o -name bfile -print \u001b[22mwill never print \u001b[4mafile\u001b[24m.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 872/1271 74% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2010.153265, "o", "\u001b[H\u001bM       Please note that \u001b[1m-a \u001b[22mwhen specified implicitly (for example by two tests appearing without an explicit operator between them) or explic‐\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 871/1271 74% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 870/1271 74% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              only once.  The \u001b[1m-fprintf \u001b[22maction can be used to list the various matched items into several different output files.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 869/1271 74% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.170687, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              The  comma  operator  can  be useful for searching for several different types of thing, but traversing the filesystem hierarchy\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 868/1271 74% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2010.170892, "o", "\u001b[H\u001bM              List; both \u001b[4mexpr1\u001b[24m and \u001b[4mexpr2\u001b[24m are always evaluated.  The value of \u001b[4mexpr1\u001b[24m is discarded; the value of the list is the value of  \u001b[4mexpr2\u001b[24m.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 867/1271 74% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.203831, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       \u001b[4mexpr1\u001b[24m , \u001b[4mexpr2\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 866/1271 74% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.204278, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 865/1271 74% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              Same as \u001b[4mexpr1\u001b[24m \u001b[1m-o \u001b[4m\u001b[22mexpr2\u001b[24m, but not POSIX compliant.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 864/1271 74% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       \u001b[4mexpr1\u001b[24m -or \u001b[4mexpr2\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 863/1271 74% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.204414, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 862/1271 74% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.220379, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              Or; \u001b[4mexpr2\u001b[24m is not evaluated if \u001b[4mexpr1\u001b[24m is true.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 861/1271 74% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       \u001b[4mexpr1\u001b[24m -o \u001b[4mexpr2\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 860/1271 73% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2010.220542, "o", "\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 859/1271 73% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              Same as \u001b[4mexpr1\u001b[24m \u001b[4mexpr2\u001b[24m, but not POSIX compliant.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 858/1271 73% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2010.220641, "o", "\u001b[H\u001bM       \u001b[4mexpr1\u001b[24m -and \u001b[4mexpr2\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 857/1271 73% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 856/1271 73% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.236804, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              Same as \u001b[4mexpr1\u001b[24m \u001b[4mexpr2\u001b[24m.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 855/1271 73% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2010.237229, "o", "\u001b[H\u001bM       \u001b[4mexpr1\u001b[24m -a \u001b[4mexpr2\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 854/1271 73% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 853/1271 73% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              Two expressions in a row are taken to be joined with an implied \u001b[1m-a\u001b[22m; \u001b[4mexpr2\u001b[24m is not evaluated if \u001b[4mexpr1\u001b[24m is false.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 852/1271 72% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.237383, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       \u001b[4mexpr1\u001b[24m \u001b[4mexpr2\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 851/1271 72% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 850/1271 72% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              Same as ! \u001b[4mexpr\u001b[24m, but not POSIX compliant.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 849/1271 72% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       -not \u001b[4mexpr\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 848/1271 72% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 847/1271 72% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       ! \u001b[4mexpr\u001b[24m True if \u001b[4mexpr\u001b[24m is false.  This character will also usually need protection from interpretation by the shell.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 846/1271 72% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 845/1271 72% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.254486, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              this manual page use backslashes for this purpose: `\\(...\\)' instead of `(...)'.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 844/1271 72% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              Force  precedence.   Since  parentheses are special to the shell, you will normally need to quote them.  Many of the examples in\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 843/1271 72% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       ( \u001b[4mexpr\u001b[24m )\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 842/1271 72% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.255065, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 841/1271 71% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       Listed in order of decreasing precedence:\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 840/1271 71% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM   \u001b[1mOPERATORS\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 839/1271 71% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2010.255402, "o", "\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 838/1271 71% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                  find / -name needle -print -quit\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 837/1271 71% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              just a single file we can do this:\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 836/1271 71% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              One common use of \u001b[1m-quit \u001b[22mis to stop searching the file system once we have found what we want.  For example, if we want  to  find\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 835/1271 71% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              will print only `/tmp/foo`.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 834/1271 71% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2010.255581, "o", "\u001b[H\u001bM              is  executed, no more files specified on the command line will be processed.  For example, `\u001b[1mfind \u001b[4m\u001b[22m/tmp/foo\u001b[24m \u001b[4m/tmp/bar\u001b[24m \u001b[1m-print -quit\u001b[22m`\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 833/1271 71% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              Any command lines which have been built by \u001b[1m-exec ... + \u001b[22mor \u001b[1m-execdir ... + \u001b[22mare invoked before the program is exited.  After  \u001b[1m-quit\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 832/1271 71% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.2708, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              to the contents of pruned directories, while \u001b[1m-quit \u001b[22msimply makes \u001b[1mfind \u001b[22mstop immediately.  No child processes will be left running.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 831/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       -quit  Exit  immediately  (with return value zero if no errors have occurred).  This is different to \u001b[1m-prune \u001b[22mbecause \u001b[1m-prune \u001b[22monly applies\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 830/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 829/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2010.270983, "o", "\u001b[H\u001bM                  find . -path ./src/emacs -prune -o -print\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 828/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              and directories under it, and print the names of the other files found, do something like this:\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 827/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2010.271121, "o", "\u001b[H\u001bM              plies \u001b[1m-depth\u001b[22m, you cannot usefully use \u001b[1m-prune \u001b[22mand \u001b[1m-delete \u001b[22mtogether.  For example, to skip the directory \u001b[4msrc/emacs\u001b[24m and  all  files\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 826/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2010.271795, "o", "\u001b[H\u001bM       -prune True;  if  the file is a directory, do not descend into it.  If \u001b[1m-depth \u001b[22mis given, then \u001b[1m-prune \u001b[22mhas no effect.  Because \u001b[1m-delete \u001b[22mim‐\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 825/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 824/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              See the \u001b[1mUNUSUAL FILENAMES \u001b[22msection for information about how unusual characters in filenames are handled.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 823/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 822/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              ment of a field from right-justified (which is the default) to left-justified.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 821/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              rectives that do not support these flags include \u001b[1mG\u001b[22m, \u001b[1mU\u001b[22m, \u001b[1mb\u001b[22m, \u001b[1mD\u001b[22m, \u001b[1mk \u001b[22mand \u001b[1mn\u001b[22m.  The `-' format flag is supported and changes  the  align‐\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 820/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              The %m and %d directives support the \u001b[1m#\u001b[22m, \u001b[1m0 \u001b[22mand \u001b[1m+ \u001b[22mflags, but the other directives do not, even if they print numbers.  Numeric di‐\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 819/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2010.271964, "o", "\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 818/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.287825, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              are reading.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 817/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              lowing  character.  In some locales, it may hide your door keys, while in others it may remove the final page from the novel you\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 816/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2010.287984, "o", "\u001b[H\u001bM              format characters may be introduced).  A `%' at the end of the format argument causes undefined behaviour since there is no fol‐\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 815/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              A `%' character followed by any other character is discarded, but the other character is printed (don't rely on this, as further\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 814/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 813/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                     Reserved for future use.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 812/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2010.288095, "o", "\u001b[H\u001bM              %{ %[ %(\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 811/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 810/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.288206, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %Z     (SELinux only) file's security context.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 809/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 808/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.288313, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                     the type of the target of a symbolic link.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 807/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K"]
