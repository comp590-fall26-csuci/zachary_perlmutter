[2010.2885, "o", "\u001b[H\u001bM              %Y     File's type (like %y), plus follow symbolic links: `L'=loop, `N'=nonexistent, `?' for any other  error  when  determining\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 806/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 805/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2010.289034, "o", "\u001b[H\u001bM              %y     File's type (like in \u001b[1mls -l\u001b[22m), U=unknown type (shouldn't happen)\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 804/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 803/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2010.289837, "o", "\u001b[H\u001bM              %U     File's numeric user ID.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 802/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 801/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %u     File's user name, or numeric user ID if the user has no name.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 800/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 799/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %T\u001b[4mk\u001b[24m    File's last modification time in the format specified by \u001b[4mk\u001b[24m, which is the same as for %A.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 798/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 797/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %t     File's last modification time in the format returned by the C \u001b[1mctime\u001b[22m(3) function.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 796/1271 68% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.304062, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 795/1271 68% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                     1.0.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 794/1271 68% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                     zero,  the value printed is undefined.  On systems which lack support for st_blocks, a file's sparseness is assumed to be\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 793/1271 68% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2010.304244, "o", "\u001b[H\u001bM                     file system dependent.  The value used for BLOCKSIZE is system-dependent, but is usually 512 bytes.  If the file size  is\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 792/1271 68% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                     which  use indirect blocks may have a value which is greater than 1.0.  In general the number of blocks used by a file is\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 791/1271 68% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                     file of a certain length is system-dependent.  However, normally sparse files will have values less than 1.0,  and  files\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 790/1271 68% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2010.304382, "o", "\u001b[H\u001bM              %S     File's  sparseness.  This is calculated as (BLOCKSIZE*st_blocks / st_size).  The exact value you will get for an ordinary\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 789/1271 68% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 788/1271 67% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.32094, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %s     File's size in bytes.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 787/1271 67% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 786/1271 67% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %P     File's name with the name of the starting-point under which it was found removed.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 785/1271 67% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.321126, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 784/1271 67% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %p     File's name.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 783/1271 67% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 782/1271 67% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2010.321231, "o", "\u001b[H\u001bM              %n     Number of hard links to file.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 781/1271 67% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 780/1271 67% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2010.321786, "o", "\u001b[H\u001bM              %M     File's permissions (in symbolic form, as for \u001b[1mls\u001b[22m).  This directive is supported in findutils 4.2.5 and later.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 779/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.336132, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 778/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2010.336381, "o", "\u001b[H\u001bM                     and to do this, you should use the \u001b[1m# \u001b[22mflag (as in, for example, `%#m').\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 777/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                     the actual value of the file's mode and the output of %m.  Normally you will want to have a leading zero on this  number,\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 776/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                     if  your  particular implementation uses an unusual ordering of octal permissions bits, you will see a difference between\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 775/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %m     File's permission bits (in octal).  This option uses the `traditional' numbers which most Unix implementations  use,  but\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 774/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.336522, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 773/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %l     Object of symbolic link (empty string if file is not a symbolic link).\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 772/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 771/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                     block size this is usually greater than %s/1024, but it can also be smaller if the file is a sparse file.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 770/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %k     The amount of disk space used for this file in 1 KB blocks.  Since disk space is allocated in multiples of the filesystem\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 769/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 768/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.373993, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %i     File's inode number (in decimal).\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 767/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 766/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %H     Starting-point under which file was found.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 765/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 764/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.403957, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                     contain a slash (including \u001b[1m/\u001b[22m), %h expands to the empty string.  See the \u001b[1mEXAMPLES \u001b[22msection for an example.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 763/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                     (since  it  is in the current directory) the %h specifier expands to `.'.  For files which are themselves directories and\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 762/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2010.404152, "o", "\u001b[H\u001bM              %h     Dirname; the Leading directories of the file's name (all but the last element).  If the file  name  contains  no  slashes\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 761/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 760/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %G     File's numeric group ID.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 759/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.775599, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 760/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.798812, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              %u     File's user name, or numeric user ID if the user has no name.\u001b[m\r\n\u001b[7m Manual page find(1) line 761/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 762/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.799362, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              %U     File's numeric user ID.\u001b[m\r\n\u001b[7m Manual page find(1) line 763/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.804588, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 764/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2010.804677, "o", "              %y     File's type (like in \u001b[1mls -l\u001b[22m), U=unknown type (shouldn't happen)\u001b[m\r\n\u001b[7m Manual page find(1) line 765/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.820957, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 766/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.821432, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              %Y     File's type (like %y), plus follow symbolic links: `L'=loop, `N'=nonexistent, `?' for any other  error  when  determining\u001b[m\r\n\u001b[7m Manual page find(1) line 767/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.853917, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2010.854012, "o", "                     the type of the target of a symbolic link.\u001b[m\r\n\u001b[7m Manual page find(1) line 768/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2010.854091, "o", "\u001b[m\r\n\u001b[7m Manual page find(1) line 769/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              %Z     (SELinux only) file's security context.\u001b[m\r\n\u001b[7m Manual page find(1) line 770/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 771/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.876929, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              %{ %[ %(\u001b[m\r\n\u001b[7m Manual page find(1) line 772/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                     Reserved for future use.\u001b[m\r\n\u001b[7m Manual page find(1) line 773/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.877017, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 774/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2010.920399, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              A `%' character followed by any other character is discarded, but the other character is printed (don't rely on this, as further\u001b[m\r\n\u001b[7m Manual page find(1) line 775/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2010.920564, "o", "              format characters may be introduced).  A `%' at the end of the format argument causes undefined behaviour since there is no fol‐\u001b[m\r\n\u001b[7m Manual page find(1) line 776/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2011.141985, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              lowing  character.  In some locales, it may hide your door keys, while in others it may remove the final page from the novel you\u001b[m\r\n\u001b[7m Manual page find(1) line 777/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2011.14214, "o", "              are reading.\u001b[m\r\n\u001b[7m Manual page find(1) line 778/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2011.170915, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 779/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              The %m and %d directives support the \u001b[1m#\u001b[22m, \u001b[1m0 \u001b[22mand \u001b[1m+ \u001b[22mflags, but the other directives do not, even if they print numbers.  Numeric di‐\u001b[m\r\n\u001b[7m Manual page find(1) line 780/1271 67% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2011.184435, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              rectives that do not support these flags include \u001b[1mG\u001b[22m, \u001b[1mU\u001b[22m, \u001b[1mb\u001b[22m, \u001b[1mD\u001b[22m, \u001b[1mk \u001b[22mand \u001b[1mn\u001b[22m.  The `-' format flag is supported and changes  the  align‐\u001b[m\r\n\u001b[7m Manual page find(1) line 781/1271 67% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              ment of a field from right-justified (which is the default) to left-justified.\u001b[m\r\n\u001b[7m Manual page find(1) line 782/1271 67% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2011.220313, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 783/1271 67% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              See the \u001b[1mUNUSUAL FILENAMES \u001b[22msection for information about how unusual characters in filenames are handled.\u001b[m\r\n\u001b[7m Manual page find(1) line 784/1271 67% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2011.220446, "o", "\u001b[m\r\n\u001b[7m Manual page find(1) line 785/1271 67% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       -prune True;  if  the file is a directory, do not descend into it.  If \u001b[1m-depth \u001b[22mis given, then \u001b[1m-prune \u001b[22mhas no effect.  Because \u001b[1m-delete \u001b[22mim‐\u001b[m\r\n\u001b[7m Manual page find(1) line 786/1271 67% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2011.220599, "o", "              plies \u001b[1m-depth\u001b[22m, you cannot usefully use \u001b[1m-prune \u001b[22mand \u001b[1m-delete \u001b[22mtogether.  For example, to skip the directory \u001b[4msrc/emacs\u001b[24m and  all  files\u001b[m\r\n\u001b[7m Manual page find(1) line 787/1271 67% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              and directories under it, and print the names of the other files found, do something like this:\u001b[m\r\n\u001b[7m Manual page find(1) line 788/1271 67% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                  find . -path ./src/emacs -prune -o -print\u001b[m\r\n\u001b[7m Manual page find(1) line 789/1271 68% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 790/1271 68% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2011.220684, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2011.221242, "o", "       -quit  Exit  immediately  (with return value zero if no errors have occurred).  This is different to \u001b[1m-prune \u001b[22mbecause \u001b[1m-prune \u001b[22monly applies\u001b[m\r\n\u001b[7m Manual page find(1) line 791/1271 68% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2011.239395, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              to the contents of pruned directories, while \u001b[1m-quit \u001b[22msimply makes \u001b[1mfind \u001b[22mstop immediately.  No child processes will be left running.\u001b[m\r\n\u001b[7m Manual page find(1) line 792/1271 68% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2011.239858, "o", "              Any command lines which have been built by \u001b[1m-exec ... + \u001b[22mor \u001b[1m-execdir ... + \u001b[22mare invoked before the program is exited.  After  \u001b[1m-quit\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 793/1271 68% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              is  executed, no more files specified on the command line will be processed.  For example, `\u001b[1mfind \u001b[4m\u001b[22m/tmp/foo\u001b[24m \u001b[4m/tmp/bar\u001b[24m \u001b[1m-print -quit\u001b[22m`\u001b[m\r\n\u001b[7m Manual page find(1) line 794/1271 68% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2011.240026, "o", "              will print only `/tmp/foo`.\u001b[m\r\n\u001b[7m Manual page find(1) line 795/1271 68% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2011.247039, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              One common use of \u001b[1m-quit \u001b[22mis to stop searching the file system once we have found what we want.  For example, if we want  to  find\u001b[m\r\n\u001b[7m Manual page find(1) line 796/1271 68% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2011.247108, "o", "              just a single file we can do this:\u001b[m\r\n\u001b[7m Manual page find(1) line 797/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                  find / -name needle -print -quit\u001b[m\r\n\u001b[7m Manual page find(1) line 798/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2011.271406, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 799/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K   \u001b[1mOPERATORS\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 800/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2011.271539, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       Listed in order of decreasing precedence:\u001b[m\r\n\u001b[7m Manual page find(1) line 801/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 802/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2011.287354, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       ( \u001b[4mexpr\u001b[24m )\u001b[m\r\n\u001b[7m Manual page find(1) line 803/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              Force  precedence.   Since  parentheses are special to the shell, you will normally need to quote them.  Many of the examples in\u001b[m\r\n\u001b[7m Manual page find(1) line 804/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2011.303643, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              this manual page use backslashes for this purpose: `\\(...\\)' instead of `(...)'.\u001b[m\r\n\u001b[7m Manual page find(1) line 805/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2011.304102, "o", "\u001b[m\r\n\u001b[7m Manual page find(1) line 806/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       ! \u001b[4mexpr\u001b[24m True if \u001b[4mexpr\u001b[24m is false.  This character will also usually need protection from interpretation by the shell.\u001b[m\r\n\u001b[7m Manual page find(1) line 807/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 808/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2011.304387, "o", "       -not \u001b[4mexpr\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 809/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2011.320591, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              Same as ! \u001b[4mexpr\u001b[24m, but not POSIX compliant.\u001b[m\r\n\u001b[7m Manual page find(1) line 810/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 811/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2011.337506, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       \u001b[4mexpr1\u001b[24m \u001b[4mexpr2\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 812/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              Two expressions in a row are taken to be joined with an implied \u001b[1m-a\u001b[22m; \u001b[4mexpr2\u001b[24m is not evaluated if \u001b[4mexpr1\u001b[24m is false.\u001b[m\r\n\u001b[7m Manual page find(1) line 813/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2011.337632, "o", "\u001b[m\r\n\u001b[7m Manual page find(1) line 814/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       \u001b[4mexpr1\u001b[24m -a \u001b[4mexpr2\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 815/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2011.353554, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              Same as \u001b[4mexpr1\u001b[24m \u001b[4mexpr2\u001b[24m.\u001b[m\r\n\u001b[7m Manual page find(1) line 816/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 817/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       \u001b[4mexpr1\u001b[24m -and \u001b[4mexpr2\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 818/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2011.353657, "o", "              Same as \u001b[4mexpr1\u001b[24m \u001b[4mexpr2\u001b[24m, but not POSIX compliant.\u001b[m\r\n\u001b[7m Manual page find(1) line 819/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2011.387801, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 820/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       \u001b[4mexpr1\u001b[24m -o \u001b[4mexpr2\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 821/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              Or; \u001b[4mexpr2\u001b[24m is not evaluated if \u001b[4mexpr1\u001b[24m is true.\u001b[m\r\n\u001b[7m Manual page find(1) line 822/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2011.387907, "o", "\u001b[m\r\n\u001b[7m Manual page find(1) line 823/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       \u001b[4mexpr1\u001b[24m -or \u001b[4mexpr2\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 824/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2011.427857, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              Same as \u001b[4mexpr1\u001b[24m \u001b[1m-o \u001b[4m\u001b[22mexpr2\u001b[24m, but not POSIX compliant.\u001b[m\r\n\u001b[7m Manual page find(1) line 825/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 826/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       \u001b[4mexpr1\u001b[24m , \u001b[4mexpr2\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 827/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              List; both \u001b[4mexpr1\u001b[24m and \u001b[4mexpr2\u001b[24m are always evaluated.  The value of \u001b[4mexpr1\u001b[24m is discarded; the value of the list is the value of  \u001b[4mexpr2\u001b[24m.\u001b[m\r\n\u001b[7m Manual page find(1) line 828/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2011.465003, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              The  comma  operator  can  be useful for searching for several different types of thing, but traversing the filesystem hierarchy\u001b[m\r\n\u001b[7m Manual page find(1) line 829/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              only once.  The \u001b[1m-fprintf \u001b[22maction can be used to list the various matched items into several different output files.\u001b[m\r\n\u001b[7m Manual page find(1) line 830/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2011.488528, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 831/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       Please note that \u001b[1m-a \u001b[22mwhen specified implicitly (for example by two tests appearing without an explicit operator between them) or explic‐\u001b[m\r\n\u001b[7m Manual page find(1) line 832/1271 71% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       itly has higher precedence than \u001b[1m-o\u001b[22m.  This means that \u001b[1mfind . -name afile -o -name bfile -print \u001b[22mwill never print \u001b[4mafile\u001b[24m.\u001b[m\r\n\u001b[7m Manual page find(1) line 833/1271 71% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2011.513066, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2011.513244, "o", "\u001b[m\r\n\u001b[7m Manual page find(1) line 834/1271 71% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2011.513332, "o", "\u001b[1mUNUSUAL FILENAMES\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 835/1271 71% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2011.903171, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              will print only `/tmp/foo`.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 834/1271 71% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2011.938633, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              is  executed, no more files specified on the command line will be processed.  For example, `\u001b[1mfind \u001b[4m\u001b[22m/tmp/foo\u001b[24m \u001b[4m/tmp/bar\u001b[24m \u001b[1m-print -quit\u001b[22m`\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 833/1271 71% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              Any command lines which have been built by \u001b[1m-exec ... + \u001b[22mor \u001b[1m-execdir ... + \u001b[22mare invoked before the program is exited.  After  \u001b[1m-quit\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 832/1271 71% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2011.938761, "o", "\u001b[H\u001bM              to the contents of pruned directories, while \u001b[1m-quit \u001b[22msimply makes \u001b[1mfind \u001b[22mstop immediately.  No child processes will be left running.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 831/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2011.966768, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2011.96728, "o", "\u001b[H\u001bM       -quit  Exit  immediately  (with return value zero if no errors have occurred).  This is different to \u001b[1m-prune \u001b[22mbecause \u001b[1m-prune \u001b[22monly applies\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 830/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 829/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2012.003379, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                  find . -path ./src/emacs -prune -o -print\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 828/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              and directories under it, and print the names of the other files found, do something like this:\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 827/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2012.03772, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              plies \u001b[1m-depth\u001b[22m, you cannot usefully use \u001b[1m-prune \u001b[22mand \u001b[1m-delete \u001b[22mtogether.  For example, to skip the directory \u001b[4msrc/emacs\u001b[24m and  all  files\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 826/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2012.037889, "o", "\u001b[H\u001bM       -prune True;  if  the file is a directory, do not descend into it.  If \u001b[1m-depth \u001b[22mis given, then \u001b[1m-prune \u001b[22mhas no effect.  Because \u001b[1m-delete \u001b[22mim‐\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 825/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2012.089793, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 824/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              See the \u001b[1mUNUSUAL FILENAMES \u001b[22msection for information about how unusual characters in filenames are handled.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 823/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2012.097627, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 822/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              ment of a field from right-justified (which is the default) to left-justified.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 821/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              rectives that do not support these flags include \u001b[1mG\u001b[22m, \u001b[1mU\u001b[22m, \u001b[1mb\u001b[22m, \u001b[1mD\u001b[22m, \u001b[1mk \u001b[22mand \u001b[1mn\u001b[22m.  The `-' format flag is supported and changes  the  align‐\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 820/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2012.140546, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              The %m and %d directives support the \u001b[1m#\u001b[22m, \u001b[1m0 \u001b[22mand \u001b[1m+ \u001b[22mflags, but the other directives do not, even if they print numbers.  Numeric di‐\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 819/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 818/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2012.170681, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              are reading.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 817/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              lowing  character.  In some locales, it may hide your door keys, while in others it may remove the final page from the novel you\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 816/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2012.197212, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              format characters may be introduced).  A `%' at the end of the format argument causes undefined behaviour since there is no fol‐\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 815/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2012.197383, "o", "\u001b[H\u001bM              A `%' character followed by any other character is discarded, but the other character is printed (don't rely on this, as further\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 814/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2012.236907, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 813/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                     Reserved for future use.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 812/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2012.261839, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %{ %[ %(\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 811/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 810/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2012.287581, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %Z     (SELinux only) file's security context.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 809/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 808/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                     the type of the target of a symbolic link.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 807/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2012.305352, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %Y     File's type (like %y), plus follow symbolic links: `L'=loop, `N'=nonexistent, `?' for any other  error  when  determining\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 806/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 805/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2012.337537, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %y     File's type (like in \u001b[1mls -l\u001b[22m), U=unknown type (shouldn't happen)\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 804/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 803/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2013.598547, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %U     File's numeric user ID.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 802/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 801/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %u     File's user name, or numeric user ID if the user has no name.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 800/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 799/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2013.599191, "o", "\u001b[H\u001bM              %T\u001b[4mk\u001b[24m    File's last modification time in the format specified by \u001b[4mk\u001b[24m, which is the same as for %A.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 798/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 797/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %t     File's last modification time in the format returned by the C \u001b[1mctime\u001b[22m(3) function.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 796/1271 68% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 795/1271 68% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2013.599683, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                     1.0.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 794/1271 68% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                     zero,  the value printed is undefined.  On systems which lack support for st_blocks, a file's sparseness is assumed to be\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 793/1271 68% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                     file system dependent.  The value used for BLOCKSIZE is system-dependent, but is usually 512 bytes.  If the file size  is\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 792/1271 68% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                     which  use indirect blocks may have a value which is greater than 1.0.  In general the number of blocks used by a file is\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 791/1271 68% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                     file of a certain length is system-dependent.  However, normally sparse files will have values less than 1.0,  and  files\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 790/1271 68% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %S     File's  sparseness.  This is calculated as (BLOCKSIZE*st_blocks / st_size).  The exact value you will get for an ordinary\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 789/1271 68% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 788/1271 67% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %s     File's size in bytes.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 787/1271 67% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 786/1271 67% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2013.599901, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %P     File's name with the name of the starting-point under which it was found removed.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 785/1271 67% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 784/1271 67% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %p     File's name.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 783/1271 67% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 782/1271 67% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %n     Number of hard links to file.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 781/1271 67% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2013.599992, "o", "\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 780/1271 67% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %M     File's permissions (in symbolic form, as for \u001b[1mls\u001b[22m).  This directive is supported in findutils 4.2.5 and later.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 779/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2013.607807, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 778/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                     and to do this, you should use the \u001b[1m# \u001b[22mflag (as in, for example, `%#m').\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 777/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2013.60789, "o", "\u001b[H\u001bM                     the actual value of the file's mode and the output of %m.  Normally you will want to have a leading zero on this  number,\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 776/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                     if  your  particular implementation uses an unusual ordering of octal permissions bits, you will see a difference between\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 775/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %m     File's permission bits (in octal).  This option uses the `traditional' numbers which most Unix implementations  use,  but\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 774/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2013.608107, "o", "\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 773/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %l     Object of symbolic link (empty string if file is not a symbolic link).\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 772/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 771/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                     block size this is usually greater than %s/1024, but it can also be smaller if the file is a sparse file.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 770/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %k     The amount of disk space used for this file in 1 KB blocks.  Since disk space is allocated in multiples of the filesystem\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 769/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2013.608179, "o", "\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 768/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %i     File's inode number (in decimal).\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 767/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 766/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2013.60841, "o", "\u001b[H\u001bM              %H     Starting-point under which file was found.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 765/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 764/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                     contain a slash (including \u001b[1m/\u001b[22m), %h expands to the empty string.  See the \u001b[1mEXAMPLES \u001b[22msection for an example.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 763/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                     (since  it  is in the current directory) the %h specifier expands to `.'.  For files which are themselves directories and\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 762/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %h     Dirname; the Leading directories of the file's name (all but the last element).  If the file  name  contains  no  slashes\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 761/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2013.608468, "o", "\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 760/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %G     File's numeric group ID.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 759/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2013.63697, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 758/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2013.637385, "o", "\u001b[H\u001bM              %g     File's group name, or numeric group ID if the group has no name.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 757/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 756/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %F     Type of the filesystem the file is on; this value can be used for -fstype.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 755/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2013.63753, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 754/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                     `/'.  See the \u001b[1mEXAMPLES \u001b[22msection for an example.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 753/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %f     Print  the  basename; the file's name with any leading directories removed (only the last element).  For \u001b[1m/\u001b[22m, the result is\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 752/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 751/1271 64% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %D     The device number on which the file exists (the st_dev field of struct stat), in decimal.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 750/1271 64% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 749/1271 64% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2013.637621, "o", "\u001b[H\u001bM              %d     File's depth in the directory tree; 0 means the file is a starting-point.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 748/1271 64% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 747/1271 64% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2013.637869, "o", "\u001b[H\u001bM              %C\u001b[4mk\u001b[24m    File's last status change time in the format specified by \u001b[4mk\u001b[24m, which is the same as for %A.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 746/1271 64% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 745/1271 64% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              %c     File's last status change time in the format returned by the C \u001b[1mctime\u001b[22m(3) function.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 744/1271 64% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2013.637974, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 743/1271 64% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                     produces an empty string if the underlying operating system or filesystem does not support birth times.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 742/1271 64% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2013.638088, "o", "\u001b[H\u001bM              %B\u001b[4mk\u001b[24m    File's birth time, i.e., its creation time, in the format specified by \u001b[4mk\u001b[24m, which is the same as for  %A.   This  directive\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 741/1271 64% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 740/1271 64% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2013.638201, "o", "\u001b[H\u001bM                     filesystem block size this is usually greater than %s/512, but it can also be smaller if the file is a sparse file.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 739/1271 64% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2013.638289, "o", "\u001b[H\u001bM              %b     The  amount  of  disk  space  used  for  this file in 512-byte blocks.  Since disk space is allocated in multiples of the\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 738/1271 64% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 737/1271 64% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                     Y      year (1970...)\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 736/1271 63% (press h for help or q to quit)\u001b[27m\u001b[K"]
