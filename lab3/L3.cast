[2071.621466, "o", "              %s     File's size in bytes.\u001b[m\r\n\u001b[7m Manual page find(1) line 748/1271 64% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 749/1271 64% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2071.62178, "o", "              %S     File's  sparseness.  This is calculated as (BLOCKSIZE*st_blocks / st_size).  The exact value you will get for an ordinary\u001b[m\r\n\u001b[7m Manual page find(1) line 750/1271 64% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                     file of a certain length is system-dependent.  However, normally sparse files will have values less than 1.0,  and  files\u001b[m\r\n\u001b[7m Manual page find(1) line 751/1271 64% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                     which  use indirect blocks may have a value which is greater than 1.0.  In general the number of blocks used by a file is\u001b[m\r\n\u001b[7m Manual page find(1) line 752/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                     file system dependent.  The value used for BLOCKSIZE is system-dependent, but is usually 512 bytes.  If the file size  is\u001b[m\r\n\u001b[7m Manual page find(1) line 753/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                     zero,  the value printed is undefined.  On systems which lack support for st_blocks, a file's sparseness is assumed to be\u001b[m\r\n\u001b[7m Manual page find(1) line 754/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2071.621905, "o", "                     1.0.\u001b[m\r\n\u001b[7m Manual page find(1) line 755/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 756/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              %t     File's last modification time in the format returned by the C \u001b[1mctime\u001b[22m(3) function.\u001b[m\r\n\u001b[7m Manual page find(1) line 757/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 758/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2071.622325, "o", "              %T\u001b[4mk\u001b[24m    File's last modification time in the format specified by \u001b[4mk\u001b[24m, which is the same as for %A.\u001b[m\r\n\u001b[7m Manual page find(1) line 759/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 760/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              %u     File's user name, or numeric user ID if the user has no name.\u001b[m\r\n\u001b[7m Manual page find(1) line 761/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 762/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              %U     File's numeric user ID.\u001b[m\r\n\u001b[7m Manual page find(1) line 763/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 764/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2071.622575, "o", "              %y     File's type (like in \u001b[1mls -l\u001b[22m), U=unknown type (shouldn't happen)\u001b[m\r\n\u001b[7m Manual page find(1) line 765/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 766/1271 65% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              %Y     File's type (like %y), plus follow symbolic links: `L'=loop, `N'=nonexistent, `?' for any other  error  when  determining\u001b[m\r\n\u001b[7m Manual page find(1) line 767/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2071.622774, "o", "                     the type of the target of a symbolic link.\u001b[m\r\n\u001b[7m Manual page find(1) line 768/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 769/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              %Z     (SELinux only) file's security context.\u001b[m\r\n\u001b[7m Manual page find(1) line 770/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 771/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              %{ %[ %(\u001b[m\r\n\u001b[7m Manual page find(1) line 772/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2071.62286, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                     Reserved for future use.\u001b[m\r\n\u001b[7m Manual page find(1) line 773/1271 66% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
