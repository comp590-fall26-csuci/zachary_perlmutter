[2013.821262, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              True; like \u001b[1m-printf \u001b[22mbut write to \u001b[4mfile\u001b[24m like \u001b[1m-fprint\u001b[22m.  The output file is always created, even if the predicate is  never  matched.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 600/1271 57% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       -fprintf \u001b[4mfile\u001b[24m \u001b[4mformat\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 599/1271 57% (press h for help or q to quit)\u001b[27m\u001b[K"]
