[2055.936719, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       -empty File is empty and is either a regular file or a directory.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 313/1271 32% (press h for help or q to quit)\u001b[27m\u001b[K"]
