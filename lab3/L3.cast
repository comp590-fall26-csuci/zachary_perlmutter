[2025.937628, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              File belongs to group \u001b[4mgname\u001b[24m (numeric group ID allowed).\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 333/1271 33% (press h for help or q to quit)\u001b[27m\u001b[K"]
