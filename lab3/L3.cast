[2071.704357, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              Same as \u001b[4mexpr1\u001b[24m \u001b[4mexpr2\u001b[24m, but not POSIX compliant.\u001b[m\r\n\u001b[7m Manual page find(1) line 819/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 820/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       \u001b[4mexpr1\u001b[24m -o \u001b[4mexpr2\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 821/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2071.704717, "o", "              Or; \u001b[4mexpr2\u001b[24m is not evaluated if \u001b[4mexpr1\u001b[24m is true.\u001b[m\r\n\u001b[7m Manual page find(1) line 822/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 823/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2071.725228, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       \u001b[4mexpr1\u001b[24m -or \u001b[4mexpr2\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 824/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              Same as \u001b[4mexpr1\u001b[24m \u001b[1m-o \u001b[4m\u001b[22mexpr2\u001b[24m, but not POSIX compliant.\u001b[m\r\n\u001b[7m Manual page find(1) line 825/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2071.753397, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 826/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       \u001b[4mexpr1\u001b[24m , \u001b[4mexpr2\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 827/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2072.388771, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              plies \u001b[1m-depth\u001b[22m, you cannot usefully use \u001b[1m-prune \u001b[22mand \u001b[1m-delete \u001b[22mtogether.  For example, to skip the directory \u001b[4msrc/emacs\u001b[24m and  all  files\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 826/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       -prune True;  if  the file is a directory, do not descend into it.  If \u001b[1m-depth \u001b[22mis given, then \u001b[1m-prune \u001b[22mhas no effect.  Because \u001b[1m-delete \u001b[22mim‐\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 825/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 824/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2072.411948, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              See the \u001b[1mUNUSUAL FILENAMES \u001b[22msection for information about how unusual characters in filenames are handled.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 823/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 822/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2072.412372, "o", "\u001b[H\u001bM              ment of a field from right-justified (which is the default) to left-justified.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 821/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              rectives that do not support these flags include \u001b[1mG\u001b[22m, \u001b[1mU\u001b[22m, \u001b[1mb\u001b[22m, \u001b[1mD\u001b[22m, \u001b[1mk \u001b[22mand \u001b[1mn\u001b[22m.  The `-' format flag is supported and changes  the  align‐\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 820/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2072.41247, "o", "\u001b[H\u001bM              The %m and %d directives support the \u001b[1m#\u001b[22m, \u001b[1m0 \u001b[22mand \u001b[1m+ \u001b[22mflags, but the other directives do not, even if they print numbers.  Numeric di‐\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 819/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2072.436981, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 818/1271 70% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2072.437082, "o", "\u001b[H\u001bM              are reading.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 817/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              lowing  character.  In some locales, it may hide your door keys, while in others it may remove the final page from the novel you\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 816/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              format characters may be introduced).  A `%' at the end of the format argument causes undefined behaviour since there is no fol‐\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 815/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2072.45361, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              A `%' character followed by any other character is discarded, but the other character is printed (don't rely on this, as further\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 814/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 813/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                     Reserved for future use.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 812/1271 69% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
