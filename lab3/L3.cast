[2006.601949, "o", "              l      symbolic  link;  this is never true if the \u001b[1m-L \u001b[22moption or the \u001b[1m-follow \u001b[22moption is in effect, unless the symbolic link is bro‐\u001b[m\r\n\u001b[7m Manual page find(1) line 456 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                     ken.  If you want to search for symbolic links when \u001b[1m-L \u001b[22mis in effect, use \u001b[1m-xtype\u001b[22m.\u001b[m\r\n\u001b[7m Manual page find(1) line 457 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2006.602136, "o", "\u001b[m\r\n\u001b[7m Manual page find(1) line 458 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              s      socket\u001b[m\r\n\u001b[7m Manual page find(1) line 459 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 460 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              D      door (Solaris)\u001b[m\r\n\u001b[7m Manual page find(1) line 461 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 462 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              To search for more than one type at once, you can supply the combined list of type letters separated by a comma `,' (GNU  exten‐\u001b[m\r\n\u001b[7m Manual page find(1) line 463 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              sion).\u001b[m\r\n\u001b[7m Manual page find(1) line 464 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 465 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       -uid \u001b[4mn\u001b[24m File's numeric user ID is less than, more than or exactly \u001b[4mn\u001b[24m.\u001b[m\r\n\u001b[7m Manual page find(1) line 466 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 467 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       -used \u001b[4mn\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 468 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              File was last accessed less than, more than or exactly \u001b[4mn\u001b[24m days after its status was last changed.\u001b[m\r\n\u001b[7m Manual page find(1) line 469 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 470 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       -user \u001b[4muname\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 471 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              File is owned by user \u001b[4muname\u001b[24m (numeric user ID allowed).\u001b[m\r\n\u001b[7m Manual page find(1) line 472 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 473 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       -wholename \u001b[4mpattern\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 474 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              See -path.  This alternative is less portable than \u001b[1m-path\u001b[22m.\u001b[m\r\n\u001b[7m Manual page find(1) line 475 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 476 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       -writable\u001b[m\r\n\u001b[7m Manual page find(1) line 477 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              Matches  files which are writable by the current user.  This takes into account access control lists and other permissions arte‐\u001b[m\r\n\u001b[7m Manual page find(1) line 478 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              facts which the \u001b[1m-perm \u001b[22mtest ignores.  This test makes use of the \u001b[1maccess\u001b[22m(2) system call, and so can be fooled by NFS servers which\u001b[m\r\n\u001b[7m Manual page find(1) line 479 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              do UID mapping (or root-squashing), since many systems implement \u001b[1maccess\u001b[22m(2) in the client's kernel and so cannot make use of  the\u001b[m\r\n\u001b[7m Manual page find(1) line 480 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              UID mapping information held on the server.\u001b[m\r\n\u001b[7m Manual page find(1) line 481 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 482 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       -xtype \u001b[4mc\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 483 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bES"]
[2006.602215, "o", "C\u001b[KO\bO\u001b[KB\bB\r\u001b[K              The  same  as  \u001b[1m-type  \u001b[22munless the file is a symbolic link.  For symbolic links: if the \u001b[1m-H \u001b[22mor \u001b[1m-P \u001b[22moption was specified, true if the\u001b[m\r\n\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              file is a link to a file of type \u001b[4mc\u001b[24m; if the \u001b[1m-L \u001b[22moption has been given, true if \u001b[4mc\u001b[24m is `l'.  In  other  words,  for  symbolic  links,\u001b[m\r\n\u001b[7m Manual page find(1) line 485 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              \u001b[1m-xtype \u001b[22mchecks the type of the file that \u001b[1m-type \u001b[22mdoes not check.  If a symbolic link is broken (because the thing it points to does\u001b[m\r\n\u001b[7m Manual page find(1) line 486 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              not exist or the link points to itself) then \u001b[1m-xtype \u001b[22mwill behave the same as \u001b[1m-type\u001b[22m.\u001b[m\r\n\u001b[7m Manual page find(1) line 487 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 488 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       -context \u001b[4mpattern\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 489 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              (SELinux only) Security context of the file matches glob \u001b[4mpattern\u001b[24m.\u001b[m\r\n\u001b[7m Manual page find(1) line 490 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 491 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K   \u001b[1mACTIONS\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 492 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       -delete\u001b[m\r\n\u001b[7m Manual page find(1) line 493 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              Delete  files or directories; true if removal succeeded.  If the removal failed, an error message is issued and \u001b[1mfind\u001b[22m's exit sta‐\u001b[m\r\n\u001b[7m Manual page find(1) line 494 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              tus will be nonzero (when it eventually exits).\u001b[m\r\n\u001b[7m Manual page find(1) line 495 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 496 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              \u001b[1mWarning\u001b[22m: Don't forget that \u001b[1mfind \u001b[22mevaluates the command line as an expression, so putting \u001b[1m-delete \u001b[22mfirst  will  make  \u001b[1mfind  \u001b[22mtry  to\u001b[m\r\n\u001b[7m Manual page find(1) line 497 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              delete everything below the starting points you specified.\u001b[m\r\n\u001b[7m Manual page find(1) line 498 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 499 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              The  use of the \u001b[1m-delete \u001b[22maction on the command line automatically turns on the \u001b[1m-depth \u001b[22moption.  As in turn \u001b[1m-depth \u001b[22mmakes \u001b[1m-prune \u001b[22min‐\u001b[m\r\n\u001b[7m Manual page find(1) line 500 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              effective, the \u001b[1m-delete \u001b[22maction cannot usefully be combined with \u001b[1m-prune\u001b[22m.\u001b[m\r\n\u001b[7m Manual page find(1) line 501 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 502 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              Often, the user might want to test a \u001b[1mfind \u001b[22mcommand line with \u001b[1m-print \u001b[22mprior to adding \u001b[1m-delete \u001b[22mfor the actual removal run.  To avoid\u001b[m\r\n\u001b[7m Manual page find(1) line 503 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              surprising results, it is usually best to remember to use \u001b[1m-depth \u001b[22mexplicitly during those earlier test runs.\u001b[m\r\n\u001b[7m Manual page find(1) line 504 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 505 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              The \u001b[1m-delete \u001b[22maction will fail to remove a directory unless it is empty.\u001b[m\r\n\u001b[7m Manual page find(1) line 506 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 507 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              Together with the \u001b[1m-ignore_readdir_race \u001b[22moption, \u001b[1mfind \u001b[22mwill ignore errors of the \u001b[1m-delete \u001b[22maction in the case  the  file  has  disap‐\u001b[m\r\n\u001b[7m Manual page find(1) line 508 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              peared since the parent directory was read: it will not output an error diagnostic, not change the exit code to nonzero, and the\u001b[m\r\n\u001b[7m Manual page find(1) line 509 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              return code of the \u001b[1m-delete \u001b[22maction will be true.\u001b[m\r\n\u001b[7m Manual page find(1) line 510 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 511 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       -exec \u001b[4mcommand\u001b[24m ;\u001b[m\r\n\u001b[7m Manual page find(1) line 512 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              Execute  \u001b[4mcommand\u001b[24m;  true if 0 status is returned.  All following arguments to \u001b[1mfind \u001b[22mare taken to be arguments to the command until\u001b[m\r\n\u001b[7m Manual page find(1) line 513 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              an argument consisting of `;' is encountered.  The string `{}' is replaced by the current file name being  processed  everywhere\u001b[m\r\n\u001b[7m Manual page find(1) line 514 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              it  occurs in the arguments to the command, not just in arguments where it is alone, as in some versions of \u001b[1mfind\u001b[22m.  Both of these\u001b[m\r\n\u001b[7m Manual page find(1) line 515 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              constructions might need to be escaped (with a `\\') or quoted to protect them from expansion by the  shell.   See  the  \u001b[1mEXAMPLES\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 516 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              section  for  examples of the use of the \u001b[1m-exec \u001b[22moption.  The specified command is run once for each matched file.  The command is\u001b[m\r\n\u001b[7m Manual page find(1) line 517 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              executed in the starting directory.  There are unavoidable security problems surrounding use of the \u001b[1m-exec \u001b[22maction; you should use\u001b[m\r\n\u001b[7m Manual page find(1) line 518 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              the \u001b[1m-execdir \u001b[22moption instead.\u001b[m\r\n\u001b[7m Manual page find(1) line 519 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 520 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       -exec \u001b[4mcommand\u001b[24m {} +\u001b[m\r\n\u001b[7m Manual page find(1) line 521 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              This variant of the \u001b[1m-exec \u001b[22maction runs the specified command on the selected files, but the command line is  built  by  appending\u001b[m\r\n\u001b[7m Manual page find(1) line 522 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              each  selected file name at the end; the total number of invocations of the command will be much less than the number of matched\u001b[m\r\n\u001b[7m Manual page find(1) line 523 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              files.  The command line is built in much the same way that \u001b[1mxargs \u001b[22mbuilds its command lines.  Only one instance of  `{}'  is  al‐\u001b[m\r\n\u001b[7m Manual page find(1) line 524 (p"]
[2006.602415, "o", "ress h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              lowed  within  the  command,  and  it must appear at the end, immediately before the `+'; it needs to be escaped (with a `\\') or\u001b[m\r\n\u001b[7m Manual page find(1) line 525 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              quoted to protect it from interpretation by the shell.  The command is executed in the starting directory.   If  any  invocation\u001b[m\r\n\u001b[7m Manual page find(1) line 526 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              with  the `+' form returns a non-zero value as exit status, then \u001b[1mfind \u001b[22mreturns a non-zero exit status.  If \u001b[1mfind \u001b[22mencounters an er‐\u001b[m\r\n\u001b[7m Manual page find(1) line 527 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              ror, this can sometimes cause an immediate exit, so some pending commands may not be run at all.  For this reason  \u001b[1m-exec \u001b[4m\u001b[22mmy-com‐\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 528 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              \u001b[4mmand\u001b[24m \u001b[1m... {} + -quit \u001b[22mmay not result in \u001b[4mmy-command\u001b[24m actually being run.  This variant of \u001b[1m-exec \u001b[22malways returns true.\u001b[m\r\n\u001b[7m Manual page find(1) line 529 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 530 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       -execdir \u001b[4mcommand\u001b[24m ;\u001b[m\r\n\u001b[7m Manual page find(1) line 531 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 532 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       -execdir \u001b[4mcommand\u001b[24m {} +\u001b[m\r\n\u001b[7m Manual page find(1) line 533 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              Like \u001b[1m-exec\u001b[22m, but the specified command is run from the subdirectory containing the matched file, which is not normally the direc‐\u001b[m\r\n\u001b[7m Manual page find(1) line 534 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              tory in which you started \u001b[1mfind\u001b[22m.  As with -exec, the {} should be quoted if find is being invoked from a shell.  This a much more\u001b[m\r\n\u001b[7m Manual page find(1) line 535 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              secure  method for invoking commands, as it avoids race conditions during resolution of the paths to the matched files.  As with\u001b[m\r\n\u001b[7m Manual page find(1) line 536 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              the \u001b[1m-exec \u001b[22maction, the `+' form of \u001b[1m-execdir \u001b[22mwill build a command line to process more than one matched file, but any given  invo‐\u001b[m\r\n\u001b[7m Manual page find(1) line 537 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              cation  of  \u001b[4mcommand\u001b[24m will only list files that exist in the same subdirectory.  If you use this option, you must ensure that your\u001b[m\r\n\u001b[7m Manual page find(1) line 538 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              \u001b[1mPATH \u001b[22menvironment variable does not reference `.'; otherwise, an attacker can run any commands they like by leaving an  appropri‐\u001b[m\r\n\u001b[7m Manual page find(1) line 539 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              ately-named  file  in a directory in which you will run \u001b[1m-execdir\u001b[22m.  The same applies to having entries in \u001b[1mPATH \u001b[22mwhich are empty or\u001b[m\r\n\u001b[7m Manual page find(1) line 540 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              which are not absolute directory names.  If any invocation with the `+' form returns a non-zero value as exit status, then  \u001b[1mfind\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 541 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              returns  a  non-zero exit status.  If \u001b[1mfind \u001b[22mencounters an error, this can sometimes cause an immediate exit, so some pending com‐\u001b[m\r\n\u001b[7m Manual page find(1) line 542 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              mands may not be run at all.  The result of the action depends on whether the \u001b[1m+ \u001b[22mor the \u001b[1m; \u001b[22mvariant is  being  used;  \u001b[1m-execdir \u001b[4m\u001b[22mcom‐\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 543 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              \u001b[4mmand\u001b[24m \u001b[1m{} + \u001b[22malways returns true, while \u001b[1m-execdir \u001b[4m\u001b[22mcommand\u001b[24m \u001b[1m{} ; \u001b[22mreturns true only if \u001b[4mcommand\u001b[24m returns 0.\u001b[m\r\n\u001b[7m Manual page find(1) line 544 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 545 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       -fls \u001b[4mfile\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 546 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              True;  like \u001b[1m-ls \u001b[22mbut write to \u001b[4mfile\u001b[24m like \u001b[1m-fprint\u001b[22m.  The output file is always created, even if the predicate is never matched.  See\u001b[m\r\n\u001b[7m Manual page find(1) line 547 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              the \u001b[1mUNUSUAL FILENAMES \u001b[22msection for information about how unusual characters in filenames are handled.\u001b[m\r\n\u001b[7m Manual page find(1) line 548 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 549 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       -fprint \u001b[4mfile\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 550 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              True; print the full file name into file \u001b[4mfile\u001b[24m.  If \u001b[4mfile\u001b[24m does not exist when \u001b[1mfind \u001b[22mis run, it is created; if it does exist, it  is\u001b[m\r\n\u001b[7m Manual page find(1) line 551 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              truncated.  The file names \u001b[4m/dev/stdout\u001b[24m and \u001b[4m/dev/stderr\u001b[24m are handled specially; they refer to the standard output and standard er‐\u001b[m\r\n\u001b[7m Manual page find(1) line 552 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              ror output, respectively.  The output file is always created, even if the predicate is never matched.  See the \u001b[1mUNUSUAL FILENAMES\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 553 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              section for information about how unusual characters in filenames are handled.\u001b[m\r\n\u001b[7m Manual page find(1) line 554 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 555 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       -fprint0 \u001b[4mfile\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 556 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              True;  like  \u001b[1m-print0 \u001b[22mbut write to \u001b[4mfile\u001b[24m like \u001b[1m-fprint\u001b[22m.  The output file is always created, even if the predicate is never matched.\u001b[m\r\n\u001b[7m Manual page find(1) line 557 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              See the \u001b[1mUNUSUAL FILENAMES \u001b[22msection for information about how unusual characters in filenames are handled.\u001b[m\r\n\u001b[7m Manual page find(1) line 558 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 559 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       -fprintf \u001b[4mfile\u001b[24m \u001b[4mformat\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 560 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              True; like \u001b[1m-printf \u001b[22mbut write to \u001b[4mfile\u001b[24m like \u001b[1m-fprint\u001b[22m.  The output file is always created, even if the predicate is  never  matched.\u001b[m\r\n\u001b[7m Manual page find(1) line 561 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              See the \u001b[1mUNUSUAL FILENAMES \u001b[22msection for information about how unusual characters in filenames are handled.\u001b[m\r\n\u001b[7m Manual page find(1) line 562 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 563 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2006.602518, "o", "       -ls    True;  list  current  file  in  \u001b[1mls -dils \u001b[22mformat on standard output.  The block counts are of 1 KB blocks, unless the environment\u001b[m\r\n\u001b[7m Manual page find(1) line 564 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              variable \u001b[1mPOSIXLY_CORRECT \u001b[22mis set, in which case 512-byte blocks are used.  See the  \u001b[1mUNUSUAL  FILENAMES  \u001b[22msection  for  information\u001b[m\r\n\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              about how unusual characters in filenames are handled.\u001b[m\r\n\u001b[7m Manual page find(1) line 566 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 567 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       -ok \u001b[4mcommand\u001b[24m ;\u001b[m\r\n\u001b[7m Manual page find(1) line 568 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              Like  \u001b[1m-exec  \u001b[22mbut ask the user first.  If the user agrees, run the command.  Otherwise just return false.  If the command is run,\u001b[m\r\n\u001b[7m Manual page find(1) line 569 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              its standard input is redirected from \u001b[4m/dev/null\u001b[24m.  This action may not be specified together with the \u001b[1m-files0-from \u001b[22moption.\u001b[m\r\n\u001b[7m Manual page find(1) line 570 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 571 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              The response to the prompt is matched against a pair of regular expressions to determine if it is an affirmative or negative re‐\u001b[m\r\n\u001b[7m Manual page find(1) line 572 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              sponse.  This regular expression is obtained from the system if the \u001b[1mPOSIXLY_CORRECT \u001b[22menvironment variable is  set,  or  otherwise\u001b[m\r\n\u001b[7m Manual page find(1) line 573 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              from  \u001b[1mfind\u001b[22m's  message  translations.   If  the system has no suitable definition, \u001b[1mfind\u001b[22m's own definition will be used.  In either\u001b[m\r\n\u001b[7m Manual page find(1) line 574 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              case, the interpretation of the regular expression itself will be affected by  the  environment  variables  \u001b[1mLC_CTYPE  \u001b[22m(character\u001b[m\r\n\u001b[7m Manual page find(1) line 575 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              classes) and \u001b[1mLC_COLLATE \u001b[22m(character ranges and equivalence classes).\u001b[m\r\n\u001b[7m Manual page find(1) line 576 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 577 (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
