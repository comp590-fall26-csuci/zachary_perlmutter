[2071.539611, "o", "\u001b[m\r\n\u001b[7m Manual page find(1) line 618/1271 57% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              \\NNN   The character whose ASCII code is NNN (octal).\u001b[m\r\n\u001b[7m Manual page find(1) line 619/1271 57% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 620/1271 57% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              A `\\' character followed by any other character is treated as an ordinary character, so they both are printed.\u001b[m\r\n\u001b[7m Manual page find(1) line 621/1271 57% (press h for help or q to quit)\u001b[27m\u001b[K"]
