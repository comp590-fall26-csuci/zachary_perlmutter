[2047.871174, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              No group corresponds to file's numeric group ID.\u001b[m\r\n\u001b[7m Manual page find(1) line 365/1271 36% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 366/1271 36% (press h for help or q to quit)\u001b[27m\u001b[K"]
