[2048.321505, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              File belongs to group \u001b[4mgname\u001b[24m (numeric group ID allowed).\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 333/1271 33% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       -group \u001b[4mgname\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 332/1271 33% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2048.33704, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 331/1271 33% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       -gid \u001b[4mn\u001b[24m File's numeric group ID is less than, more than or exactly \u001b[4mn\u001b[24m.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 330/1271 33% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 329/1271 33% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2048.337142, "o", "\u001b[H\u001bM              \u001b[1m-printf \u001b[22mwith the %F directive to see the types of your filesystems.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 328/1271 33% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              filesystem types that are accepted on some version of Unix or another is: ufs, 4.2, 4.3, nfs, tmp, mfs, S51K, S52K.  You can use\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 327/1271 32% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              File is on a filesystem of type \u001b[4mtype\u001b[24m.  The valid filesystem types vary among different versions of Unix; an incomplete  list  of\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 326/1271 32% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
