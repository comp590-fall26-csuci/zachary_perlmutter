[2047.707414, "o", "       -ipath \u001b[4mpattern\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 307/1271 31% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2047.707487, "o", "              Like \u001b[1m-path\u001b[22m.  but the match is case insensitive.\u001b[m\r\n\u001b[7m Manual page find(1) line 308/1271 31% (press h for help or q to quit)\u001b[27m\u001b[K"]
