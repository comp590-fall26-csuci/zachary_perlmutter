[2013.871683, "o", "\u001b[H\u001bM              See the \u001b[1mUNUSUAL FILENAMES \u001b[22msection for information about how unusual characters in filenames are handled.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 597/1271 56% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              True;  like  \u001b[1m-print0 \u001b[22mbut write to \u001b[4mfile\u001b[24m like \u001b[1m-fprint\u001b[22m.  The output file is always created, even if the predicate is never matched.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 596/1271 56% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       -fprint0 \u001b[4mfile\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 595/1271 56% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 594/1271 56% (press h for help or q to quit)\u001b[27m\u001b[K"]
