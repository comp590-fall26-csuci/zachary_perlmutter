[2060.122031, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              rounding affects the interpretation of file status change times.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 311/1271 32% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              File's status was last changed less than, more than or exactly \u001b[4mn\u001b[24m*24 hours ago.  See the comments for \u001b[1m-atime  \u001b[22mto  understand  how\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 310/1271 31% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2060.245032, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       -ctime \u001b[4mn\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 309/1271 31% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 308/1271 31% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2060.359661, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              the file it points to is always used.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 307/1271 31% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              If  \u001b[4mreference\u001b[24m is a symbolic link and the \u001b[1m-H \u001b[22moption or the \u001b[1m-L \u001b[22moption is in effect, then the time of the last data modification of\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 306/1271 31% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              Time of the last status change of the current file is more recent than that of the last data modification of the \u001b[4mreference\u001b[24m file.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 305/1271 31% (press h for help or q to quit)\u001b[27m\u001b[K"]
