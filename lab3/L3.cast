[2070.485754, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       -fstype \u001b[4mtype\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 286/1271 30% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2070.485852, "o", "              File is on a filesystem of type \u001b[4mtype\u001b[24m.  The valid filesystem types vary among different versions of Unix; an incomplete  list  of\u001b[m\r\n\u001b[7m Manual page find(1) line 287/1271 30% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              filesystem types that are accepted on some version of Unix or another is: ufs, 4.2, 4.3, nfs, tmp, mfs, S51K, S52K.  You can use\u001b[m\r\n\u001b[7m Manual page find(1) line 288/1271 30% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              \u001b[1m-printf \u001b[22mwith the %F directive to see the types of your filesystems.\u001b[m\r\n\u001b[7m Manual page find(1) line 289/1271 30% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2070.502892, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 290/1271 30% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
