[2110.888965, "o", "       \u001b[1m$ find . -name *.c -print\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 1193/1271 97% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       find: paths must precede expression\u001b[m\r\n\u001b[7m Manual page find(1) line 1194/1271 97% (press h for help or q to quit)\u001b[27m\u001b[K"]
