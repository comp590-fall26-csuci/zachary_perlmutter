[2070.781622, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              file.  If \u001b[4mreference\u001b[24m is a symbolic link and the \u001b[1m-H \u001b[22moption or the \u001b[1m-L \u001b[22moption is in effect, then the time of the last data modifica‐\u001b[m\r\n\u001b[7m Manual page find(1) line 345/1271 34% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2070.78175, "o", "              tion of the file it points to is always used.\u001b[m\r\n\u001b[7m Manual page find(1) line 346/1271 35% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 347/1271 35% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       -newerXY \u001b[4mreference\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 348/1271 35% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2070.820747, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              Succeeds if timestamp \u001b[4mX\u001b[24m of the file being considered is newer than timestamp \u001b[4mY\u001b[24m of the file \u001b[4mreference\u001b[24m.  The letters \u001b[4mX\u001b[24m and  \u001b[4mY\u001b[24m  can\u001b[m\r\n\u001b[7m Manual page find(1) line 349/1271 35% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2070.820861, "o", "              be any of the following letters:\u001b[m\r\n\u001b[7m Manual page find(1) line 350/1271 35% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2070.82688, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
