[2007.157494, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM   \u001b[1m“paths must precede expression” error message\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1231/1271 100% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1230/1271 100% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       between tests, \u001b[1m-a \u001b[22mis assumed.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1229/1271 100% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2007.166005, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       \u001b[1m-o \\( -name bfile -a -print \\)\u001b[22m.  Remember that the precedence of \u001b[1m-a \u001b[22mis higher than that of \u001b[1m-o \u001b[22mand when there is no  operator  specified\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1228/1271 100% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2007.166081, "o", "\u001b[H\u001bM       The  command  \u001b[1mfind . -name afile -o -name bfile -print \u001b[22mwill never print \u001b[4mafile\u001b[24m because this is actually equivalent to \u001b[1mfind . -name afile\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1227/1271 100% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM   \u001b[1mOperator precedence surprises\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1226/1271 100% (press h for help or q to quit)\u001b[27m\u001b[K"]
