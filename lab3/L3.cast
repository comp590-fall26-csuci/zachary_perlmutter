[2051.124136, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       A numeric argument \u001b[4mn\u001b[24m can be specified to tests (like \u001b[1m-amin\u001b[22m, \u001b[1m-mtime\u001b[22m, \u001b[1m-gid\u001b[22m, \u001b[1m-inum\u001b[22m, \u001b[1m-links\u001b[22m, \u001b[1m-size\u001b[22m, \u001b[1m-uid \u001b[22mand \u001b[1m-used\u001b[22m) as\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 278/1271 29% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 277/1271 29% (press h for help or q to quit)\u001b[27m\u001b[K"]
