[2110.876075, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                  \u001b[1mrepo/project4/.git\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 1099/1271 91% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 1100/1271 91% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2110.876182, "o", "              In this example, \u001b[1m-prune \u001b[22mprevents unnecessary descent into directories that have already been discovered (for example we  do  not\u001b[m\r\n\u001b[7m Manual page find(1) line 1101/1271 92% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              search \u001b[4mproject3/src\u001b[24m because we already found \u001b[4mproject3/.svn\u001b[24m), but ensures sibling directories (\u001b[4mproject2\u001b[24m and \u001b[4mproject3\u001b[24m) are found.\u001b[m\r\n\u001b[7m Manual page find(1) line 1102/1271 92% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 1103/1271 92% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2110.876283, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K   \u001b[1mOther useful examples\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 1104/1271 92% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       •      Search for several file types.\u001b[m\r\n\u001b[7m Manual page find(1) line 1105/1271 92% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 1106/1271 92% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2110.876384, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                  \u001b[1m$ find /tmp -type f,d,l\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 1107/1271 92% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 1108/1271 92% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2110.876485, "o", "              Search  for  files, directories, and symbolic links in the directory \u001b[4m/tmp\u001b[24m passing these types as a comma-separated list (GNU ex‐\u001b[m\r\n\u001b[7m Manual page find(1) line 1109/1271 92% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              tension), which is otherwise equivalent to the longer, yet more portable:\u001b[m\r\n\u001b[7m Manual page find(1) line 1110/1271 92% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 1111/1271 92% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2110.876583, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                  \u001b[1m$ find /tmp \\( -type f -o -type d -o -type l \\)\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 1112/1271 92% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 1113/1271 92% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2110.876685, "o", "       •      Search for files with the particular name \u001b[4mneedle\u001b[24m and stop immediately when we find the first one.\u001b[m\r\n\u001b[7m Manual page find(1) line 1114/1271 92% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 1115/1271 92% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                  \u001b[1m$ find / -name needle -print -quit\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 1116/1271 92% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2110.876796, "o", "\u001b[m\r\n\u001b[7m Manual page find(1) line 1117/1271 92% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       •      Demonstrate the interpretation of the \u001b[1m%f \u001b[22mand \u001b[1m%h \u001b[22mformat directives of the \u001b[1m-printf \u001b[22maction for some corner-cases.  Here is an exam‐\u001b[m\r\n\u001b[7m Manual page find(1) line 1118/1271 93% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2110.876898, "o", "              ple including some output.\u001b[m\r\n\u001b[7m Manual page find(1) line 1119/1271 93% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 1120/1271 93% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                  \u001b[1m$ find . .. / /tmp /tmp/TRACE compile compile/64/tests/find -maxdepth 0 -printf '[%h][%f]\\n'\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 1121/1271 93% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
