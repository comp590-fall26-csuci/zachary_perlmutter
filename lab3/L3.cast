[2110.872454, "o", "              This command works this way because the time since each file was last modified is divided by 24 hours and any remainder is  dis‐\u001b[m\r\n\u001b[7m Manual page find(1) line 1017/1271 86% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2110.872919, "o", "              carded.  That means that to match \u001b[1m-mtime 0\u001b[22m, a file will have to have a modification in the past which is less than 24 hours ago.\u001b[m\r\n\u001b[7m Manual page find(1) line 1018/1271 86% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 1019/1271 86% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K   \u001b[1mSearching files by permissions\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 1020/1271 86% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       •      Search for files which are executable but not readable.\u001b[m\r\n\u001b[7m Manual page find(1) line 1021/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 1022/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                  \u001b[1m$ find /sbin /usr/sbin -executable \\! -readable -print\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 1023/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 1024/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       •      Search  for  files which have read and write permission for their owner, and group, but which other users can read but not write\u001b[m\r\n\u001b[7m Manual page find(1) line 1025/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              to.\u001b[m\r\n\u001b[7m Manual page find(1) line 1026/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 1027/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2110.873048, "o", "                  \u001b[1m$ find . -perm 664\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 1028/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 1029/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              Files which meet these criteria but have other permissions bits set (for example if someone can execute the file)  will  not  be\u001b[m\r\n\u001b[7m Manual page find(1) line 1030/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2110.873164, "o", "              matched.\u001b[m\r\n\u001b[7m Manual page find(1) line 1031/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 1032/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       •      Search  for files which have read and write permission for their owner and group, and which other users can read, without regard\u001b[m\r\n\u001b[7m Manual page find(1) line 1033/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2110.873278, "o", "              to the presence of any extra permission bits (for example the executable bit).\u001b[m\r\n\u001b[7m Manual page find(1) line 1034/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 1035/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
