[2110.888692, "o", "       The  command  \u001b[1mfind . -name afile -o -name bfile -print \u001b[22mwill never print \u001b[4mafile\u001b[24m because this is actually equivalent to \u001b[1mfind . -name afile\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 1188/1271 97% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2110.888774, "o", "       \u001b[1m-o \\( -name bfile -a -print \\)\u001b[22m.  Remember that the precedence of \u001b[1m-a \u001b[22mis higher than that of \u001b[1m-o \u001b[22mand when there is no  operator  specified\u001b[m\r\n\u001b[7m Manual page find(1) line 1189/1271 97% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       between tests, \u001b[1m-a \u001b[22mis assumed.\u001b[m\r\n\u001b[7m Manual page find(1) line 1190/1271 97% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2110.88884, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 1191/1271 97% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
