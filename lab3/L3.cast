[2013.670305, "o", "\u001b[H\u001bM                     @      seconds since Jan. 1, 1970, 00:00 GMT, with fractional part.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 671/1271 60% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 670/1271 60% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2013.670474, "o", "\u001b[H\u001bM                     in the implementation of the \u001b[1mstrftime\u001b[22m(3) library function.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 669/1271 59% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                     the full list.  Some of the conversion specification characters might not be available on all systems, due to differences\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 668/1271 59% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                     The following shows an incomplete list of possible values for \u001b[4mk\u001b[24m.  Please refer to the documentation  of  \u001b[1mstrftime\u001b[22m(3)  for\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 667/1271 59% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2013.670517, "o", "\u001b[H\u001bM              %A\u001b[4mk\u001b[24m    File's  last access time in the format specified by \u001b[4mk\u001b[24m, which is either `@' or a directive for the C \u001b[1mstrftime\u001b[22m(3) function.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 666/1271 59% (press h for help or q to quit)\u001b[27m\u001b[K"]
