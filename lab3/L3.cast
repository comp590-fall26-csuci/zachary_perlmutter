[2071.575315, "o", "              %b     The  amount  of  disk  space  used  for  this file in 512-byte blocks.  Since disk space is allocated in multiples of the\u001b[m\r\n\u001b[7m Manual page find(1) line 699/1271 61% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                     filesystem block size this is usually greater than %s/512, but it can also be smaller if the file is a sparse file.\u001b[m\r\n\u001b[7m Manual page find(1) line 700/1271 61% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2071.587206, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 701/1271 61% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2071.587555, "o", "              %B\u001b[4mk\u001b[24m    File's birth time, i.e., its creation time, in the format specified by \u001b[4mk\u001b[24m, which is the same as for  %A.   This  directive\u001b[m\r\n\u001b[7m Manual page find(1) line 702/1271 61% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                     produces an empty string if the underlying operating system or filesystem does not support birth times.\u001b[m\r\n\u001b[7m Manual page find(1) line 703/1271 61% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 704/1271 61% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2071.58781, "o", "              %c     File's last status change time in the format returned by the C \u001b[1mctime\u001b[22m(3) function.\u001b[m\r\n\u001b[7m Manual page find(1) line 705/1271 61% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 706/1271 61% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              %C\u001b[4mk\u001b[24m    File's last status change time in the format specified by \u001b[4mk\u001b[24m, which is the same as for %A.\u001b[m\r\n\u001b[7m Manual page find(1) line 707/1271 61% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 708/1271 61% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              %d     File's depth in the directory tree; 0 means the file is a starting-point.\u001b[m\r\n\u001b[7m Manual page find(1) line 709/1271 62% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 710/1271 62% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2071.588099, "o", "              %D     The device number on which the file exists (the st_dev field of struct stat), in decimal.\u001b[m\r\n\u001b[7m Manual page find(1) line 711/1271 62% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 712/1271 62% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2071.588288, "o", "              %f     Print  the  basename; the file's name with any leading directories removed (only the last element).  For \u001b[1m/\u001b[22m, the result is\u001b[m\r\n\u001b[7m Manual page find(1) line 713/1271 62% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                     `/'.  See the \u001b[1mEXAMPLES \u001b[22msection for an example.\u001b[m\r\n\u001b[7m Manual page find(1) line 714/1271 62% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 715/1271 62% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              %F     Type of the filesystem the file is on; this value can be used for -fstype.\u001b[m\r\n\u001b[7m Manual page find(1) line 716/1271 62% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 717/1271 62% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2071.588491, "o", "              %g     File's group name, or numeric group ID if the group has no name.\u001b[m\r\n\u001b[7m Manual page find(1) line 718/1271 62% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 719/1271 62% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              %G     File's numeric group ID.\u001b[m\r\n\u001b[7m Manual page find(1) line 720/1271 62% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 721/1271 62% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2071.588658, "o", "              %h     Dirname; the Leading directories of the file's name (all but the last element).  If the file  name  contains  no  slashes\u001b[m\r\n\u001b[7m Manual page find(1) line 722/1271 62% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                     (since  it  is in the current directory) the %h specifier expands to `.'.  For files which are themselves directories and\u001b[m\r\n\u001b[7m Manual page find(1) line 723/1271 62% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2071.588855, "o", "                     contain a slash (including \u001b[1m/\u001b[22m), %h expands to the empty string.  See the \u001b[1mEXAMPLES \u001b[22msection for an example.\u001b[m\r\n\u001b[7m Manual page find(1) line 724/1271 63% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2071.603779, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2071.604096, "o", "\u001b[m\r\n\u001b[7m Manual page find(1) line 725/1271 63% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              %H     Starting-point under which file was found.\u001b[m\r\n\u001b[7m Manual page find(1) line 726/1271 63% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 727/1271 63% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              %i     File's inode number (in decimal).\u001b[m\r\n\u001b[7m Manual page find(1) line 728/1271 63% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 729/1271 63% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2071.604284, "o", "              %k     The amount of disk space used for this file in 1 KB blocks.  Since disk space is allocated in multiples of the filesystem\u001b[m\r\n\u001b[7m Manual page find(1) line 730/1271 63% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                     block size this is usually greater than %s/1024, but it can also be smaller if the file is a sparse file.\u001b[m\r\n\u001b[7m Manual page find(1) line 731/1271 63% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2071.604431, "o", "\u001b[m\r\n\u001b[7m Manual page find(1) line 732/1271 63% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              %l     Object of symbolic link (empty string if file is not a symbolic link).\u001b[m\r\n\u001b[7m Manual page find(1) line 733/1271 63% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 734/1271 63% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2071.604551, "o", "              %m     File's permission bits (in octal).  This option uses the `traditional' numbers which most Unix implementations  use,  but\u001b[m\r\n\u001b[7m Manual page find(1) line 735/1271 63% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                     if  your  particular implementation uses an unusual ordering of octal permissions bits, you will see a difference between\u001b[m\r\n\u001b[7m Manual page find(1) line 736/1271 63% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                     the actual value of the file's mode and the output of %m.  Normally you will want to have a leading zero on this  number,\u001b[m\r\n\u001b[7m Manual page find(1) line 737/1271 64% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2071.60467, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                     and to do this, you should use the \u001b[1m# \u001b[22mflag (as in, for example, `%#m').\u001b[m\r\n\u001b[7m Manual page find(1) line 738/1271 64% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 739/1271 64% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2071.6048, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              %M     File's permissions (in symbolic form, as for \u001b[1mls\u001b[22m).  This directive is supported in findutils 4.2.5 and later.\u001b[m\r\n\u001b[7m Manual page find(1) line 740/1271 64% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2071.60492, "o", "\u001b[m\r\n\u001b[7m Manual page find(1) line 741/1271 64% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              %n     Number of hard links to file.\u001b[m\r\n\u001b[7m Manual page find(1) line 742/1271 64% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2071.604994, "o", "\u001b[m\r\n\u001b[7m Manual page find(1) line 743/1271 64% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              %p     File's name.\u001b[m\r\n\u001b[7m Manual page find(1) line 744/1271 64% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2071.605256, "o", "\u001b[m\r\n\u001b[7m Manual page find(1) line 745/1271 64% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              %P     File's name with the name of the starting-point under which it was found removed.\u001b[m\r\n\u001b[7m Manual page find(1) line 746/1271 64% (press h for help or q to quit)\u001b[27m\u001b[K"]
