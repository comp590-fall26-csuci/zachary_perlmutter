[2070.396285, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 275/1271 29% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       -executable\u001b[m\r\n\u001b[7m Manual page find(1) line 276/1271 29% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2070.412916, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              Matches  files  which are executable and directories which are searchable (in a file name resolution sense) by the current user.\u001b[m\r\n\u001b[7m Manual page find(1) line 277/1271 29% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              This takes into account access control lists and other permissions artefacts which the \u001b[1m-perm \u001b[22mtest ignores.  This test makes  use\u001b[m\r\n\u001b[7m Manual page find(1) line 278/1271 29% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2070.418636, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2070.418692, "o", "              of  the  \u001b[1maccess\u001b[22m(2) system call, and so can be fooled by NFS servers which do UID mapping (or root-squashing), since many systems\u001b[m\r\n\u001b[7m Manual page find(1) line 279/1271 29% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2070.418742, "o", "              implement \u001b[1maccess\u001b[22m(2) in the client's kernel and so cannot make use of the UID mapping information held on  the  server.   Because\u001b[m\r\n\u001b[7m Manual page find(1) line 280/1271 30% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2070.436605, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              this  test  is based only on the result of the \u001b[1maccess\u001b[22m(2) system call, there is no guarantee that a file for which this test suc‐\u001b[m\r\n\u001b[7m Manual page find(1) line 281/1271 30% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              ceeds can actually be executed.\u001b[m\r\n\u001b[7m Manual page find(1) line 282/1271 30% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2070.452779, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 283/1271 30% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       -false Always false.\u001b[m\r\n\u001b[7m Manual page find(1) line 284/1271 30% (press h for help or q to quit)\u001b[27m\u001b[K"]
