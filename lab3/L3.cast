[2054.904987, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 290/1271 30% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       -gid \u001b[4mn\u001b[24m File's numeric group ID is less than, more than or exactly \u001b[4mn\u001b[24m.\u001b[m\r\n\u001b[7m Manual page find(1) line 291/1271 30% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2054.929518, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 292/1271 30% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       -group \u001b[4mgname\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 293/1271 30% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2054.970387, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              File belongs to group \u001b[4mgname\u001b[24m (numeric group ID allowed).\u001b[m\r\n\u001b[7m Manual page find(1) line 294/1271 31% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 295/1271 31% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       -ilname \u001b[4mpattern\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 296/1271 31% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2055.002006, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              Like  \u001b[1m-lname\u001b[22m,  but  the match is case insensitive.  If the \u001b[1m-L \u001b[22moption or the \u001b[1m-follow \u001b[22moption is in effect, this test returns false\u001b[m\r\n\u001b[7m Manual page find(1) line 297/1271 31% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              unless the symbolic link is broken.\u001b[m\r\n\u001b[7m Manual page find(1) line 298/1271 31% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2055.026259, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 299/1271 31% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       -iname \u001b[4mpattern\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 300/1271 31% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2055.03703, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              Like \u001b[1m-name\u001b[22m, but the match is case insensitive.  For example, the patterns `fo*' and `F??' match the  file  names  `Foo',  `FOO',\u001b[m\r\n\u001b[7m Manual page find(1) line 301/1271 31% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              `foo', `fOo', etc.  The pattern `*foo*` will also match a file called '.foobar'.\u001b[m\r\n\u001b[7m Manual page find(1) line 302/1271 31% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 303/1271 31% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2055.037141, "o", "       -inum \u001b[4mn\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 304/1271 31% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              File has inode number smaller than, greater than or exactly \u001b[4mn\u001b[24m.  It is normally easier to use the \u001b[1m-samefile \u001b[22mtest instead.\u001b[m\r\n\u001b[7m Manual page find(1) line 305/1271 31% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 306/1271 31% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       -ipath \u001b[4mpattern\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 307/1271 31% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2055.05996, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              Like \u001b[1m-path\u001b[22m.  but the match is case insensitive.\u001b[m\r\n\u001b[7m Manual page find(1) line 308/1271 31% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 309/1271 31% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       -iregex \u001b[4mpattern\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 310/1271 31% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              Like \u001b[1m-regex\u001b[22m, but the match is case insensitive.\u001b[m\r\n\u001b[7m Manual page find(1) line 311/1271 32% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 312/1271 32% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       -iwholename \u001b[4mpattern\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 313/1271 32% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2055.076973, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              See -ipath.  This alternative is less portable than \u001b[1m-ipath\u001b[22m.\u001b[m\r\n\u001b[7m Manual page find(1) line 314/1271 32% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 315/1271 32% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       -links \u001b[4mn\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 316/1271 32% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2055.077126, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              File has less than, more than or exactly \u001b[4mn\u001b[24m hard links.\u001b[m\r\n\u001b[7m Manual page find(1) line 317/1271 32% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 318/1271 32% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       -lname \u001b[4mpattern\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 319/1271 32% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2055.077251, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              File  is  a symbolic link whose contents match shell pattern \u001b[4mpattern\u001b[24m.  The metacharacters do not treat `/' or `.' specially.  If\u001b[m\r\n\u001b[7m Manual page find(1) line 320/1271 32% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2055.120445, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              the \u001b[1m-L \u001b[22moption or the \u001b[1m-follow \u001b[22moption is in effect, this test returns false unless the symbolic link is broken.\u001b[m\r\n\u001b[7m Manual page find(1) line 321/1271 32% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 322/1271 32% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2055.72035, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              ceeds can actually be executed.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 321/1271 32% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2055.755851, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              this  test  is based only on the result of the \u001b[1maccess\u001b[22m(2) system call, there is no guarantee that a file for which this test suc‐\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 320/1271 32% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              implement \u001b[1maccess\u001b[22m(2) in the client's kernel and so cannot make use of the UID mapping information held on  the  server.   Because\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 319/1271 32% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2055.878612, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              of  the  \u001b[1maccess\u001b[22m(2) system call, and so can be fooled by NFS servers which do UID mapping (or root-squashing), since many systems\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 318/1271 32% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2055.879028, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              This takes into account access control lists and other permissions artefacts which the \u001b[1m-perm \u001b[22mtest ignores.  This test makes  use\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 317/1271 32% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K"]
[2055.879109, "o", "\u001b[H\u001bM              Matches  files  which are executable and directories which are searchable (in a file name resolution sense) by the current user.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 316/1271 32% (press h for help or q to quit)\u001b[27m\u001b[K"]
