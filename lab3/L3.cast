[2007.371462, "o", "\u001b[H\u001bM                      \u001b[1m-or -exec test -d '{}/.git' \\; \\\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1128/1271 93% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                      \u001b[1m\\( -exec test -d '{}/.svn' \\; \\\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1127/1271 93% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM                  \u001b[1m$ find repo/ \\\u001b[0m\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1126/1271 93% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1125/1271 93% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              the projects' roots:\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1124/1271 93% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM       •      Given  the  following directory of projects and their associated SCM administrative directories, perform an efficient search for\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1123/1271 93% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1122/1271 93% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KA\bA\r\u001b[K\u001b[H\u001bM              on.\u001b[m\r\n\u001b[41;1H\r\u001b[K\u001b[7m Manual page find(1) line 1121/1271 93% (press