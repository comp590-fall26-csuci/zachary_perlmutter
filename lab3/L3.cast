[2110.87358, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              This will match a file which has mode \u001b[4m0777\u001b[24m, for example.\u001b[m\r\n\u001b[7m Manual page find(1) line 1038/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 1039/1271 87% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2110.873697, "o", "       •      Search for files which are writable by somebody (their owner, or their group, or anybody else).\u001b[m\r\n\u001b[7m Manual page find(1) line 1040/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 1041/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                  \u001b[1m$ find . -perm /222\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 1042/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2110.873824, "o", "\u001b[m\r\n\u001b[7m Manual page find(1) line 1043/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       •      Search for files which are writable by either their owner or their group.\u001b[m\r\n\u001b[7m Manual page find(1) line 1044/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 1045/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2110.873947, "o", "                  \u001b[1m$ find . -perm /220\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 1046/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                  \u001b[1m$ find . -perm /u+w,g+w\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 1047/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                  \u001b[1m$ find . -perm /u=w,g=w\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 1048/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2110.874005, "o", "\u001b[m\r\n\u001b[7m Manual page find(1) line 1049/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              All three of these commands do the same thing, but the first one uses the octal representation of the file mode, and  the  other\u001b[m\r\n\u001b[7m Manual page find(1) line 1050/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2110.874077, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              two use the symbolic form.  The files don't have to be writable by both the owner and group to be matched; either will do.\u001b[m\r\n\u001b[7m Manual page find(1) line 1051/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2110.874128, "o", "\u001b[m\r\n\u001b[7m Manual page find(1) line 1052/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       •      Search for files which are writable by both their owner and their group.\u001b[m\r\n\u001b[7m Manual page find(1) line 1053/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2110.874181, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 1054/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2110.874231, "o", "                  \u001b[1m$ find . -perm -220\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 1055/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                  \u001b[1m$ find . -perm -g+w,u+w\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 1056/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2110.874281, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 1057/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2110.874332, "o", "              Both these commands do the same thing.\u001b[m\r\n\u001b[7m Manual page find(1) line 1058/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2110.874395, "o", "\u001b[m\r\n\u001b[7m Manual page find(1) line 1059/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       •      A more elaborate search on permissions.\u001b[m\r\n\u001b[7m Manual page find(1) line 1060/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2110.874449, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 1061/1271 88% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                  \u001b[1m$ find . -perm -444 -perm /222 \\! -perm /111\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 1062/1271 89% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2110.874504, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                  \u001b[1m$ find . -perm -a+r -perm /a+w \\! -perm /a+x\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 1063/1271 89% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2110.874556, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 1064/1271 89% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2110.87461, "o", "              These two commands both search for files that are readable for everybody (\u001b[1m-perm -444 \u001b[22mor \u001b[1m-perm -a+r\u001b[22m), have at least one write bit\u001b[m\r\n\u001b[7m Manual page find(1) line 1065/1271 89% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2110.875101, "o", "              set (\u001b[1m-perm /222 \u001b[22mor \u001b[1m-perm /a+w\u001b[22m) but are not executable for anybody (\u001b[1m! -perm /111 \u001b[22mor \u001b[1m! -perm /a+x \u001b[22mrespectively).\u001b[m\r\n\u001b[7m Manual page find(1) line 1066/1271 89% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 1067/1271 89% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2110.875222, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K   \u001b[1mPruning - omitting files and subdirectories\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 1068/1271 89% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       •      Copy  the  contents of \u001b[4m/source-dir\u001b[24m to \u001b[4m/dest-dir\u001b[24m, but omit files and directories named \u001b[4m.snapshot\u001b[24m (and anything in them).  It also\u001b[m\r\n\u001b[7m Manual page find(1) line 1069/1271 89% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              omits files or directories whose name ends in `~', but not their contents.\u001b[m\r\n\u001b[7m Manual page find(1) line 1070/1271 89% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 1071/1271 89% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                  \u001b[1m$ cd /source-dir\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 1072/1271 89% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                  \u001b[1m$ find . -name .snapshot -prune -o \\( \\! -name '*~' -print0 \\) \\\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 1073/1271 89% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                      \u001b[1m| cpio -pmd0 /dest-dir\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 1074/1271 90% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 1075/1271 90% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              The construct \u001b[1m-prune -o \\( ... -print0 \\) \u001b[22mis quite common.  The idea here is that the expression before  \u001b[1m-prune  \u001b[22mmatches  things\u001b[m\r\n\u001b[7m Manual page find(1) line 1076/1271 90% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              which are to be pruned.  However, the \u001b[1m-prune \u001b[22maction itself returns true, so the following \u001b[1m-o \u001b[22mensures that the right hand side is\u001b[m\r\n\u001b[7m Manual page find(1) line 1077/1271 90% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              evaluated  only  for  those directories which didn't get pruned (the contents of the pruned directories are not even visited, so\u001b[m\r\n\u001b[7m Manual page find(1) line 1078/1271 90% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              their contents are irrelevant).  The expression on the right hand side of the \u001b[1m-o \u001b[22mis in parentheses only for clarity.  It  empha‐\u001b[m\r\n\u001b[7m Manual page find(1) line 1079/1271 90% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2110.87533, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              sises  that  the  \u001b[1m-print0 \u001b[22maction takes place only for things that didn't have \u001b[1m-prune \u001b[22mapplied to them.  Because the default `and'\u001b[m\r\n\u001b[7m Manual page find(1) line 1080/1271 90% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              condition between tests binds more tightly than \u001b[1m-o\u001b[22m, this is the default anyway, but the parentheses help to show what  is  going\u001b[m\r\n\u001b[7m Manual page find(1) line 1081/1271 91% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[2110.875434, "o", "              on.\u001b[m\r\n\u001b[7m Manual page find(1) line 1082/1271 91% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 1083/1271 91% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       •      Given  the  following directory of projects and their associated SCM administrative directories, perform an efficient search for\u001b[m\r\n\u001b[7m Manual page find(1) line 1084/1271 91% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2110.875536, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              the projects' roots:\u001b[m\r\n\u001b[7m Manual page find(1) line 1085/1271 91% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 1086/1271 91% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                  \u001b[1m$ find repo/ \\\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 1087/1271 91% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2110.875665, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                      \u001b[1m\\( -exec test -d '{}/.svn' \\; \\\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 1088/1271 91% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                      \u001b[1m-or -exec test -d '{}/.git' \\; \\\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 1089/1271 91% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                      \u001b[1m-or -exec test -d '{}/CVS' \\; \\\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 1090/1271 91% (press h for help or q to quit)\u001b[27m\u001b[K"]
[2110.875777, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K                      \u001b[1m\\) -print -prune\u001b[0m\u001b[m\r\n\u001b[7m Manual page find(1) line 1091/1271 91% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m\r\n\u001b[7m Manual page find(1) line 1092/1271 91% (press h for help or q to quit)\u001b[27m\u001b[K\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              Sample output:\u001b[m\r\n\u001b[7m Manual page find(1) line 1093/1271 91% (press h for help or q to quit)\u001b[27m\u001b[K"]
